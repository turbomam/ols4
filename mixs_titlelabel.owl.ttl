    skos:altLabel "MIxS-plant-associated" ;
    skos:definition "A collection of terms appropriate when collecting samples and sequencing samples  obtained from a plant to examine its plant-associated microbiome." ;
    skos:exactMatch MIXS:0016010 ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:use_cases "plant surface swabs, root soil or rhizosphere, cultivated plants, plant phenotyping" .

