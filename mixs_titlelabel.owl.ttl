    owl:unionOf ( <https://w3id.org/mixs/BuiltStrucSetEnum#rural> <https://w3id.org/mixs/BuiltStrucSetEnum#urban> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/BuiltStrucSetEnum#rural>,
        <https://w3id.org/mixs/BuiltStrucSetEnum#urban> .

MIXS:CeilStrucEnum a owl:Class ;
    rdfs:label "CeilStrucEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/CeilStrucEnum#concrete> <https://w3id.org/mixs/CeilStrucEnum#wood%20frame> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/CeilStrucEnum#concrete>,
        <https://w3id.org/mixs/CeilStrucEnum#wood%20frame> .

MIXS:FireplaceTypeEnum a owl:Class ;
    rdfs:label "FireplaceTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/FireplaceTypeEnum#gas%20burning> <https://w3id.org/mixs/FireplaceTypeEnum#wood%20burning> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/FireplaceTypeEnum#gas%20burning>,
        <https://w3id.org/mixs/FireplaceTypeEnum#wood%20burning> .

MIXS:HeatSysDelivMethEnum a owl:Class ;
    rdfs:label "HeatSysDelivMethEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/HeatSysDelivMethEnum#conductive> <https://w3id.org/mixs/HeatSysDelivMethEnum#radiant> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/HeatSysDelivMethEnum#conductive>,
        <https://w3id.org/mixs/HeatSysDelivMethEnum#radiant> .

MIXS:HostDependenceEnum a owl:Class ;
    rdfs:label "HostDependenceEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/HostDependenceEnum#facultative> <https://w3id.org/mixs/HostDependenceEnum#obligate> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/HostDependenceEnum#facultative>,
        <https://w3id.org/mixs/HostDependenceEnum#obligate> .

MIXS:ShadingDeviceLocEnum a owl:Class ;
    rdfs:label "ShadingDeviceLocEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/ShadingDeviceLocEnum#exterior> <https://w3id.org/mixs/ShadingDeviceLocEnum#interior> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/ShadingDeviceLocEnum#exterior>,
        <https://w3id.org/mixs/ShadingDeviceLocEnum#interior> .

MIXS:SpaceTypStateEnum a owl:Class ;
    rdfs:label "SpaceTypStateEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/SpaceTypStateEnum#typically%20occupied> <https://w3id.org/mixs/SpaceTypStateEnum#typically%20unoccupied> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/SpaceTypStateEnum#typically%20occupied>,
        <https://w3id.org/mixs/SpaceTypStateEnum#typically%20unoccupied> .

MIXS:SymLifeCycleTypeEnum a owl:Class ;
    rdfs:label "SymLifeCycleTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/SymLifeCycleTypeEnum#complex%20life%20cycle> <https://w3id.org/mixs/SymLifeCycleTypeEnum#simple%20life%20cycle> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/SymLifeCycleTypeEnum#complex%20life%20cycle>,
        <https://w3id.org/mixs/SymLifeCycleTypeEnum#simple%20life%20cycle> .

MIXS:UrineCollectMethEnum a owl:Class ;
    rdfs:label "UrineCollectMethEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/UrineCollectMethEnum#catheter> <https://w3id.org/mixs/UrineCollectMethEnum#clean%20catch> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/UrineCollectMethEnum#catheter>,
        <https://w3id.org/mixs/UrineCollectMethEnum#clean%20catch> .

MIXS:WindowStatusEnum a owl:Class ;
    rdfs:label "WindowStatusEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/WindowStatusEnum#closed> <https://w3id.org/mixs/WindowStatusEnum#open> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/WindowStatusEnum#closed>,
        <https://w3id.org/mixs/WindowStatusEnum#open> .

MIXS:adjacent_environment a owl:DatatypeProperty ;
    rdfs:label "environment adjacent to site" ;
    dcterms:title "environment adjacent to site" ;
    schema1:keywords "adjacent",
        "environment",
        "site" ;
    ns1:hasExactSynonym "adjacent_environment" ;
    skos:definition "Description of the environmental system or features that are adjacent to the sampling site. This field accepts terms under ecosystem (http://purl.obolibrary.org/obo/ENVO_01001110) and human construction (http://purl.obolibrary.org/obo/ENVO_00000070). Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "ENVO_01001110 or ENVO_00000070" .

MIXS:agrochem_addition a owl:DatatypeProperty ;
    rdfs:label "history/agrochemical additions" ;
    dcterms:title "history/agrochemical additions" ;
    schema1:keywords "history" ;
    ns1:hasExactSynonym "agrochem_addition" ;
    skos:definition "Addition of fertilizers, pesticides, etc. - amount and time of applications" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:air_PM_concen a owl:DatatypeProperty ;
    rdfs:label "air particulate matter concentration" ;
    dcterms:title "air particulate matter concentration" ;
    schema1:keywords "air",
        "concentration",
        "particle",
        "particulate" ;
    ns1:hasExactSynonym "air_PM_concen" ;
    skos:definition "Concentration of substances that remain suspended in the air, and comprise mixtures of organic and inorganic substances (PM10 and PM2.5); can report multiple PM's by entering numeric values preceded by name of PM" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:anim_water_method a owl:DatatypeProperty ;
    rdfs:label "animal water delivery method" ;
    dcterms:title "animal water delivery method" ;
    schema1:keywords "animal",
        "delivery",
        "method",
        "water" ;
    ns1:hasExactSynonym "anim_water_method" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the equipment or method used to distribute water to livestock. This field accepts termed listed under water delivery equipment (http://opendata.inra.fr/EOL/EOL_0001653). Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:animal_diet a owl:DatatypeProperty ;
    rdfs:label "food animal source diet" ;
    dcterms:title "food animal source diet" ;
    schema1:keywords "animal",
        "diet",
        "food",
        "source" ;
    ns1:hasExactSynonym "animal_diet" ;
    rdfs:range xsd:string ;
    skos:definition "If the isolate is from a food animal, the type of diet eaten by the food animal.  Please list the main food staple and the setting, if appropriate.  For a list of acceptable animal feed terms or categories, please see http://www.feedipedia.org.  Multiple terms may apply and can be separated by pipes |Food product for animal covers foods intended for consumption by domesticated animals. Consult http://purl.obolibrary.org/obo/FOODON_03309997. If the proper descriptor is not listed please use text to describe the food type. Multiple terms can be separated by one or more pipes. If the proper descriptor is not listed please use text to describe the food product type" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "text or FOODON_03309997" .

MIXS:animal_feed_equip a owl:DatatypeProperty ;
    rdfs:label "animal feeding equipment" ;
    dcterms:title "animal feeding equipment" ;
    schema1:keywords "animal",
        "equipment" ;
    ns1:hasExactSynonym "animal_feed_equip" ;
    skos:definition "Description of the feeding equipment used for livestock. This field accepts terms listed under feed delivery (http://opendata.inra.fr/EOL/EOL_0001757). Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "EOL:0001757" .

MIXS:animal_housing a owl:DatatypeProperty ;
    rdfs:label "animal housing system" ;
    dcterms:title "animal housing system" ;
    schema1:keywords "animal" ;
    ns1:hasExactSynonym "animal_housing" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the housing system of the livestock. This field accepts terms listed under terrestrial management housing system (http://opendata.inra.fr/EOL/EOL_0001605)" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:biotic_regm a owl:DatatypeProperty ;
    rdfs:label "biotic regimen" ;
    dcterms:title "biotic regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "biotic_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Information about treatment(s) involving use of biotic factors, such as bacteria, viruses or fungi" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:climate_environment a owl:DatatypeProperty ;
    rdfs:label "climate environment" ;
    dcterms:title "climate environment" ;
    schema1:keywords "environment" ;
    ns1:hasExactSynonym "climate_environment" ;
    rdfs:range xsd:string ;
    skos:definition "Treatment involving an exposure to a particular climate; treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple climates" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:dietary_claim_use a owl:DatatypeProperty ;
    rdfs:label "dietary claim or use" ;
    dcterms:title "dietary claim or use" ;
    schema1:keywords "diet",
        "use" ;
    ns1:hasExactSynonym "dietary_claim_use" ;
    skos:definition "These descriptors are used either for foods intended for special dietary use as defined in 21 CFR 105 or for foods that have special characteristics indicated in the name or labeling. This field accepts terms listed under dietary claim or use (http://purl.obolibrary.org/obo/FOODON_03510023). Multiple terms can be separated by one or more pipes, but please consider limiting this list to the most prominent dietary claim or use" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03510023" .

MIXS:farm_equip a owl:DatatypeProperty ;
    rdfs:label "farm equipment used" ;
    dcterms:title "farm equipment used" ;
    schema1:keywords "equipment",
        "farm",
        "use" ;
    ns1:hasExactSynonym "farm_equip" ;
    rdfs:range xsd:string ;
    skos:definition "List of equipment used for planting, fertilization, harvesting, irrigation, land levelling, residue management, weeding or transplanting during the growing season.  This field accepts terms listed under agricultural implement (http://purl.obolibrary.org/obo/AGRO_00000416). Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:farm_equip_san a owl:DatatypeProperty ;
    rdfs:label "farm equipment sanitization" ;
    dcterms:title "farm equipment sanitization" ;
    schema1:keywords "equipment",
        "farm" ;
    ns1:hasExactSynonym "farm_equip_san" ;
    skos:definition "Method used to sanitize growing and harvesting equipment. This can including type and concentration of sanitizing solution.  Multiple terms can be separated by one or more pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "text or commercial name of sanitizer or class of sanitizer or active ingredient in sanitizer" ;
    MIXS:Preferred_unit "parts per million" .

MIXS:farm_equip_shared a owl:DatatypeProperty ;
    rdfs:label "equipment shared with other farms" ;
    dcterms:title "equipment shared with other farms" ;
    schema1:keywords "equipment",
        "farm" ;
    ns1:hasExactSynonym "farm_equip_shared" ;
    rdfs:range xsd:string ;
    skos:definition "List of planting, growing or harvesting equipment shared with other farms. This field accepts terms listed under agricultural implement (http://purl.obolibrary.org/obo/AGRO_00000416). Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_allergen_label a owl:DatatypeProperty ;
    rdfs:label "food allergen labeling" ;
    dcterms:title "food allergen labeling" ;
    schema1:keywords "food" ;
    ns1:hasExactSynonym "food_allergen_label" ;
    skos:definition "A label indication that the product contains a recognized allergen. This field accepts terms listed under dietary claim or use (http://purl.obolibrary.org/obo/FOODON_03510213)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03510213" .

MIXS:food_dis_point_city a owl:DatatypeProperty ;
    rdfs:label "food distribution point geographic location (city)" ;
    dcterms:title "food distribution point geographic location (city)" ;
    schema1:keywords "food",
        "geographic",
        "location" ;
    ns1:hasExactSynonym "food_dis_point_city" ;
    skos:definition "A reference to a place on the Earth, by its name or by its geographical location that refers to a distribution point along the food chain. This field accepts terms listed under geographic location (http://purl.obolibrary.org/obo/GAZ_00000448). Reference: Adam Diamond, James Barham. Moving Food Along the Value Chain: Innovations in Regional Food Distribution. U.S. Dept. of Agriculture, Agricultural Marketing Service. Washington, DC. March 2012. http://dx.doi.org/10.9752/MS045.03-2012" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "GAZ:00000448" .

MIXS:food_harvest_proc a owl:DatatypeProperty ;
    rdfs:label "Food harvesting process" ;
    dcterms:title "Food harvesting process" ;
    schema1:keywords "food",
        "process" ;
    ns1:hasExactSynonym "food_harvest_proc" ;
    rdfs:range xsd:string ;
    skos:definition "A harvesting process is a process which takes in some food material from an individual or community of plant or animal organisms in a given context and time, and outputs a precursor or consumable food product. This may include a part of an organism or the whole, and may involve killing the organism" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_prod_char a owl:DatatypeProperty ;
    rdfs:label "food production characteristics" ;
    dcterms:title "food production characteristics" ;
    schema1:keywords "food",
        "production" ;
    ns1:hasExactSynonym "food_prod_char" ;
    rdfs:range xsd:string ;
    skos:definition "Descriptors of the food production system such as wild caught, free-range, organic, free-range, industrial, dairy, beef" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:fungicide_regm a owl:DatatypeProperty ;
    rdfs:label "fungicide regimen" ;
    dcterms:title "fungicide regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "fungicide_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Information about treatment involving use of fungicides; should include the name of fungicide, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple fungicide regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:gaseous_environment a owl:DatatypeProperty ;
    rdfs:label "gaseous environment" ;
    dcterms:title "gaseous environment" ;
    schema1:keywords "environment" ;
    ns1:hasExactSynonym "gaseous_environment" ;
    rdfs:range xsd:string ;
    skos:definition "Use of conditions with differing gaseous environments; should include the name of gaseous compound, amount administered, treatment duration, interval and total experimental duration; can include multiple gaseous environment regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter" .

MIXS:herbicide_regm a owl:DatatypeProperty ;
    rdfs:label "herbicide regimen" ;
    dcterms:title "herbicide regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "herbicide_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Information about treatment involving use of herbicides; information about treatment involving use of growth hormones; should include the name of herbicide, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:isotope a owl:ObjectProperty ;
    rdfs:label "isotope" ;
    dcterms:title "isotope" ;
    rdfs:range MIXS:IsotopeEnum ;
    skos:definition "The element and mass number of the stable isotope used in isotopologue labeling." ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:isotopolog a owl:DatatypeProperty ;
    rdfs:label "isotopolog" ;
    dcterms:title "isotopolog" ;
    rdfs:range xsd:string ;
    skos:definition "Isotopologue (isotope source/substrate/molecule) added to the biological sample." ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "List the PubChem Compound Identification (CID) number. If it's an undefined mixture, enter 0." .

MIXS:mechanical_damage a owl:DatatypeProperty ;
    rdfs:label "mechanical damage" ;
    dcterms:title "mechanical damage" ;
    ns1:hasExactSynonym "mechanical_damage" ;
    skos:definition "Information about any mechanical damage exerted on the plant; can include multiple damages and sites" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "damage type;body site" .

MIXS:non_min_nutr_regm a owl:DatatypeProperty ;
    rdfs:label "non-mineral nutrient regimen" ;
    dcterms:title "non-mineral nutrient regimen" ;
    schema1:keywords "non-mineral",
        "nutrient",
        "regimen" ;
    ns1:hasExactSynonym "non_min_nutr_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Information about treatment involving the exposure of plant to non-mineral nutrient such as oxygen, hydrogen or carbon; should include the name of non-mineral nutrient, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple non-mineral nutrient regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:nucl_acid_ext_kit a owl:DatatypeProperty ;
    rdfs:label "nucleic acid extraction kit" ;
    dcterms:title "nucleic acid extraction kit" ;
    schema1:keywords "kit" ;
    ns1:hasExactSynonym "nucl_acid_ext_kit" ;
    rdfs:range xsd:string ;
    skos:definition "The name of the extraction kit used to recover the nucleic acid fraction of an input material is performed" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "The name of an extraction kit" .

MIXS:pesticide_regm a owl:DatatypeProperty ;
    rdfs:label "pesticide regimen" ;
    dcterms:title "pesticide regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "pesticide_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Information about treatment involving use of insecticides; should include the name of pesticide, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple pesticide regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:ph_regm a owl:DatatypeProperty ;
    rdfs:label "pH regimen" ;
    dcterms:title "pH regimen" ;
    schema1:keywords "ph",
        "regimen" ;
    ns1:hasExactSynonym "ph_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Information about treatment involving exposure of plants to varying levels of ph of the growth media, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple regimen" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:prod_label_claims a owl:DatatypeProperty ;
    rdfs:label "production labeling claims" ;
    dcterms:title "production labeling claims" ;
    schema1:keywords "production" ;
    ns1:hasExactSynonym "prod_label_claims" ;
    rdfs:range xsd:string ;
    skos:definition "Labeling claims containing descriptors such as wild caught, free-range, organic, free-range, industrial, hormone-free, antibiotic free, cage free. Can include more than one term, separated by \";\"" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:salt_regm a owl:DatatypeProperty ;
    rdfs:label "salt regimen" ;
    dcterms:title "salt regimen" ;
    schema1:keywords "regimen",
        "salt" ;
    ns1:hasExactSynonym "salt_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Information about treatment involving use of salts as supplement to liquid and soil growth media; should include the name of salt, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple salt regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, microgram, mole per liter, gram per liter" .

MIXS:season_environment a owl:DatatypeProperty ;
    rdfs:label "seasonal environment" ;
    dcterms:title "seasonal environment" ;
    schema1:keywords "environment",
        "season" ;
    ns1:hasExactSynonym "season_environment" ;
    rdfs:range xsd:string ;
    skos:definition "Treatment involving an exposure to a particular season (e.g. Winter, summer, rabi, rainy etc.), treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:spikein_AMR a owl:DatatypeProperty ;
    rdfs:label "antimicrobial phenotype of spike-in bacteria" ;
    dcterms:title "antimicrobial phenotype of spike-in bacteria" ;
    schema1:keywords "antimicrobial",
        "spike" ;
    ns1:hasExactSynonym "spikein_AMR" ;
    skos:definition "Qualitative description of a microbial response to antimicrobial agents. Bacteria may be susceptible or resistant to a broad range of antibiotic drugs or drug classes, with several intermediate states or phases. This field accepts terms under antimicrobial phenotype (http://purl.obolibrary.org/obo/ARO_3004299)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value ARO:3004299" .

MIXS:standing_water_regm a owl:DatatypeProperty ;
    rdfs:label "standing water regimen" ;
    dcterms:title "standing water regimen" ;
    schema1:keywords "regimen",
        "water" ;
    ns1:hasExactSynonym "standing_water_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Treatment involving an exposure to standing water during a plant's life span, types can be flood water or standing water, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple regimens" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:water_source_shared a owl:DatatypeProperty ;
    rdfs:label "water source shared" ;
    dcterms:title "water source shared" ;
    schema1:keywords "source",
        "water" ;
    ns1:hasExactSynonym "water_source_shared" ;
    skos:definition "Other users sharing access to the same water source. Multiple terms can be separated by one or more pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration" .

MIXS:water_temp_regm a owl:DatatypeProperty ;
    rdfs:label "water temperature regimen" ;
    dcterms:title "water temperature regimen" ;
    schema1:keywords "regimen",
        "temperature",
        "water" ;
    ns1:hasExactSynonym "water_temp_regm" ;
    rdfs:range xsd:string ;
    skos:definition "Information about treatment involving an exposure to water with varying degree of temperature, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:watering_regm a owl:DatatypeProperty ;
    rdfs:label "watering regimen" ;
    dcterms:title "watering regimen" ;
    schema1:keywords "regimen",
        "water" ;
    ns1:hasExactSynonym "watering_regm" ;
    rdfs:range xsd:string ;
