        "type" ;
    ns1:hasExactSynonym "samp_type" ;
    rdfs:comment "The type of material from which the sample was obtained. For the Hydrocarbon package, samples include types like core, rock trimmings, drill cuttings, piping section, coupon, pigging debris, solid deposit, produced fluid, produced water, injected water, swabs, etc. For the Food Package, samples are usually categorized as food, body products or tissues, or environmental material. This field accepts terms listed under environmental specimen (http://purl.obolibrary.org/obo/GENEPIO_0001246)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:seq_quality_check a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sequence quality check" ;
    dcterms:title "sequence quality check" ;
    schema1:keywords "quality" ;
    ns1:hasExactSynonym "seq_quality_check" ;
    rdfs:comment "Indicate if the sequence has been called by automatic systems (none) or undergone a manual editing procedure (e.g. by inspecting the raw data or chromatograms). Applied only for sequences that are not submitted to SRA,ENA or DRA" ;
    rdfs:range MIXS:SeqQualityCheckEnum ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "none or manually edited" .

MIXS:sequencing_kit a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sequencing kit" ;
    dcterms:title "sequencing kit" ;
    schema1:keywords "kit" ;
    ns1:hasExactSynonym "sequencing_kit" ;
    rdfs:comment "Pre-filled, ready-to-use reagent cartridges. Used to produce improved chemistry, cluster density and read length as well as improve quality (Q) scores. Reagent components are encoded to interact with the sequencing system to validate compatibility with user-defined applications. Indicate name of the sequencing kit" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "name of sequencing kit used" .

MIXS:silicate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "silicate" ;
    dcterms:title "silicate" ;
    rdfs:comment "Concentration of silicate" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter" .

MIXS:target_gene a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "target gene" ;
    dcterms:title "target gene" ;
    schema1:keywords "target" ;
    ns1:hasExactSynonym "target_gene" ;
    rdfs:comment "Targeted gene or locus name for marker gene studies" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:target_subfragment a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "target subfragment" ;
    dcterms:title "target subfragment" ;
    schema1:keywords "target" ;
    ns1:hasExactSynonym "target_subfragment" ;
    rdfs:comment "Name of subfragment of a gene or locus. Important to e.g. identify special regions on marker genes like V6 on 16S rRNA" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:timepoint a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "timepoint" ;
    dcterms:title "timepoint" ;
    schema1:keywords "time" ;
    rdfs:comment "Time point at which a sample or observation is made or taken from a biomaterial as measured from some reference point. Indicate the timepoint written in ISO 8601 format" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "hours or days" .

MIXS:tot_nitro a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "total nitrogen concentration" ;
    dcterms:title "total nitrogen concentration" ;
    schema1:keywords "concentration",
        "nitrogen",
        "total" ;
    ns1:hasExactSynonym "tot_nitro" ;
    rdfs:comment "Total nitrogen concentration of water samples, calculated by: total nitrogen = total dissolved nitrogen + particulate nitrogen. Can also be measured without filtering, reported as nitrogen" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "microgram per liter, micromole per liter, milligram per liter" .

MIXS:turbidity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "turbidity" ;
    dcterms:title "turbidity" ;
    rdfs:comment "Measure of the amount of cloudiness or haziness in water caused by individual particles" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:BinParamEnum a owl:Class,
