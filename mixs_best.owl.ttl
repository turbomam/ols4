    dcterms:title "seasonal use" ;
    schema1:keywords "season",
        "use" ;
    ns1:hasExactSynonym "season_use" ;
    rdfs:comment "The seasons the space is occupied" ;
    rdfs:range MIXS:SeasonUseEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:secondary_treatment a owl:ObjectProperty,
