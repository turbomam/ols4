    dcterms:title "dose of isotopolog" ;
    ns1:hasExactSynonym "isotopolog_dose" ;
    rdfs:comment "The concentration (in ppm) of isotopolog added to environmental matrix as a total mass per volume." ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "isotopolog mass / total volume soil; ppm of isotopologue in total container volume" ;
    MIXS:Preferred_unit "ppm" .

MIXS:isotopolog_incu_time a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isotopolog incubation time" ;
    dcterms:title "isotopolog incubation time" ;
    ns1:hasExactSynonym "isotopolog_incu_time" ;
    rdfs:comment "Total time of incubation after isotopologue addition in hours" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "hours" .

MIXS:isotopolog_label a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isotopolog label status" ;
    dcterms:title "isotopolog label status" ;
    ns1:hasExactSynonym "isotopolog_label" ;
    rdfs:comment "List whether the isotopologue added to this biological sample was heavy-labelled or natural abundance" ;
    rdfs:range MIXS:IsotopologLabelEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:link_class_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "link to classification information" ;
    dcterms:title "link to classification information" ;
    schema1:keywords "classification",
        "information",
        "link" ;
    ns1:hasExactSynonym "link_class_info" ;
    rdfs:comment "Link to digitized soil maps or other soil classification information" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "PMID,DOI or url" .

MIXS:link_climate_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "link to climate information" ;
    dcterms:title "link to climate information" ;
    schema1:keywords "information",
        "link" ;
    ns1:hasExactSynonym "link_climate_info" ;
    rdfs:comment "Link to climate resource" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:lithology a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lithology" ;
    dcterms:title "lithology" ;
    schema1:keywords "lithology" ;
    rdfs:comment "Hydrocarbon resource main lithology (Additional information: http://petrowiki.org/Lithology_and_rock_type_determination). If \"other\" is specified, please propose entry in \"additional info\" field" ;
    rdfs:range MIXS:LithologyEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:local_class a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil_taxonomic/local classification" ;
    dcterms:title "soil_taxonomic/local classification" ;
    schema1:keywords "classification" ;
    ns1:hasExactSynonym "local_class" ;
    rdfs:comment "Soil classification based on local soil classification system" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "local classification name" .

MIXS:local_class_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil_taxonomic/local classification method" ;
    dcterms:title "soil_taxonomic/local classification method" ;
    schema1:keywords "classification",
        "method" ;
    ns1:hasExactSynonym "local_class_meth" ;
    rdfs:comment "Reference or method used in determining the local soil classification" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:mag_cov_software a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "MAG coverage software" ;
    dcterms:title "MAG coverage software" ;
    schema1:keywords "software" ;
    ns1:hasExactSynonym "mag_cov_software" ;
    rdfs:comment "Tool(s) used to determine the genome coverage if coverage is used as a binning parameter in the extraction of genomes from metagenomic datasets" ;
    rdfs:range MIXS:MagCovSoftwareEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:marker_gene_recov a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxonomic marker gene recovered" ;
    dcterms:title "taxonomic marker gene recovered" ;
    schema1:keywords "marker gene",
        "recover",
        "taxonomy" ;
    ns1:hasExactSynonym "marker_gene_recov" ;
    rdfs:comment "Recovery status of taxonomic marker genes from the assembled genome" ;
    rdfs:range linkml:Boolean ;
    rdfs:seeAlso MIXS:0000065 ;
    skos:altLabel "x16s_recover" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:marker_gene_recov_sw a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxonomic marker gene recovery software" ;
    dcterms:title "taxonomic marker gene recovery software" ;
    schema1:keywords "marker gene",
        "recover",
        "software",
        "taxonomy" ;
    ns1:hasExactSynonym "marker_gene_recov_sw" ;
    rdfs:comment "Tools used for taxonomic marker gene extraction from assembled genomes" ;
    rdfs:range linkml:String ;
    rdfs:seeAlso MIXS:0000066 ;
    skos:altLabel "x16s_recover_software" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:micro_biomass_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "microbial biomass method" ;
    dcterms:title "microbial biomass method" ;
    schema1:keywords "biomass",
        "method",
        "microbial" ;
    ns1:hasExactSynonym "micro_biomass_meth" ;
    rdfs:comment "Reference or method used in determining microbial biomass" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "slot name/scn was microbial_biomass_meth" .

MIXS:microbial_biomass a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "microbial biomass" ;
    dcterms:title "microbial biomass" ;
    schema1:keywords "biomass",
        "microbial" ;
    ns1:hasExactSynonym "microbial_biomass" ;
    rdfs:comment "The part of the organic matter in the soil that constitutes living microorganisms smaller than 5-10 micrometer. If you keep this, you would need to have correction factors used for conversion to the final units" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "ton, kilogram, gram per kilogram soil" .

MIXS:n_alkanes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "n-alkanes" ;
    dcterms:title "n-alkanes" ;
    ns1:hasExactSynonym "n_alkanes" ;
    rdfs:comment "Concentration of n-alkanes; can include multiple n-alkanes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "n-alkane name;measurement value" .

MIXS:nucleic_acid_elution_vol a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nucleic acid elution volume" ;
    dcterms:title "nucleic acid elution volume" ;
    ns1:hasExactSynonym "nucleic_acid_elution_vol" ;
    rdfs:comment "Volume the nucleic acid (DNA or RNA) sample is eluted in" ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "Unit is microliter" ;
    MIXS:Preferred_unit "uL" .

MIXS:nucleobase_atom_frac a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nucleobase excess atom fraction" ;
    dcterms:title "nucleobase excess atom fraction" ;
    ns1:hasExactSynonym "nucleobase_atom_frac" ;
    rdfs:comment "Excess atom fraction of the nucleobases in this fraction." ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( linkml:Float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:num_samp_collect a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "number of samples collected" ;
    dcterms:title "number of samples collected" ;
    schema1:keywords "number",
        "sample" ;
    ns1:hasExactSynonym "num_samp_collect" ;
    rdfs:comment "The number of samples collected during the current sampling event" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:org_count_qpcr_info a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "organism count qPCR information" ;
    dcterms:title "organism count qPCR information" ;
    schema1:keywords "count",
        "information",
        "organism" ;
    ns1:hasExactSynonym "org_count_qpcr_info" ;
    rdfs:comment "If qpcr was used for the cell count, the target gene name, the primer sequence and the cycling conditions should also be provided. (Example: 16S rrna; FWD:ACGTAGCTATGACGT REV:GTGCTAGTCGAGTAC; initial denaturation:90C_5min; denaturation:90C_2min; annealing:52C_30 sec; elongation:72C_30 sec; 90 C for 1 min; final elongation:72C_5min; 30 cycles)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "gene name;FWD:forward primer sequence;REV:reverse primer sequence;initial denaturation:degrees_minutes;denaturation:degrees_minutes;annealing:degrees_minutes;elongation:degrees_minutes;final elongation:degrees_minutes; total cycles" ;
    MIXS:Preferred_unit "number of cells per gram (or ml or cm^2)" .

MIXS:phaeopigments a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "phaeopigments" ;
    dcterms:title "phaeopigments" ;
    rdfs:comment "Concentration of phaeopigments; can include multiple phaeopigments" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "phaeopigment name;measurement value" ;
    MIXS:Preferred_unit "milligram per cubic meter" .

MIXS:plant_product a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "plant product" ;
    dcterms:title "plant product" ;
    schema1:keywords "plant",
        "product" ;
    ns1:hasExactSynonym "plant_product" ;
    rdfs:comment "Substance produced by the plant, where the sample was obtained from" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "product name" .

MIXS:plant_struc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "plant structure" ;
    dcterms:title "plant structure" ;
    schema1:keywords "plant" ;
    ns1:hasExactSynonym "plant_struc" ;
    rdfs:comment "Name of plant structure the sample was obtained from; for Plant Ontology (PO) (v releases/2017-12-14) terms, see http://purl.bioontology.org/ontology/PO, e.g. petiole epidermis (PO_0000051). If an individual flower is sampled, the sex of it can be recorded here" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:plant_water_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "plant water delivery method" ;
    dcterms:title "plant water delivery method" ;
    schema1:keywords "delivery",
        "method",
        "plant",
        "water" ;
    ns1:hasExactSynonym "plant_water_method" ;
    rdfs:comment "Description of the equipment or method used to distribute water to crops. This field accepts termed listed under irrigation process (http://purl.obolibrary.org/obo/AGRO_00000006). Multiple terms can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:pour_point a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pour point" ;
    dcterms:title "pour point" ;
    ns1:hasExactSynonym "pour_point" ;
    rdfs:comment "Temperature at which a liquid becomes semi solid and loses its flow characteristics. In crude oil a high pour point is generally associated with a high paraffin content, typically found in crude deriving from a larger proportion of plant material. (source: https://en.wikipedia.org/wiki/pour_point)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:pres_animal_insect a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "presence of pets, animals, or insects" ;
    dcterms:title "presence of pets, animals, or insects" ;
    schema1:keywords "animal",
        "presence" ;
    ns1:hasExactSynonym "pres_animal_insect" ;
    rdfs:comment "The type and number of animals or insects present in the sampling space" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration;count" .

MIXS:prev_land_use_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "history/previous land use method" ;
    dcterms:title "history/previous land use method" ;
    schema1:keywords "history",
        "land",
        "method",
        "use" ;
    ns1:hasExactSynonym "prev_land_use_meth" ;
    rdfs:comment "Reference or method used in determining previous land use and dates" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:profile_position a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "profile position" ;
    dcterms:title "profile position" ;
    ns1:hasExactSynonym "profile_position" ;
    rdfs:comment "Cross-sectional position in the hillslope where sample was collected.sample area position in relation to surrounding areas" ;
    rdfs:range MIXS:ProfilePositionEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:reassembly_bin a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reassembly post binning" ;
    dcterms:title "reassembly post binning" ;
    schema1:keywords "post" ;
    ns1:hasExactSynonym "reassembly_bin" ;
    rdfs:comment "Has an assembly been performed on a genome bin extracted from a metagenomic assembly?" ;
    rdfs:range linkml:Boolean ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:rel_location a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "relative location of sample" ;
    dcterms:title "relative location of sample" ;
    schema1:keywords "location",
        "relative",
        "sample" ;
    ns1:hasExactSynonym "rel_location" ;
    rdfs:comment "Location of sampled soil to other parts of the farm e.g. under crop plant, near irrigation ditch, from the dirt road" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:reservoir a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reservoir name" ;
    dcterms:title "reservoir name" ;
    ns1:hasExactSynonym "reservoir" ;
    rdfs:comment "Name of the reservoir (e.g. Carapebus)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:resins_pc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "resins wt%" ;
    dcterms:title "resins wt%" ;
    ns1:hasExactSynonym "resins_pc" ;
    rdfs:comment "Saturate, Aromatic, Resin and Asphaltene (SARA) is an analysis method that divides crude oil components according to their polarizability and polarity. There are three main methods to obtain SARA results. The most popular one is known as the Iatroscan TLC-FID and is referred to as IP-143 (source: https://en.wikipedia.org/wiki/Saturate,_aromatic,_resin_and_asphaltene)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "percent" .

MIXS:room_dim a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "room dimensions" ;
    dcterms:title "room dimensions" ;
    schema1:keywords "dimensions",
        "room" ;
    ns1:hasExactSynonym "room_dim" ;
    rdfs:comment "The length, width and height of sampling room" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value" ;
    MIXS:Preferred_unit "meter" .

MIXS:root_cond a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rooting conditions" ;
    dcterms:title "rooting conditions" ;
    schema1:keywords "condition" ;
    ns1:hasExactSynonym "root_cond" ;
    rdfs:comment "Relevant rooting conditions such as field plot size, sowing density, container dimensions, number of plants per container" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:root_med_micronutr a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rooting medium micronutrients" ;
    dcterms:title "rooting medium micronutrients" ;
    schema1:keywords "micronutrients" ;
    ns1:hasExactSynonym "root_med_micronutr" ;
    rdfs:comment "Measurement of the culture rooting medium micronutrients (Fe, Mn, Zn, B, Cu, Mo); e.g. H3BO3 (6.2 mg/L)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "micronutrient name;measurement value" ;
    MIXS:Preferred_unit "milligram per liter" .

MIXS:samp_capt_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample capture status" ;
    dcterms:title "sample capture status" ;
    schema1:keywords "sample",
        "status" ;
    ns1:hasExactSynonym "samp_capt_status" ;
    rdfs:comment "Reason for the sample" ;
    rdfs:range MIXS:SampCaptStatusEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_dis_stage a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample disease stage" ;
    dcterms:title "sample disease stage" ;
    schema1:keywords "disease",
        "sample" ;
    ns1:hasExactSynonym "samp_dis_stage" ;
    rdfs:comment "Stage of the disease at the time of sample collection, e.g. inoculation, penetration, infection, growth and reproduction, dissemination of pathogen" ;
    rdfs:range MIXS:SampDisStageEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_dna_conc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample dna concentration" ;
    dcterms:title "sample dna concentration" ;
    ns1:hasExactSynonym "samp_dna_conc" ;
    rdfs:comment "DNA concentration of sample after dna extraction prior to pooling. Typically measured spectrophotometrically or with a fluorophore." ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "Unit is nanograms per microliter" ;
    MIXS:Preferred_unit "ng/uL" .

MIXS:samp_floor a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sampling floor" ;
    dcterms:title "sampling floor" ;
    schema1:keywords "floor" ;
    ns1:hasExactSynonym "samp_floor" ;
    rdfs:comment "The floor of the building, where the sampling room is located" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(?:(?:\\d*1[1-3]th|\\d*1st|\\d*2nd|\\d*3rd|\\d*[04-9]th) floor|basement|lobby)$" ] ) ] ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration" .

MIXS:samp_room_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sampling room ID or name" ;
    dcterms:title "sampling room ID or name" ;
    schema1:keywords "identifier",
        "room" ;
    ns1:hasExactSynonym "samp_room_id" ;
    rdfs:comment "Sampling room number. This ID should be consistent with the designations on the building floor plans" ;
    rdfs:range linkml:Integer ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_subtype a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample subtype" ;
    dcterms:title "sample subtype" ;
    schema1:keywords "sample" ;
    ns1:hasExactSynonym "samp_subtype" ;
    rdfs:comment "Name of sample sub-type. For example if \"sample type\" is \"Produced Water\" then subtype could be \"Oil Phase\" or \"Water Phase\". If \"other\" is specified, please propose entry in \"additional info\" field" ;
    rdfs:range MIXS:SampSubtypeEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_transport_cond a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample transport conditions" ;
    dcterms:title "sample transport conditions" ;
    schema1:keywords "condition",
        "sample",
        "transport" ;
    ns1:hasExactSynonym "samp_transport_cond" ;
    rdfs:comment "Sample transport duration (in days or hrs) and temperature the sample was exposed to (e.g. 5.5 days; 20   C)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value;measurement value" ;
    MIXS:Preferred_unit "days;degree Celsius" .

MIXS:samp_well_name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample well name" ;
    dcterms:title "sample well name" ;
    schema1:keywords "sample" ;
    ns1:hasExactSynonym "samp_well_name" ;
    rdfs:comment "Name of the well (e.g. BXA1123) where sample was taken" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:saturates_pc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "saturates wt%" ;
    dcterms:title "saturates wt%" ;
    ns1:hasExactSynonym "saturates_pc" ;
    rdfs:comment "Saturate, Aromatic, Resin and Asphaltene (SARA) is an analysis method that divides crude oil components according to their polarizability and polarity. There are three main methods to obtain SARA results. The most popular one is known as the Iatroscan TLC-FID and is referred to as IP-143 (source: https://en.wikipedia.org/wiki/Saturate,_aromatic,_resin_and_asphaltene)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "percent" .

MIXS:sc_lysis_approach a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "single cell or viral particle lysis approach" ;
    dcterms:title "single cell or viral particle lysis approach" ;
    schema1:keywords "particle",
        "single" ;
    ns1:hasExactSynonym "sc_lysis_approach" ;
    rdfs:comment "Method used to free DNA from interior of the cell(s) or particle(s)" ;
    rdfs:range MIXS:ScLysisApproachEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:sc_lysis_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "single cell or viral particle lysis kit protocol" ;
    dcterms:title "single cell or viral particle lysis kit protocol" ;
    schema1:keywords "kit",
        "particle",
        "protocol",
        "single" ;
    ns1:hasExactSynonym "sc_lysis_method" ;
    rdfs:comment "Name of the kit or standard protocol used for cell(s) or particle(s) lysis" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "kit, protocol name" .

MIXS:season_humidity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mean seasonal humidity" ;
    dcterms:title "mean seasonal humidity" ;
    schema1:keywords "humidity",
        "mean",
        "season" ;
    ns1:hasExactSynonym "season_humidity" ;
    rdfs:comment "Average humidity of the region throughout the growing season" ;
    rdfs:range linkml:Float ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "percent or float?" .

MIXS:serovar_or_serotype a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "serovar or serotype" ;
    dcterms:title "serovar or serotype" ;
    ns1:hasExactSynonym "serovar_or_serotype" ;
    rdfs:comment "A characterization of a cell or microorganism based on the antigenic properties of the molecules on its surface. Indicate the name of a serovar or serotype of interest. This field accepts terms under organism (http://purl.obolibrary.org/obo/NCIT_C14250). This field also accepts identification numbers from NCBI under https://www.ncbi.nlm.nih.gov/taxonomy" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:sieving a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sieving" ;
    dcterms:title "sieving" ;
    rdfs:comment "Collection design of pooled samples and/or sieve size and amount of sample sieved" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "design name and/or size;amount" .

MIXS:sip_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "method for SIP fractionating" ;
    dcterms:title "method for SIP fractionating" ;
    ns1:hasExactSynonym "sip_method" ;
    rdfs:comment "Method used to fractionate nucleic acids." ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:slope_aspect a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "slope aspect" ;
    dcterms:title "slope aspect" ;
    schema1:keywords "slope" ;
    ns1:hasExactSynonym "slope_aspect" ;
    rdfs:comment "The direction a slope faces. While looking down a slope use a compass to record the direction you are facing (direction or degrees); e.g., nw or 315 degrees. This measure provides an indication of sun and wind exposure that will influence soil temperature and evapotranspiration" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree" .

MIXS:slope_gradient a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "slope gradient" ;
    dcterms:title "slope gradient" ;
    schema1:keywords "slope" ;
    ns1:hasExactSynonym "slope_gradient" ;
    rdfs:comment "Commonly called 'slope'. The angle between ground surface and a horizontal line (in percent). This is the direction that overland water would flow. This measure is usually taken with a hand level meter or clinometer" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "percentage" .

MIXS:soil_conductivity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil conductivity" ;
    dcterms:title "soil conductivity" ;
    schema1:keywords "soil" ;
    ns1:hasExactSynonym "soil_conductivity" ;
    rdfs:comment "Conductivity of some soil." ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "Soil electrical conductivity (EC) is a measure of how well soil water can carry an electrical current. Electrical conductivity of soil solution is a reliable indicator of its solute (cation or anion) concentration with 1 dS/m approximately equivalent to 10 meq/L (U.S. Salinity Laboratory Staff, 1954)." ;
    MIXS:Preferred_unit "milliSiemens per centimeter" .

MIXS:soil_cover a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil cover" ;
    dcterms:title "soil cover" ;
    schema1:keywords "soil" ;
    ns1:hasExactSynonym "soil_cover" ;
    rdfs:comment "Material covering the sampled soil. This field accepts terms under ENVO:00010483, environmental material" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "subclass of 'environmental material', http://purl.obolibrary.org/obo/ENVO_00010483" .

MIXS:soil_horizon a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil horizon" ;
    dcterms:title "soil horizon" ;
    schema1:keywords "horizon",
        "soil" ;
    ns1:hasExactSynonym "soil_horizon" ;
    rdfs:comment "Specific layer in the land area which measures parallel to the soil surface and possesses physical characteristics which differ from the layers above and beneath" ;
    rdfs:range MIXS:SoilHorizonEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:soil_pH a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil pH" ;
    dcterms:title "soil pH" ;
    schema1:keywords "ph",
        "soil" ;
    ns1:hasExactSynonym "soil_pH" ;
    rdfs:comment "pH measurement of some soil at the time of sampling" ;
    rdfs:range linkml:Float ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:soil_temp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil temperature" ;
    dcterms:title "soil temperature" ;
    schema1:keywords "soil",
        "temperature" ;
    ns1:hasExactSynonym "soil_temp" ;
    rdfs:comment "Temperature of soil at the time of sampling" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:soil_texture a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil texture" ;
    dcterms:title "soil texture" ;
    schema1:keywords "soil",
        "texture" ;
    ns1:hasExactSynonym "soil_texture" ;
    rdfs:comment "The relative proportion of different grain sizes of mineral particles in a soil, as described using a standard system; express as % sand (50 um to 2 mm), silt (2 um to 50 um), and clay (<2 um) with textural name (e.g., silty clay loam) optional" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:solar_irradiance a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "solar irradiance" ;
    dcterms:title "solar irradiance" ;
    ns1:hasExactSynonym "solar_irradiance" ;
    rdfs:comment "The amount of solar energy that arrives at a specific area of a surface during a specific time interval" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "kilowatts per square meter per day, ergs per square centimeter per second" .

MIXS:sort_tech a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sorting technology" ;
    dcterms:title "sorting technology" ;
    ns1:hasExactSynonym "sort_tech" ;
    rdfs:comment "Method used to sort/isolate cells or particles of interest" ;
    rdfs:range MIXS:SortTechEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:spikein_antibiotic a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spike-in with antibiotics" ;
    dcterms:title "spike-in with antibiotics" ;
    schema1:keywords "spike" ;
    ns1:hasExactSynonym "spikein_antibiotic" ;
    rdfs:comment "Antimicrobials used in research study to assess effects of exposure on microbiome of a specific site.  Please list antimicrobial, common name and/or class and concentration used for spike-in" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "drug name; concentration" .

MIXS:spikein_growth_med a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spike-in growth medium" ;
    dcterms:title "spike-in growth medium" ;
    schema1:keywords "growth",
        "spike" ;
    ns1:hasExactSynonym "spikein_growth_med" ;
    rdfs:comment "A liquid or gel containing nutrients, salts, and other factors formulated to support the growth of microorganisms, cells, or plants (National Cancer Institute Thesaurus).  A growth medium is a culture medium which has the disposition to encourage growth of particular bacteria to the exclusion of others in the same growth environment.  In this case, list the culture medium used to propagate the spike-in bacteria during preparation of spike-in inoculum. This field accepts terms listed under microbiological culture medium (http://purl.obolibrary.org/obo/MICRO_0000067). If the proper descriptor is not listed please use text to describe the spike in growth media" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:spikein_metal a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spike-in with heavy metals" ;
    dcterms:title "spike-in with heavy metals" ;
    schema1:keywords "heavy",
        "spike" ;
    ns1:hasExactSynonym "spikein_metal" ;
    rdfs:comment "Heavy metals used in research study to assess effects of exposure on microbiome of a specific site.  Please list heavy metals and concentration used for spike-in" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "heavy metal name or chemical symbol; concentration" .

MIXS:spikein_org a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spike in organism" ;
    dcterms:title "spike in organism" ;
    schema1:keywords "organism",
        "spike" ;
    ns1:hasExactSynonym "spikein_org" ;
    rdfs:comment "Taxonomic information about the spike-in organism(s). This field accepts terms under organism (http://purl.obolibrary.org/obo/NCIT_C14250). This field also accepts identification numbers from NCBI under https://www.ncbi.nlm.nih.gov/taxonomy. Multiple terms can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:spikein_serovar a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spike-in bacterial serovar or serotype" ;
    dcterms:title "spike-in bacterial serovar or serotype" ;
    schema1:keywords "spike" ;
    ns1:hasExactSynonym "spikein_serovar" ;
    rdfs:comment "Taxonomic information about the spike-in organism(s) at the serovar or serotype level. This field accepts terms under organism (http://purl.obolibrary.org/obo/NCIT_C14250). This field also accepts identification numbers from NCBI under https://www.ncbi.nlm.nih.gov/taxonomy. Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "NCIT:C14250 or antigenic formula or serovar name" .

MIXS:store_cond a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "storage conditions" ;
    dcterms:title "storage conditions" ;
    schema1:keywords "condition",
        "storage" ;
    ns1:hasExactSynonym "store_cond" ;
    rdfs:comment "Explain how and for how long the soil sample was stored before DNA extraction (fresh/frozen/other)" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:study_design a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "study design" ;
    dcterms:title "study design" ;
    ns1:hasExactSynonym "study_design" ;
    rdfs:comment "A plan specification comprised of protocols (which may specify how and what kinds of data will be gathered) that are executed as part of an investigation and is realized during a study design execution. This field accepts terms under study design (http://purl.obolibrary.org/obo/OBI_0500000). If the proper descriptor is not listed please use text to describe the study design. Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "OBI:0500000" .

MIXS:study_tmnt a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "study treatment" ;
    dcterms:title "study treatment" ;
    schema1:keywords "treatment" ;
    ns1:hasExactSynonym "study_tmnt" ;
    rdfs:comment "A process in which the act is intended to modify or alter some other material entity.  From the study design, each treatment is comprised of one level of one or multiple factors. This field accepts terms listed under treatment (http://purl.obolibrary.org/obo/MCO_0000866). If the proper descriptor is not listed please use text to describe the study treatment. Multiple terms can be separated by one or more pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "MCO:0000866" .

MIXS:sulfate_fw a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sulfate in formation water" ;
    dcterms:title "sulfate in formation water" ;
    schema1:keywords "sulfate",
        "water" ;
    ns1:hasExactSynonym "sulfate_fw" ;
    rdfs:comment "Original sulfate concentration in the hydrocarbon resource" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter" .

MIXS:surf_material a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "surface material" ;
    dcterms:title "surface material" ;
    schema1:keywords "material",
        "surface" ;
    ns1:hasExactSynonym "surf_material" ;
    rdfs:comment "Surface materials at the point of sampling" ;
    rdfs:range MIXS:SurfMaterialEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:suspend_solids a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suspended solids" ;
    dcterms:title "suspended solids" ;
    schema1:keywords "solids",
        "suspended" ;
    ns1:hasExactSynonym "suspend_solids" ;
    rdfs:comment "Concentration of substances including a wide variety of material, such as silt, decaying plant and animal matter; can include multiple substances" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "suspended solid name;measurement value" ;
    MIXS:Preferred_unit "gram, microgram, milligram per liter, mole per liter, gram per liter, part per million" .

MIXS:tan a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "total acid number" ;
    dcterms:title "total acid number" ;
    schema1:keywords "number",
        "total" ;
    ns1:hasExactSynonym "tan" ;
    rdfs:comment "Total Acid Number (TAN) is a measurement of acidity that is determined by the amount of potassium hydroxide in milligrams that is needed to neutralize the acids in one gram of oil. It is an important quality measurement of crude oil. (source: https://en.wikipedia.org/wiki/Total_acid_number)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter" .

MIXS:tidal_stage a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tidal stage" ;
    dcterms:title "tidal stage" ;
    ns1:hasExactSynonym "tidal_stage" ;
    rdfs:comment "Stage of tide" ;
    rdfs:range MIXS:TidalStageEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:tillage a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "history/tillage" ;
    dcterms:title "history/tillage" ;
    schema1:keywords "history" ;
    ns1:hasExactSynonym "tillage" ;
    rdfs:comment "Note method(s) used for tilling" ;
    rdfs:range MIXS:TillageEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:toluene a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "toluene" ;
    dcterms:title "toluene" ;
    rdfs:comment "Concentration of toluene in the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, parts per million" .

MIXS:tot_depth_water_col a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "total depth of water column" ;
    dcterms:title "total depth of water column" ;
    schema1:keywords "depth",
        "total",
        "water" ;
    ns1:hasExactSynonym "tot_depth_water_col" ;
    rdfs:comment "Measurement of total depth of water column" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "meter" .

MIXS:tot_iron a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "total iron" ;
    dcterms:title "total iron" ;
    schema1:keywords "total" ;
    ns1:hasExactSynonym "tot_iron" ;
