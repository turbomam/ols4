MIXS:urogenit_disord a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "urogenital disorder" ;
    dcterms:title "urogenital disorder" ;
    schema1:keywords "disorder" ;
    ns1:hasExactSynonym "urogenit_disord" ;
    rdfs:comment "History of urogenital disorders, can include multiple disorders. The terms should be chosen from the DO (Human Disease Ontology) at http://www.disease-ontology.org, reproductive system disease (https://disease-ontology.org/?id=DOID:15) or urinary system disease (https://disease-ontology.org/?id=DOID:18)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:urogenit_tract_disor a owl:ObjectProperty,
        linkml:SlotDefinition ;
