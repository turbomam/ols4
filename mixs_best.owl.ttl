    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per cubic meter per day" .

MIXS:bac_resp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bacterial respiration" ;
    dcterms:title "bacterial respiration" ;
    ns1:hasExactSynonym "bac_resp" ;
    rdfs:comment "Measurement of bacterial respiration in the water column" ;
