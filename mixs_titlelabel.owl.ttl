    owl:unionOf ( <https://w3id.org/mixs/TaxIdentEnum#16S%20rRNA%20gene> <https://w3id.org/mixs/TaxIdentEnum#multi-marker%20approach> <https://w3id.org/mixs/TaxIdentEnum#other> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/TaxIdentEnum#16S%20rRNA%20gene>,
        <https://w3id.org/mixs/TaxIdentEnum#multi-marker%20approach>,
        <https://w3id.org/mixs/TaxIdentEnum#other> .

MIXS:ViralGenomeTypeEnum a owl:Class ;
    rdfs:label "ViralGenomeTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( SO:0000352 SO:0001198 <https://w3id.org/mixs/ViralGenomeTypeEnum#ssDNA> SO:0000356 SO:0001169 SO:0001199 SO:0001201 SO:0001200 <https://w3id.org/mixs/ViralGenomeTypeEnum#mixed> <https://w3id.org/mixs/ViralGenomeTypeEnum#uncharacterized> ) ;
    skos:definition "Types of viral genomes based on Baltimore classification" ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values SO:0000352,
        SO:0000356,
        SO:0001169,
        SO:0001198,
        SO:0001199,
        SO:0001200,
        SO:0001201,
        <https://w3id.org/mixs/ViralGenomeTypeEnum#mixed>,
        <https://w3id.org/mixs/ViralGenomeTypeEnum#ssDNA>,
        <https://w3id.org/mixs/ViralGenomeTypeEnum#uncharacterized> .

MIXS:ances_data a owl:DatatypeProperty ;
    rdfs:label "ancestral data" ;
    dcterms:title "ancestral data" ;
    ns1:hasExactSynonym "ances_data" ;
    rdfs:range xsd:string ;
    skos:definition "Information about either pedigree or other ancestral information description (e.g. parental variety in case of mutant or selection), e.g. A/3*B (meaning [(A x B) x B] x B)" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:bromide a owl:DatatypeProperty ;
    rdfs:label "bromide" ;
    dcterms:title "bromide" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of bromide" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "parts per million" .

MIXS:chimera_check a owl:DatatypeProperty ;
    rdfs:label "chimera check software" ;
    dcterms:title "chimera check software" ;
    schema1:keywords "software" ;
    ns1:hasExactSynonym "chimera_check" ;
    rdfs:range xsd:string ;
    skos:definition "Tool(s) used for chimera checking, including version number and parameters, to discover and remove chimeric sequences. A chimeric sequence is comprised of two or more phylogenetically distinct parent sequences" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:chlorophyll a owl:DatatypeProperty ;
    rdfs:label "chlorophyll" ;
    dcterms:title "chlorophyll" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of chlorophyll" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per cubic meter, microgram per liter" .

MIXS:cult_result a owl:ObjectProperty ;
    rdfs:label "culture result" ;
    dcterms:title "culture result" ;
    schema1:keywords "culture" ;
    ns1:hasExactSynonym "cult_result" ;
    rdfs:range MIXS:CultResultEnum ;
    skos:definition "Any result of a bacterial culture experiment reported as a binary assessment such as positive/negative, active/inactive" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:diss_hydrogen a owl:DatatypeProperty ;
    rdfs:label "dissolved hydrogen" ;
    dcterms:title "dissolved hydrogen" ;
    schema1:keywords "dissolved" ;
    ns1:hasExactSynonym "diss_hydrogen" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of dissolved hydrogen" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter" .

MIXS:diss_org_nitro a owl:DatatypeProperty ;
    rdfs:label "dissolved organic nitrogen" ;
    dcterms:title "dissolved organic nitrogen" ;
    schema1:keywords "dissolved",
        "nitrogen",
        "organic" ;
    ns1:hasExactSynonym "diss_org_nitro" ;
    rdfs:range xsd:string ;
    skos:definition "Dissolved organic nitrogen concentration measured as; total dissolved nitrogen - NH4 - NO3 - NO2" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:diss_oxygen a owl:DatatypeProperty ;
    rdfs:label "dissolved oxygen" ;
    dcterms:title "dissolved oxygen" ;
    schema1:keywords "dissolved",
        "oxygen" ;
    ns1:hasExactSynonym "diss_oxygen" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of dissolved oxygen" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per kilogram, milligram per liter" .

MIXS:food_contain_wrap a owl:DatatypeProperty ;
    rdfs:label "food container or wrapping" ;
    dcterms:title "food container or wrapping" ;
    schema1:keywords "food" ;
    ns1:hasExactSynonym "food_contain_wrap" ;
    skos:definition "Type of container or wrapping defined by the main container material, the container form, and the material of the liner lids or ends. Also type of container or wrapping by form; prefer description by material first, then by form. This field accepts terms listed under food container or wrapping (http://purl.obolibrary.org/obo/FOODON_03490100)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03490100" .

MIXS:food_quality_date a owl:DatatypeProperty ;
    rdfs:label "food quality date" ;
    dcterms:title "food quality date" ;
    schema1:keywords "date",
        "food",
        "quality" ;
    ns1:hasExactSynonym "food_quality_date" ;
    skos:definition "The date recommended for the use of the product while at peak quality, this date is not a reflection of safety unless used on infant formula this date is not a reflection of safety and is typically labeled on a food product as \"best if used by,\" best by,\" \"use by,\" or \"freeze by.\"" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration, date" .

MIXS:host_common_name a owl:DatatypeProperty ;
    rdfs:label "host common name" ;
    dcterms:title "host common name" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_common_name" ;
    rdfs:range xsd:string ;
    skos:definition "Common name of the host" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "" .

MIXS:host_diet a owl:DatatypeProperty ;
    rdfs:label "host diet" ;
    dcterms:title "host diet" ;
    schema1:keywords "diet",
        "host",
        "host." ;
    ns1:hasExactSynonym "host_diet" ;
    rdfs:range xsd:string ;
    skos:definition "Type of diet depending on the host, for animals omnivore, herbivore etc., for humans high-fat, meditteranean etc.; can include multiple diet types" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_last_meal a owl:DatatypeProperty ;
    rdfs:label "host last meal" ;
    dcterms:title "host last meal" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_last_meal" ;
    skos:definition "Content of last meal and time since feeding; can include multiple values" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "content;duration" .

MIXS:host_life_stage a owl:DatatypeProperty ;
    rdfs:label "host life stage" ;
    dcterms:title "host life stage" ;
    schema1:keywords "host",
        "host.",
        "life" ;
    ns1:hasExactSynonym "host_life_stage" ;
    rdfs:range xsd:string ;
    skos:definition "Description of life stage of host" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "stage" .

MIXS:host_spec_range a owl:DatatypeProperty ;
    rdfs:label "host specificity or range" ;
    dcterms:title "host specificity or range" ;
    schema1:keywords "host",
        "host.",
        "range" ;
    ns1:hasExactSynonym "host_spec_range" ;
    skos:definition "The range and diversity of host species that an organism is capable of infecting, defined by NCBI taxonomy identifier" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "NCBI taxid" .

MIXS:nitro a owl:DatatypeProperty ;
    rdfs:label "nitrogen" ;
    dcterms:title "nitrogen" ;
    schema1:keywords "nitrogen" ;
    ns1:hasExactSynonym "nitro" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of nitrogen (total)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter" .

MIXS:org_carb a owl:DatatypeProperty ;
    rdfs:label "organic carbon" ;
    dcterms:title "organic carbon" ;
    schema1:keywords "carbon",
        "organic" ;
    ns1:hasExactSynonym "org_carb" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of organic carbon" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:pcr_cond a owl:DatatypeProperty ;
    rdfs:label "pcr conditions" ;
    dcterms:title "pcr conditions" ;
    schema1:keywords "condition",
        "pcr" ;
    ns1:hasExactSynonym "pcr_cond" ;
    skos:definition "Description of reaction conditions and components of polymerase chain reaction performed during library preparation." ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "initial denaturation:degrees_minutes;annealing:degrees_minutes;elongation:degrees_minutes;final elongation:degrees_minutes;total cycles" .

MIXS:pcr_primers a owl:DatatypeProperty ;
    rdfs:label "pcr primers" ;
    dcterms:title "pcr primers" ;
    schema1:keywords "pcr" ;
    ns1:hasExactSynonym "pcr_primers" ;
    skos:definition "PCR primers that were used to amplify the sequence of the targeted gene, locus or subfragment. This field should contain all the primers used for a single PCR reaction if multiple forward or reverse primers are present in a single PCR reaction. The primer sequence should be reported in uppercase letters" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_purpose a owl:DatatypeProperty ;
    rdfs:label "purpose of sampling" ;
    dcterms:title "purpose of sampling" ;
    schema1:keywords "purpose" ;
    ns1:hasExactSynonym "samp_purpose" ;
    skos:definition "The reason that the sample was collected" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration or {text}" .

MIXS:samp_source_mat_cat a owl:DatatypeProperty ;
    rdfs:label "sample source material category" ;
    dcterms:title "sample source material category" ;
    schema1:keywords "material",
        "sample",
        "source" ;
    ns1:hasExactSynonym "samp_source_mat_cat" ;
    skos:definition "This is the scientific role or category that the subject organism or material has with respect to an investigation.  This field accepts terms listed under specimen source material category (http://purl.obolibrary.org/obo/GENEPIO_0001237 or http://purl.obolibrary.org/obo/OBI_0100051)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "GENEPIO:0001237" .

MIXS:samp_type a owl:DatatypeProperty ;
    rdfs:label "sample type" ;
    dcterms:title "sample type" ;
    schema1:keywords "sample",
        "type" ;
    ns1:hasExactSynonym "samp_type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of material from which the sample was obtained. For the Hydrocarbon package, samples include types like core, rock trimmings, drill cuttings, piping section, coupon, pigging debris, solid deposit, produced fluid, produced water, injected water, swabs, etc. For the Food Package, samples are usually categorized as food, body products or tissues, or environmental material. This field accepts terms listed under environmental specimen (http://purl.obolibrary.org/obo/GENEPIO_0001246)" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:seq_quality_check a owl:ObjectProperty ;
    rdfs:label "sequence quality check" ;
    dcterms:title "sequence quality check" ;
    schema1:keywords "quality" ;
    ns1:hasExactSynonym "seq_quality_check" ;
    rdfs:range MIXS:SeqQualityCheckEnum ;
    skos:definition "Indicate if the sequence has been called by automatic systems (none) or undergone a manual editing procedure (e.g. by inspecting the raw data or chromatograms). Applied only for sequences that are not submitted to SRA,ENA or DRA" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "none or manually edited" .

MIXS:sequencing_kit a owl:DatatypeProperty ;
    rdfs:label "sequencing kit" ;
    dcterms:title "sequencing kit" ;
    schema1:keywords "kit" ;
    ns1:hasExactSynonym "sequencing_kit" ;
    rdfs:range xsd:string ;
    skos:definition "Pre-filled, ready-to-use reagent cartridges. Used to produce improved chemistry, cluster density and read length as well as improve quality (Q) scores. Reagent components are encoded to interact with the sequencing system to validate compatibility with user-defined applications. Indicate name of the sequencing kit" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "name of sequencing kit used" .

MIXS:silicate a owl:DatatypeProperty ;
    rdfs:label "silicate" ;
    dcterms:title "silicate" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of silicate" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter" .

MIXS:target_gene a owl:DatatypeProperty ;
    rdfs:label "target gene" ;
    dcterms:title "target gene" ;
    schema1:keywords "target" ;
    ns1:hasExactSynonym "target_gene" ;
    rdfs:range xsd:string ;
    skos:definition "Targeted gene or locus name for marker gene studies" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:target_subfragment a owl:DatatypeProperty ;
    rdfs:label "target subfragment" ;
    dcterms:title "target subfragment" ;
    schema1:keywords "target" ;
    ns1:hasExactSynonym "target_subfragment" ;
    rdfs:range xsd:string ;
    skos:definition "Name of subfragment of a gene or locus. Important to e.g. identify special regions on marker genes like V6 on 16S rRNA" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:timepoint a owl:DatatypeProperty ;
    rdfs:label "timepoint" ;
    dcterms:title "timepoint" ;
    schema1:keywords "time" ;
    rdfs:range xsd:string ;
    skos:definition "Time point at which a sample or observation is made or taken from a biomaterial as measured from some reference point. Indicate the timepoint written in ISO 8601 format" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "hours or days" .

MIXS:tot_nitro a owl:DatatypeProperty ;
    rdfs:label "total nitrogen concentration" ;
    dcterms:title "total nitrogen concentration" ;
    schema1:keywords "concentration",
        "nitrogen",
        "total" ;
    ns1:hasExactSynonym "tot_nitro" ;
    rdfs:range xsd:string ;
    skos:definition "Total nitrogen concentration of water samples, calculated by: total nitrogen = total dissolved nitrogen + particulate nitrogen. Can also be measured without filtering, reported as nitrogen" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "microgram per liter, micromole per liter, milligram per liter" .

MIXS:turbidity a owl:DatatypeProperty ;
    rdfs:label "turbidity" ;
    dcterms:title "turbidity" ;
    rdfs:range xsd:string ;
    skos:definition "Measure of the amount of cloudiness or haziness in water caused by individual particles" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:BioticRelationshipEnum a owl:Class ;
    rdfs:label "BioticRelationshipEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/BioticRelationshipEnum#commensalism> <https://w3id.org/mixs/BioticRelationshipEnum#free%20living> <https://w3id.org/mixs/BioticRelationshipEnum#mutualism> <https://w3id.org/mixs/BioticRelationshipEnum#parasitism> <https://w3id.org/mixs/BioticRelationshipEnum#symbiotic> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/BioticRelationshipEnum#commensalism>,
        <https://w3id.org/mixs/BioticRelationshipEnum#free%20living>,
        <https://w3id.org/mixs/BioticRelationshipEnum#mutualism>,
        <https://w3id.org/mixs/BioticRelationshipEnum#parasitism>,
        <https://w3id.org/mixs/BioticRelationshipEnum#symbiotic> .

MIXS:Checklist a owl:Class ;
    rdfs:label "Checklist" ;
    rdfs:subClassOf linkml:ClassDefinition ;
    skos:definition "A collection of metadata terms (slots) to minimally describe the sampling and sequencing method of a specimen used to generate a nucleotide sequence." ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:CultResultEnum a owl:Class ;
    rdfs:label "CultResultEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/CultResultEnum#absent> <https://w3id.org/mixs/CultResultEnum#active> <https://w3id.org/mixs/CultResultEnum#inactive> <https://w3id.org/mixs/CultResultEnum#negative> <https://w3id.org/mixs/CultResultEnum#no> <https://w3id.org/mixs/CultResultEnum#positive> <https://w3id.org/mixs/CultResultEnum#present> <https://w3id.org/mixs/CultResultEnum#yes> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/CultResultEnum#absent>,
        <https://w3id.org/mixs/CultResultEnum#active>,
        <https://w3id.org/mixs/CultResultEnum#inactive>,
        <https://w3id.org/mixs/CultResultEnum#negative>,
        <https://w3id.org/mixs/CultResultEnum#no>,
        <https://w3id.org/mixs/CultResultEnum#positive>,
        <https://w3id.org/mixs/CultResultEnum#present>,
        <https://w3id.org/mixs/CultResultEnum#yes> .

MIXS:FacilityTypeEnum a owl:Class ;
    rdfs:label "FacilityTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/FacilityTypeEnum#ambient%20storage> <https://w3id.org/mixs/FacilityTypeEnum#caterer-catering%20point> <https://w3id.org/mixs/FacilityTypeEnum#distribution> <https://w3id.org/mixs/FacilityTypeEnum#frozen%20storage> <https://w3id.org/mixs/FacilityTypeEnum#importer-broker> <https://w3id.org/mixs/FacilityTypeEnum#interstate%20conveyance> <https://w3id.org/mixs/FacilityTypeEnum#labeler-relabeler> <https://w3id.org/mixs/FacilityTypeEnum#manufacturing-processing> <https://w3id.org/mixs/FacilityTypeEnum#packaging> <https://w3id.org/mixs/FacilityTypeEnum#refrigerated%20storage> <https://w3id.org/mixs/FacilityTypeEnum#storage> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/FacilityTypeEnum#ambient%20storage>,
        <https://w3id.org/mixs/FacilityTypeEnum#caterer-catering%20point>,
        <https://w3id.org/mixs/FacilityTypeEnum#distribution>,
        <https://w3id.org/mixs/FacilityTypeEnum#frozen%20storage>,
        <https://w3id.org/mixs/FacilityTypeEnum#importer-broker>,
        <https://w3id.org/mixs/FacilityTypeEnum#interstate%20conveyance>,
        <https://w3id.org/mixs/FacilityTypeEnum#labeler-relabeler>,
        <https://w3id.org/mixs/FacilityTypeEnum#manufacturing-processing>,
        <https://w3id.org/mixs/FacilityTypeEnum#packaging>,
        <https://w3id.org/mixs/FacilityTypeEnum#refrigerated%20storage>,
        <https://w3id.org/mixs/FacilityTypeEnum#storage> .

MIXS:InsdcMissingValueEnum a owl:Class ;
    rdfs:label "InsdcMissingValueEnum" ;
    rdfs:seeAlso <https://www.insdc.org/technical-specifications/missing-value-reporting/> ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/InsdcMissingValueEnum#not%20applicable> <https://w3id.org/mixs/InsdcMissingValueEnum#missing> <https://w3id.org/mixs/InsdcMissingValueEnum#not%20collected> <https://w3id.org/mixs/InsdcMissingValueEnum#not%20provided> <https://w3id.org/mixs/InsdcMissingValueEnum#restricted%20access> <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20control%20sample> <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20sample%20group> <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20synthetic%20construct> <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20lab%20stock> <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20third%20party%20data> <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20data%20agreement%20established%20pre-2023> <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20endangered%20species> <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20human-identifiable> ) ;
    skos:definition "Permissible values recommended by INSDC for reporting missing metadata values." ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "Please use the above standardised missing value vocabulary only if a true value of an expected format for a mandatory field is missing. If a true value is missing for a recommended or an optional field, then these fields should not be used for reporting at all. When reporting a missing mandatory field, the eight granular 'reporting level' terms need to be preceded with the term \"missing:\" to declare both the absence of a true value as well as the reason.",
        "The International Nucleotide Database Collaboration (INSDC) have a standardised missing/null value reporting language to be used where a value of an expected format for sample metadata reporting can not be provided.",
        "The controlled vocabulary takes into account different type of constraints. Submitters are strongly encouraged to always provide true values. However, if missing/null value reporting is required, submitters are asked to use a term with the finest granularity for their situation. See the table below for accepted missing value reporting terms." ;
    linkml:permissible_values <https://w3id.org/mixs/InsdcMissingValueEnum#missing>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20control%20sample>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20data%20agreement%20established%20pre-2023>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20endangered%20species>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20human-identifiable>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20lab%20stock>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20sample%20group>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20synthetic%20construct>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20third%20party%20data>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#not%20applicable>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#not%20collected>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#not%20provided>,
        <https://w3id.org/mixs/InsdcMissingValueEnum#restricted%20access> .

MIXS:RoomConnectedEnum a owl:Class ;
    rdfs:label "RoomConnectedEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/RoomConnectedEnum#attic> <https://w3id.org/mixs/RoomConnectedEnum#bathroom> <https://w3id.org/mixs/RoomConnectedEnum#closet> <https://w3id.org/mixs/RoomConnectedEnum#conference%20room> <https://w3id.org/mixs/RoomConnectedEnum#elevator> <https://w3id.org/mixs/RoomConnectedEnum#examining%20room> <https://w3id.org/mixs/RoomConnectedEnum#hallway> <https://w3id.org/mixs/RoomConnectedEnum#kitchen> <https://w3id.org/mixs/RoomConnectedEnum#mail%20room> <https://w3id.org/mixs/RoomConnectedEnum#office> <https://w3id.org/mixs/RoomConnectedEnum#stairwell> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/RoomConnectedEnum#attic>,
        <https://w3id.org/mixs/RoomConnectedEnum#bathroom>,
