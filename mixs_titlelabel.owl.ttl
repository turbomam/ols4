    dcterms:title "pregnancy" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date due of pregnancy" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:primary_prod a owl:DatatypeProperty ;
    rdfs:label "primary production" ;
    dcterms:title "primary production" ;
    schema1:keywords "primary",
        "production" ;
    ns1:hasExactSynonym "primary_prod" ;
    rdfs:range xsd:string ;
