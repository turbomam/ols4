        <https://w3id.org/mixs/FaoClassEnum#Podzoluvisols>,
        <https://w3id.org/mixs/FaoClassEnum#Rankers>,
        <https://w3id.org/mixs/FaoClassEnum#Regosols>,
        <https://w3id.org/mixs/FaoClassEnum#Rendzinas>,
        <https://w3id.org/mixs/FaoClassEnum#Solonchaks>,
        <https://w3id.org/mixs/FaoClassEnum#Solonetz>,
        <https://w3id.org/mixs/FaoClassEnum#Stagnosols>,
        <https://w3id.org/mixs/FaoClassEnum#Technosols>,
        <https://w3id.org/mixs/FaoClassEnum#Umbrisols>,
        <https://w3id.org/mixs/FaoClassEnum#Vertisols>,
        <https://w3id.org/mixs/FaoClassEnum#Yermosols> .

MIXS:temp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "temperature" ;
    dcterms:title "temperature" ;
    schema1:keywords "temperature" ;
    ns1:hasExactSynonym "temp" ;
    rdfs:comment "Temperature of the sample at the time of sampling" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:project_name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "project name" ;
    dcterms:title "project name" ;
    schema1:keywords "project" ;
    ns1:hasExactSynonym "project_name" ;
    rdfs:comment "Name of the project within which the sequencing was organized" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample name" ;
    dcterms:title "sample name" ;
    schema1:keywords "sample" ;
    ns1:hasExactSynonym "samp_name" ;
    rdfs:comment "A local identifier or name that for the material sample used for extracting nucleic acids, and subsequent sequencing. It can refer either to the original material collected or to any derived sub-samples. It can have any format, but we suggest that you make it concise, unique and consistent within your lab, and as informative as possible. INSDC requires every sample name from a single Submitter to be unique. Use of a globally unique identifier for the field source_mat_id is recommended in addition to sample_name" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "" .

MIXS:samp_vol_we_dna_ext a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample volume or weight for DNA extraction" ;
    dcterms:title "sample volume or weight for DNA extraction" ;
    schema1:keywords "dna",
        "sample",
        "volume",
        "weight" ;
    ns1:hasExactSynonym "samp_vol_we_dna_ext" ;
    rdfs:comment "Volume (ml) or mass (g) of total collected sample processed for DNA extraction. Note: total sample collected should be entered under the term Sample Size (MIXS:0000001)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milliliter, gram, milligram, square centimeter" .

linkml:EnumDefinition a owl:Class ;
    rdfs:label "enumeration" .

