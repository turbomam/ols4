<https://w3id.org/mixs/InsdcMissingValueEnum#missing> a owl:Class ;
    rdfs:label "missing" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:altLabel "no data",
        "not available",
        "unavailable",
        "unknown",
        "unspecified" .

<https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20control%20sample> a owl:Class ;
    rdfs:label "missing: control sample" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:definition "Information is not applicable as the sample represents a negative control sample collected in a lab." .

<https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20data%20agreement%20established%20pre-2023> a owl:Class ;
    rdfs:label "missing: data agreement established pre-2023" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:definition """Data agreements were established before the 2023 INSDC standard and metadata can not be provided. A value may be given at a later stage.
""" .

<https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20endangered%20species> a owl:Class ;
    rdfs:label "missing: endangered species" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:definition "Information can not be reported as the target organism is endangered e.g. on the IUCN red-list." .

<https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20human-identifiable> a owl:Class ;
    rdfs:label "missing: human-identifiable" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:definition "Information can not be reported as the metadata would make the sample human-identifiable." .

<https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20lab%20stock> a owl:Class ;
    rdfs:label "missing: lab stock" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:definition """Information was not collected as the sample represents a cultured cell line or model organism under long-term lab control.
""" .

<https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20sample%20group> a owl:Class ;
    rdfs:label "missing: sample group" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:definition """Information is not applicable as the sample represents a group of samples that do not have a single origin. E.g. for co-assembly or transcriptome assembly.
""" .

<https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20synthetic%20construct> a owl:Class ;
    rdfs:label "missing: synthetic construct" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:definition "Information does not exist as the sample represents an ab-initio synthetic construct." .

<https://w3id.org/mixs/InsdcMissingValueEnum#missing%3A%20third%20party%20data> a owl:Class ;
    rdfs:label "missing: third party data" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:definition """Information does not exist as the metadata was not collected or reported in records predating the 2023 agreement. For use in Third PArty data submissions.
""" .

<https://w3id.org/mixs/InsdcMissingValueEnum#not%20applicable> a owl:Class ;
    rdfs:label "not applicable" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:altLabel "n/a",
        "na" ;
    skos:definition """Information is inappropriate to report, can indicate that the standard itself fails to model or represent the information appropriately
""" .

<https://w3id.org/mixs/InsdcMissingValueEnum#not%20collected> a owl:Class ;
    rdfs:label "not collected" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:altLabel "not determined",
        "not recorded" ;
    skos:definition "Information of an expected format was not given because it has not been collected" .

<https://w3id.org/mixs/InsdcMissingValueEnum#not%20provided> a owl:Class ;
    rdfs:label "not provided" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:altLabel "not reported" ;
    skos:definition "Information of an expected format was not given, a value may be given at the later stage" .

<https://w3id.org/mixs/InsdcMissingValueEnum#restricted%20access> a owl:Class ;
    rdfs:label "restricted access" ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:InsdcMissingValueEnum ;
    skos:altLabel "restricted" ;
    skos:definition "Information exists but can not be released openly because of privacy concerns" .

