    dcterms:title "heating system identifier" ;
    schema1:keywords "identifier" ;
    ns1:hasExactSynonym "heat_system_id" ;
    rdfs:range xsd:integer ;
    skos:definition "The heating system identifier" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:height_carper_fiber a owl:DatatypeProperty ;
    rdfs:label "height carpet fiber mat" ;
    dcterms:title "height carpet fiber mat" ;
    schema1:keywords "height" ;
    ns1:hasExactSynonym "height_carper_fiber" ;
    rdfs:range xsd:string ;
