    schema1:keywords "duration",
        "incubation",
        "period" ;
    ns1:hasExactSynonym "study_inc_dur" ;
    rdfs:comment "Sample incubation duration if unpublished or unvalidated method is used. Indicate the timepoint written in ISO 8601 format" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "hours or days" .

