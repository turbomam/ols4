MIXS:host_of_host_sub_id a owl:DatatypeProperty ;
    rdfs:label "host of the symbiotic host subject id" ;
    dcterms:title "host of the symbiotic host subject id" ;
    schema1:keywords "host",
        "host.",
        "identifier",
        "symbiosis" ;
    ns1:hasExactSynonym "host_of_host_sub_id" ;
    rdfs:range xsd:string ;
