    rdfs:label "microbial starter preparation" ;
    dcterms:title "microbial starter preparation" ;
    schema1:keywords "microbial",
        "preparation" ;
    ns1:hasExactSynonym "microb_start_prep" ;
    rdfs:range xsd:string ;
