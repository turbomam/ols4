    rdfs:comment "The ability of the wall to provide inertia against temperature fluctuations. Generally this means concrete or concrete block that is either exposed or covered only with paint" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "joule per degree Celsius" .

MIXS:wall_water_mold a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "wall signs of water/mold" ;
    dcterms:title "wall signs of water/mold" ;
    schema1:keywords "wall" ;
    ns1:hasExactSynonym "wall_water_mold" ;
    rdfs:comment "Signs of the presence of mold or mildew on a wall" ;
    rdfs:range MIXS:MoldVisibilityEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:wastewater_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "wastewater type" ;
    dcterms:title "wastewater type" ;
    schema1:keywords "type" ;
    ns1:hasExactSynonym "wastewater_type" ;
    rdfs:comment "The origin of wastewater such as human waste, rainfall, storm drains, etc" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "wastewater type name" .

MIXS:water_cont_soil_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "water content method" ;
    dcterms:title "water content method" ;
    schema1:keywords "content",
        "method",
        "water" ;
    ns1:hasExactSynonym "water_cont_soil_meth" ;
    rdfs:comment "Reference or method used in determining the water content of soil" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:water_cut a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "water cut" ;
    dcterms:title "water cut" ;
    schema1:keywords "water" ;
    ns1:hasExactSynonym "water_cut" ;
    rdfs:comment "Current amount of water (%) in a produced fluid stream; or the average of the combined streams" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "percent or float?" ;
    MIXS:Preferred_unit "percent" .

MIXS:water_feat_size a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "water feature size" ;
    dcterms:title "water feature size" ;
    schema1:keywords "feature",
        "size",
        "water" ;
    ns1:hasExactSynonym "water_feat_size" ;
    rdfs:comment "The size of the water feature" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "square meter" .

MIXS:water_feat_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "water feature type" ;
    dcterms:title "water feature type" ;
    schema1:keywords "feature",
        "type",
        "water" ;
    ns1:hasExactSynonym "water_feat_type" ;
    rdfs:comment "The type of water feature present within the building being sampled" ;
    rdfs:range MIXS:WaterFeatTypeEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:water_frequency a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "water delivery frequency" ;
    dcterms:title "water delivery frequency" ;
    schema1:keywords "delivery",
        "frequency",
        "water" ;
    ns1:hasExactSynonym "water_frequency" ;
    rdfs:comment "Number of water delivery events within a given period of time" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "rate" ;
    MIXS:Preferred_unit "per day, per week, per month" .

MIXS:water_prod_rate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "water production rate" ;
    dcterms:title "water production rate" ;
    schema1:keywords "production",
        "rate",
        "water" ;
    ns1:hasExactSynonym "water_prod_rate" ;
    rdfs:comment "Water production rates per well (e.g. 987 m3 / day)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "cubic meter per day" .

MIXS:weekday a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "weekday" ;
    dcterms:title "weekday" ;
    rdfs:comment "The day of the week when sampling occurred" ;
    rdfs:range MIXS:WeekdayEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:weight_loss_3_month a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "weight loss in last three months" ;
    dcterms:title "weight loss in last three months" ;
    schema1:keywords "months",
        "weight" ;
    ns1:hasExactSynonym "weight_loss_3_month" ;
    rdfs:comment "Specification of weight loss in the last three months, if yes should be further specified to include amount of weight loss" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "weight loss specification;measurement value" ;
    MIXS:Preferred_unit "kilogram, gram" .

MIXS:window_cond a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window condition" ;
    dcterms:title "window condition" ;
    schema1:keywords "condition",
        "window" ;
    ns1:hasExactSynonym "window_cond" ;
    rdfs:comment "The physical condition of the window at the time of sampling" ;
    rdfs:range MIXS:DamagedRupturedEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_cover a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window covering" ;
    dcterms:title "window covering" ;
    schema1:keywords "window" ;
    ns1:hasExactSynonym "window_cover" ;
    rdfs:comment "The type of window covering" ;
    rdfs:range MIXS:WindowCoverEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_horiz_pos a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window horizontal position" ;
    dcterms:title "window horizontal position" ;
    schema1:keywords "window" ;
    ns1:hasExactSynonym "window_horiz_pos" ;
    rdfs:comment "The horizontal position of the window on the wall" ;
    rdfs:range MIXS:WindowHorizPosEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_loc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window location" ;
    dcterms:title "window location" ;
    schema1:keywords "location",
        "window" ;
    ns1:hasExactSynonym "window_loc" ;
    rdfs:comment "The relative location of the window within the room" ;
    rdfs:range MIXS:CompassDirections8Enum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_mat a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window material" ;
    dcterms:title "window material" ;
    schema1:keywords "material",
        "window" ;
    ns1:hasExactSynonym "window_mat" ;
    rdfs:comment "The type of material used to finish a window" ;
    rdfs:range MIXS:WindowMatEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_open_freq a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window open frequency" ;
    dcterms:title "window open frequency" ;
    schema1:keywords "frequency",
        "window" ;
    ns1:hasExactSynonym "window_open_freq" ;
    rdfs:comment "The number of times windows are opened per week" ;
    rdfs:range linkml:Integer ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_size a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window area/size" ;
    dcterms:title "window area/size" ;
    schema1:keywords "window" ;
    ns1:hasExactSynonym "window_size" ;
    rdfs:comment "The window's length and width" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value" ;
    MIXS:Preferred_unit "inch, meter" .

MIXS:window_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window status" ;
    dcterms:title "window status" ;
    schema1:keywords "status",
        "window" ;
    ns1:hasExactSynonym "window_status" ;
    rdfs:comment "Defines whether the windows were open or closed during environmental testing" ;
    rdfs:range MIXS:WindowStatusEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window type" ;
    dcterms:title "window type" ;
    schema1:keywords "type",
        "window" ;
    ns1:hasExactSynonym "window_type" ;
    rdfs:comment "The type of windows" ;
    rdfs:range MIXS:WindowTypeEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_vert_pos a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window vertical position" ;
    dcterms:title "window vertical position" ;
    schema1:keywords "window" ;
    ns1:hasExactSynonym "window_vert_pos" ;
    rdfs:comment "The vertical position of the window on the wall" ;
    rdfs:range MIXS:WindowVertPosEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:window_water_mold a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "window signs of water/mold" ;
    dcterms:title "window signs of water/mold" ;
    schema1:keywords "window" ;
    ns1:hasExactSynonym "window_water_mold" ;
    rdfs:comment "Signs of the presence of mold or mildew on the window" ;
    rdfs:range MIXS:MoldVisibilityEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:adjacent_environment a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "environment adjacent to site" ;
    dcterms:title "environment adjacent to site" ;
    schema1:keywords "adjacent",
        "environment",
        "site" ;
    ns1:hasExactSynonym "adjacent_environment" ;
    rdfs:comment "Description of the environmental system or features that are adjacent to the sampling site. This field accepts terms under ecosystem (http://purl.obolibrary.org/obo/ENVO_01001110) and human construction (http://purl.obolibrary.org/obo/ENVO_00000070). Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "ENVO_01001110 or ENVO_00000070" .

MIXS:agrochem_addition a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "history/agrochemical additions" ;
    dcterms:title "history/agrochemical additions" ;
    schema1:keywords "history" ;
    ns1:hasExactSynonym "agrochem_addition" ;
    rdfs:comment "Addition of fertilizers, pesticides, etc. - amount and time of applications" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:air_PM_concen a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "air particulate matter concentration" ;
    dcterms:title "air particulate matter concentration" ;
    schema1:keywords "air",
        "concentration",
        "particle",
        "particulate" ;
    ns1:hasExactSynonym "air_PM_concen" ;
    rdfs:comment "Concentration of substances that remain suspended in the air, and comprise mixtures of organic and inorganic substances (PM10 and PM2.5); can report multiple PM's by entering numeric values preceded by name of PM" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:anim_water_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "animal water delivery method" ;
    dcterms:title "animal water delivery method" ;
    schema1:keywords "animal",
        "delivery",
        "method",
        "water" ;
    ns1:hasExactSynonym "anim_water_method" ;
    rdfs:comment "Description of the equipment or method used to distribute water to livestock. This field accepts termed listed under water delivery equipment (http://opendata.inra.fr/EOL/EOL_0001653). Multiple terms can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:animal_diet a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food animal source diet" ;
    dcterms:title "food animal source diet" ;
    schema1:keywords "animal",
        "diet",
        "food",
        "source" ;
    ns1:hasExactSynonym "animal_diet" ;
    rdfs:comment "If the isolate is from a food animal, the type of diet eaten by the food animal.  Please list the main food staple and the setting, if appropriate.  For a list of acceptable animal feed terms or categories, please see http://www.feedipedia.org.  Multiple terms may apply and can be separated by pipes |Food product for animal covers foods intended for consumption by domesticated animals. Consult http://purl.obolibrary.org/obo/FOODON_03309997. If the proper descriptor is not listed please use text to describe the food type. Multiple terms can be separated by one or more pipes. If the proper descriptor is not listed please use text to describe the food product type" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "text or FOODON_03309997" .

MIXS:animal_feed_equip a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "animal feeding equipment" ;
    dcterms:title "animal feeding equipment" ;
    schema1:keywords "animal",
        "equipment" ;
    ns1:hasExactSynonym "animal_feed_equip" ;
    rdfs:comment "Description of the feeding equipment used for livestock. This field accepts terms listed under feed delivery (http://opendata.inra.fr/EOL/EOL_0001757). Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "EOL:0001757" .

MIXS:animal_housing a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "animal housing system" ;
    dcterms:title "animal housing system" ;
    schema1:keywords "animal" ;
    ns1:hasExactSynonym "animal_housing" ;
    rdfs:comment "Description of the housing system of the livestock. This field accepts terms listed under terrestrial management housing system (http://opendata.inra.fr/EOL/EOL_0001605)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:biotic_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "biotic regimen" ;
    dcterms:title "biotic regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "biotic_regm" ;
    rdfs:comment "Information about treatment(s) involving use of biotic factors, such as bacteria, viruses or fungi" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:climate_environment a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "climate environment" ;
    dcterms:title "climate environment" ;
    schema1:keywords "environment" ;
    ns1:hasExactSynonym "climate_environment" ;
    rdfs:comment "Treatment involving an exposure to a particular climate; treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple climates" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:dietary_claim_use a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dietary claim or use" ;
    dcterms:title "dietary claim or use" ;
    schema1:keywords "diet",
        "use" ;
    ns1:hasExactSynonym "dietary_claim_use" ;
    rdfs:comment "These descriptors are used either for foods intended for special dietary use as defined in 21 CFR 105 or for foods that have special characteristics indicated in the name or labeling. This field accepts terms listed under dietary claim or use (http://purl.obolibrary.org/obo/FOODON_03510023). Multiple terms can be separated by one or more pipes, but please consider limiting this list to the most prominent dietary claim or use" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03510023" .

MIXS:farm_equip a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "farm equipment used" ;
    dcterms:title "farm equipment used" ;
    schema1:keywords "equipment",
        "farm",
        "use" ;
    ns1:hasExactSynonym "farm_equip" ;
    rdfs:comment "List of equipment used for planting, fertilization, harvesting, irrigation, land levelling, residue management, weeding or transplanting during the growing season.  This field accepts terms listed under agricultural implement (http://purl.obolibrary.org/obo/AGRO_00000416). Multiple terms can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:farm_equip_san a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "farm equipment sanitization" ;
    dcterms:title "farm equipment sanitization" ;
    schema1:keywords "equipment",
        "farm" ;
    ns1:hasExactSynonym "farm_equip_san" ;
    rdfs:comment "Method used to sanitize growing and harvesting equipment. This can including type and concentration of sanitizing solution.  Multiple terms can be separated by one or more pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "text or commercial name of sanitizer or class of sanitizer or active ingredient in sanitizer" ;
    MIXS:Preferred_unit "parts per million" .

MIXS:farm_equip_shared a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "equipment shared with other farms" ;
    dcterms:title "equipment shared with other farms" ;
    schema1:keywords "equipment",
        "farm" ;
    ns1:hasExactSynonym "farm_equip_shared" ;
    rdfs:comment "List of planting, growing or harvesting equipment shared with other farms. This field accepts terms listed under agricultural implement (http://purl.obolibrary.org/obo/AGRO_00000416). Multiple terms can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_allergen_label a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food allergen labeling" ;
    dcterms:title "food allergen labeling" ;
    schema1:keywords "food" ;
    ns1:hasExactSynonym "food_allergen_label" ;
    rdfs:comment "A label indication that the product contains a recognized allergen. This field accepts terms listed under dietary claim or use (http://purl.obolibrary.org/obo/FOODON_03510213)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03510213" .

MIXS:food_dis_point_city a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food distribution point geographic location (city)" ;
    dcterms:title "food distribution point geographic location (city)" ;
    schema1:keywords "food",
        "geographic",
        "location" ;
    ns1:hasExactSynonym "food_dis_point_city" ;
    rdfs:comment "A reference to a place on the Earth, by its name or by its geographical location that refers to a distribution point along the food chain. This field accepts terms listed under geographic location (http://purl.obolibrary.org/obo/GAZ_00000448). Reference: Adam Diamond, James Barham. Moving Food Along the Value Chain: Innovations in Regional Food Distribution. U.S. Dept. of Agriculture, Agricultural Marketing Service. Washington, DC. March 2012. http://dx.doi.org/10.9752/MS045.03-2012" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "GAZ:00000448" .

MIXS:food_harvest_proc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "Food harvesting process" ;
    dcterms:title "Food harvesting process" ;
    schema1:keywords "food",
        "process" ;
    ns1:hasExactSynonym "food_harvest_proc" ;
    rdfs:comment "A harvesting process is a process which takes in some food material from an individual or community of plant or animal organisms in a given context and time, and outputs a precursor or consumable food product. This may include a part of an organism or the whole, and may involve killing the organism" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_prod_char a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food production characteristics" ;
    dcterms:title "food production characteristics" ;
    schema1:keywords "food",
        "production" ;
    ns1:hasExactSynonym "food_prod_char" ;
    rdfs:comment "Descriptors of the food production system such as wild caught, free-range, organic, free-range, industrial, dairy, beef" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:fungicide_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fungicide regimen" ;
    dcterms:title "fungicide regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "fungicide_regm" ;
    rdfs:comment "Information about treatment involving use of fungicides; should include the name of fungicide, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple fungicide regimens" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:gaseous_environment a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gaseous environment" ;
    dcterms:title "gaseous environment" ;
    schema1:keywords "environment" ;
    ns1:hasExactSynonym "gaseous_environment" ;
    rdfs:comment "Use of conditions with differing gaseous environments; should include the name of gaseous compound, amount administered, treatment duration, interval and total experimental duration; can include multiple gaseous environment regimens" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter" .

MIXS:herbicide_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "herbicide regimen" ;
    dcterms:title "herbicide regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "herbicide_regm" ;
    rdfs:comment "Information about treatment involving use of herbicides; information about treatment involving use of growth hormones; should include the name of herbicide, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple regimens" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:isotope a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isotope" ;
    dcterms:title "isotope" ;
    rdfs:comment "The element and mass number of the stable isotope used in isotopologue labeling." ;
    rdfs:range MIXS:IsotopeEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:isotopolog a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isotopolog" ;
    dcterms:title "isotopolog" ;
    rdfs:comment "Isotopologue (isotope source/substrate/molecule) added to the biological sample." ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "List the PubChem Compound Identification (CID) number. If it's an undefined mixture, enter 0." .

MIXS:mechanical_damage a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mechanical damage" ;
    dcterms:title "mechanical damage" ;
    ns1:hasExactSynonym "mechanical_damage" ;
    rdfs:comment "Information about any mechanical damage exerted on the plant; can include multiple damages and sites" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "damage type;body site" .

MIXS:non_min_nutr_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "non-mineral nutrient regimen" ;
    dcterms:title "non-mineral nutrient regimen" ;
    schema1:keywords "non-mineral",
        "nutrient",
        "regimen" ;
    ns1:hasExactSynonym "non_min_nutr_regm" ;
    rdfs:comment "Information about treatment involving the exposure of plant to non-mineral nutrient such as oxygen, hydrogen or carbon; should include the name of non-mineral nutrient, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple non-mineral nutrient regimens" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:nucl_acid_ext_kit a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nucleic acid extraction kit" ;
    dcterms:title "nucleic acid extraction kit" ;
    schema1:keywords "kit" ;
    ns1:hasExactSynonym "nucl_acid_ext_kit" ;
    rdfs:comment "The name of the extraction kit used to recover the nucleic acid fraction of an input material is performed" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "The name of an extraction kit" .

MIXS:pesticide_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pesticide regimen" ;
    dcterms:title "pesticide regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "pesticide_regm" ;
    rdfs:comment "Information about treatment involving use of insecticides; should include the name of pesticide, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple pesticide regimens" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:ph_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pH regimen" ;
    dcterms:title "pH regimen" ;
    schema1:keywords "ph",
        "regimen" ;
    ns1:hasExactSynonym "ph_regm" ;
    rdfs:comment "Information about treatment involving exposure of plants to varying levels of ph of the growth media, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple regimen" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

