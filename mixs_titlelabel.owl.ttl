    schema1:keywords "extreme",
        "method",
        "properties",
        "saturation",
        "unusual" ;
    ns1:hasExactSynonym "al_sat_meth" ;
    rdfs:range xsd:string ;
    skos:definition "Reference or method used in determining Al saturation" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:amniotic_fluid_color a owl:DatatypeProperty ;
