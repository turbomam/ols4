MIXS:primary_treatment a owl:DatatypeProperty ;
    rdfs:label "primary treatment" ;
    dcterms:title "primary treatment" ;
    schema1:keywords "primary",
        "treatment" ;
    ns1:hasExactSynonym "primary_treatment" ;
