    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, parts per million" .

MIXS:vfa_fw a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vfa in formation water" ;
    dcterms:title "vfa in formation water" ;
    schema1:keywords "water" ;
    ns1:hasExactSynonym "vfa_fw" ;
