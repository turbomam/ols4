MIXS:biomass a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "biomass" ;
    dcterms:title "biomass" ;
    schema1:keywords "biomass" ;
    rdfs:comment "Amount of biomass; should include the name for the part of biomass measured, e.g. Microbial, total. Can include multiple measurements" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "biomass type;measurement value" ;
    MIXS:Preferred_unit "ton, kilogram, gram" .

MIXS:cult_result_org a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "culture result organism" ;
    dcterms:title "culture result organism" ;
    schema1:keywords "culture",
        "organism" ;
    ns1:hasExactSynonym "cult_result_org" ;
    rdfs:comment "Taxonomic information about the cultured organism(s)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:cult_target a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "culture target microbial analyte" ;
    dcterms:title "culture target microbial analyte" ;
    schema1:keywords "culture",
        "microbial",
        "target" ;
    ns1:hasExactSynonym "cult_target" ;
    rdfs:comment "The target microbial analyte in terms of investigation scope. This field accepts terms under organism (http://purl.obolibrary.org/obo/NCIT_C14250). This field also accepts identification numbers from NCBI under https://www.ncbi.nlm.nih.gov/taxonomy" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "NCIT:C14250 or NCBI taxid or culture independent" .

MIXS:diether_lipids a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diether lipids" ;
    dcterms:title "diether lipids" ;
    ns1:hasExactSynonym "diether_lipids" ;
    rdfs:comment "Concentration of diether lipids; can include multiple types of diether lipids" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "diether lipid name;measurement value" ;
    MIXS:Preferred_unit "nanogram per liter" .

MIXS:food_contact_surf a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food contact surface" ;
    dcterms:title "food contact surface" ;
    schema1:keywords "food",
        "surface" ;
    ns1:hasExactSynonym "food_contact_surf" ;
    rdfs:comment "The specific container or coating materials in direct contact with the food. Multiple values can be assigned.  This field accepts terms listed under food contact surface (http://purl.obolibrary.org/obo/FOODON_03500010)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03500010" .

MIXS:food_pack_medium a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food packing medium" ;
    dcterms:title "food packing medium" ;
    schema1:keywords "food" ;
    ns1:hasExactSynonym "food_pack_medium" ;
    rdfs:comment "The medium in which the food is packed for preservation and handling or the medium surrounding homemade foods, e.g., peaches cooked in sugar syrup. The packing medium may provide a controlled environment for the food. It may also serve to improve palatability and consumer appeal.  This includes edible packing media (e.g. fruit juice), gas other than air (e.g. carbon dioxide), vacuum packed, or packed with aerosol propellant. This field accepts terms under food packing medium (http://purl.obolibrary.org/obo/FOODON_03480020). Multiple terms may apply and can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03480020" .

MIXS:food_preserv_proc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food preservation process" ;
    dcterms:title "food preservation process" ;
    schema1:keywords "food",
        "process" ;
    ns1:hasExactSynonym "food_preserv_proc" ;
    rdfs:comment "The methods contributing to the prevention or retardation of microbial, enzymatic or oxidative spoilage and thus to the extension of shelf life. This field accepts terms listed under food preservation process (http://purl.obolibrary.org/obo/FOODON_03470107)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03470107" .

MIXS:food_prod a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food production system characteristics" ;
    dcterms:title "food production system characteristics" ;
    schema1:keywords "food",
        "production" ;
    ns1:hasExactSynonym "food_prod" ;
    rdfs:comment "Descriptors of the food production system or of the agricultural environment and growing conditions related to the farm production system, such as wild caught, organic, free-range, industrial, dairy, beef,  domestic or cultivated food production. This field accepts terms listed under food production (http://purl.obolibrary.org/obo/FOODON_03530206). Multiple terms may apply and can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_treat_proc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food treatment process" ;
    dcterms:title "food treatment process" ;
    schema1:keywords "food",
        "process",
        "treatment" ;
    ns1:hasExactSynonym "food_treat_proc" ;
    rdfs:comment "Used to specifically characterize a food product based on the treatment or processes applied to the product or any indexed ingredient. The processes include adding, substituting or removing components or modifying the food or component, e.g., through fermentation. Multiple values can be assigned. This fields accepts terms listed under food treatment process (http://purl.obolibrary.org/obo/FOODON_03460111)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03460111" .

MIXS:host_subspecf_genlin a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host subspecific genetic lineage" ;
    dcterms:title "host subspecific genetic lineage" ;
    schema1:keywords "host",
        "host.",
        "lineage" ;
    ns1:hasExactSynonym "host_subspecf_genlin" ;
    rdfs:comment "Information about the genetic distinctness of the host organism below the subspecies level e.g., serovar, serotype, biotype, ecotype, variety, cultivar, or any relevant genetic typing schemes like Group I plasmid. Subspecies should not be recorded in this term, but in the NCBI taxonomy. Supply both the lineage name and the lineage rank separated by a colon, e.g., biovar:abc123" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "Genetic lineage below lowest rank of NCBI taxonomy, which is subspecies, e.g. serovar, biotype, ecotype, variety, cultivar" .

MIXS:intended_consumer a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "intended consumer" ;
    dcterms:title "intended consumer" ;
    schema1:keywords "consumer" ;
    ns1:hasExactSynonym "intended_consumer" ;
    rdfs:comment "Food consumer type, human or animal, for which the food product is produced and marketed. This field accepts terms listed under food consumer group (http://purl.obolibrary.org/obo/FOODON_03510136) or NCBI taxid" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON_03510136 or NCBI taxid" .

MIXS:part_plant_animal a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "part of plant or animal" ;
    dcterms:title "part of plant or animal" ;
    schema1:keywords "animal",
        "plant" ;
    ns1:hasExactSynonym "part_plant_animal" ;
    rdfs:comment "The anatomical part of the organism being involved in food production or consumption; e.g., a carrot is the root of the plant (root vegetable). This field accepts terms listed under part of plant or animal (http://purl.obolibrary.org/obo/FOODON_03420116)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03420116" .

MIXS:phosplipid_fatt_acid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "phospholipid fatty acid" ;
    dcterms:title "phospholipid fatty acid" ;
    ns1:hasExactSynonym "phosplipid_fatt_acid" ;
    rdfs:comment "Concentration of phospholipid fatty acids; can include multiple values" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "phospholipid fatty acid name;measurement value" .

MIXS:repository_name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "repository name" ;
    dcterms:title "repository name" ;
    ns1:hasExactSynonym "repository_name" ;
    rdfs:comment "The name of the institution where the sample or DNA extract is held or \"sample not available\" if the sample was used in its entirety for analysis or otherwise not retained" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "Institution" .

MIXS:spikein_strain a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spike-in microbial strain" ;
    dcterms:title "spike-in microbial strain" ;
    schema1:keywords "microbial",
        "spike" ;
    ns1:hasExactSynonym "spikein_strain" ;
    rdfs:comment "Taxonomic information about the spike-in organism(s) at the strain level. This field accepts terms under organism (http://purl.obolibrary.org/obo/NCIT_C14250). This field also accepts identification numbers from NCBI under https://www.ncbi.nlm.nih.gov/taxonomy. Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "NCIT:C14250 or NCBI taxid or text" .

MIXS:SeqQualityCheckEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "seq quality check" ;
    ns1:hasExactSynonym "SeqQualityCheckEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/SeqQualityCheckEnum#manually%20edited> <https://w3id.org/mixs/SeqQualityCheckEnum#none> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/SeqQualityCheckEnum#manually%20edited>,
        <https://w3id.org/mixs/SeqQualityCheckEnum#none> .

MIXS:alkalinity_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alkalinity method" ;
    dcterms:title "alkalinity method" ;
    schema1:keywords "alkalinity",
        "method" ;
    ns1:hasExactSynonym "alkalinity_method" ;
    rdfs:comment "Method used for alkalinity measurement" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:alkyl_diethers a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alkyl diethers" ;
    dcterms:title "alkyl diethers" ;
    ns1:hasExactSynonym "alkyl_diethers" ;
    rdfs:comment "Concentration of alkyl diethers" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:aminopept_act a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aminopeptidase activity" ;
    dcterms:title "aminopeptidase activity" ;
    ns1:hasExactSynonym "aminopept_act" ;
    rdfs:comment "Measurement of aminopeptidase activity" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "mole per liter per hour" .

MIXS:bacteria_carb_prod a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bacterial carbon production" ;
    dcterms:title "bacterial carbon production" ;
    schema1:keywords "carbon",
        "production" ;
    ns1:hasExactSynonym "bacteria_carb_prod" ;
    rdfs:comment "Measurement of bacterial carbon production" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:bacterial_density a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bacteria density" ;
    dcterms:title "bacteria density" ;
    schema1:keywords "density" ;
    ns1:hasExactSynonym "bacterial_density" ;
    rdfs:comment "Number of bacteria in sample, as defined by bacteria density (http://purl.obolibrary.org/obo/GENEPIO_0000043)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "colony forming units per milliliter; colony forming units per gram of dry weight" .

MIXS:bishomohopanol a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bishomohopanol" ;
    dcterms:title "bishomohopanol" ;
    rdfs:comment "Concentration of bishomohopanol" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "microgram per liter, microgram per gram" .

MIXS:carb_nitro_ratio a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "carbon/nitrogen ratio" ;
    dcterms:title "carbon/nitrogen ratio" ;
    schema1:keywords "carbon",
        "nitrogen",
        "ratio" ;
    ns1:hasExactSynonym "carb_nitro_ratio" ;
    rdfs:comment "Ratio of amount or concentrations of carbon to nitrogen" ;
    rdfs:range linkml:Float ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value" .

MIXS:coll_site_geo_feat a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "collection site geographic feature" ;
    dcterms:title "collection site geographic feature" ;
    schema1:keywords "feature",
        "geographic",
        "site" ;
    ns1:hasExactSynonym "coll_site_geo_feat" ;
    rdfs:comment "Text or terms that describe the geographic feature where the food sample was obtained by the researcher. This field accepts selected terms listed under the following ontologies: anthropogenic geographic feature (http://purl.obolibrary.org/obo/ENVO_00000002), for example agricultural fairground [ENVO:01000986]; garden [ENVO:00000011} or any of its subclasses; market [ENVO:01000987]; water well [ENVO:01000002]; or human construction (http://purl.obolibrary.org/obo/ENVO_00000070)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "ENVO:00000002 or ENVO:00000070" .

MIXS:compl_appr a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "completeness approach" ;
    dcterms:title "completeness approach" ;
    ns1:hasExactSynonym "compl_appr" ;
    rdfs:comment "The approach used to determine the completeness of a given genomic assembly, which would typically make use of a set of conserved marker genes or a closely related reference genome. For UViG completeness, include reference genome or group used, and contig feature suggesting a complete genome" ;
    rdfs:range MIXS:ComplApprEnum ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "text" .

MIXS:crop_rotation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "history/crop rotation" ;
    dcterms:title "history/crop rotation" ;
    schema1:keywords "history" ;
    ns1:hasExactSynonym "crop_rotation" ;
    rdfs:comment "Whether or not crop is rotated, and if yes, rotation schedule" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "crop rotation status;schedule" .

MIXS:diss_inorg_phosp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dissolved inorganic phosphorus" ;
    dcterms:title "dissolved inorganic phosphorus" ;
    schema1:keywords "dissolved",
        "inorganic",
        "phosphorus" ;
    ns1:hasExactSynonym "diss_inorg_phosp" ;
    rdfs:comment "Concentration of dissolved inorganic phosphorus in the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:encoded_traits a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "encoded traits" ;
    dcterms:title "encoded traits" ;
    ns1:hasExactSynonym "encoded_traits" ;
    rdfs:comment "Should include key traits like antibiotic resistance or xenobiotic degradation phenotypes for plasmids, converting genes for phage" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "for plasmid: antibiotic resistance; for phage: converting genes" .

MIXS:food_origin a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food product origin geographic location" ;
    dcterms:title "food product origin geographic location" ;
    schema1:keywords "food",
        "geographic",
        "location",
        "product" ;
    ns1:hasExactSynonym "food_origin" ;
    rdfs:comment "A reference to a place on the Earth, by its name or by its geographical location that describes the origin of the food commodity, either in terms of its cultivation or production. This field accepts terms listed under geographic location (http://purl.obolibrary.org/obo/GAZ_00000448)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_pack_capacity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food package capacity" ;
    dcterms:title "food package capacity" ;
    schema1:keywords "food",
        "package" ;
    ns1:hasExactSynonym "food_pack_capacity" ;
    rdfs:comment "The maximum number of product units within a package" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "grams" .

MIXS:food_product_qual a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food product by quality" ;
    dcterms:title "food product by quality" ;
    schema1:keywords "food",
        "product",
        "quality" ;
    ns1:hasExactSynonym "food_product_qual" ;
    rdfs:comment "Descriptors for describing food visually or via other senses, which is useful for tasks like food inspection where little prior knowledge of how the food came to be is available. Some terms like \"food (frozen)\" are both a quality descriptor and the output of a process. This field accepts terms listed under food product by quality (http://purl.obolibrary.org/obo/FOODON_00002454)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_trace_list a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food traceability list category" ;
    dcterms:title "food traceability list category" ;
    schema1:keywords "food" ;
    ns1:hasExactSynonym "food_trace_list" ;
    rdfs:comment "The FDA is proposing to establish additional traceability recordkeeping requirements (beyond what is already required in existing regulations) for persons who manufacture, process, pack, or hold foods the Agency has designated for inclusion on the Food Traceability List. The Food Traceability List (FTL) identifies the foods for which the additional traceability records described in the proposed rule would be required. The term  Food Traceability List  (FTL) refers not only to the foods specifically listed (https://www.fda.gov/media/142303/download), but also to any foods that contain listed foods as ingredients" ;
    rdfs:range MIXS:FoodTraceListEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:glucosidase_act a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "glucosidase activity" ;
    dcterms:title "glucosidase activity" ;
    ns1:hasExactSynonym "glucosidase_act" ;
    rdfs:comment "Measurement of glucosidase activity" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "mol per liter per hour" .

MIXS:humidity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "humidity" ;
    dcterms:title "humidity" ;
    schema1:keywords "humidity" ;
    rdfs:comment "Amount of water vapour in the air, at the time of sampling" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:mean_frict_vel a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mean friction velocity" ;
    dcterms:title "mean friction velocity" ;
    schema1:keywords "mean",
        "velocity" ;
    ns1:hasExactSynonym "mean_frict_vel" ;
    rdfs:comment "Measurement of mean friction velocity" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "meter per second" .

MIXS:mean_peak_frict_vel a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mean peak friction velocity" ;
    dcterms:title "mean peak friction velocity" ;
    schema1:keywords "mean",
        "peak",
        "velocity" ;
    ns1:hasExactSynonym "mean_peak_frict_vel" ;
    rdfs:comment "Measurement of mean peak friction velocity" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "meter per second" .

MIXS:methane a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "methane" ;
    dcterms:title "methane" ;
    rdfs:comment "Methane (gas) amount or concentration at the time of sampling" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, parts per billion, parts per million" .

MIXS:microb_cult_med a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "microbiological culture medium" ;
    dcterms:title "microbiological culture medium" ;
    schema1:keywords "culture",
        "microbiological" ;
    ns1:hasExactSynonym "microb_cult_med" ;
    rdfs:comment "A culture medium used to select for, grow, and maintain prokaryotic microorganisms. Can be in either liquid (broth) or solidified (e.g. with agar) forms. This field accepts terms listed under microbiological culture medium (http://purl.obolibrary.org/obo/MICRO_0000067). If the proper descriptor is not listed please use text to describe the culture medium" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:num_replicons a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "number of replicons" ;
    dcterms:title "number of replicons" ;
    schema1:keywords "number" ;
    ns1:hasExactSynonym "num_replicons" ;
    rdfs:comment "Reports the number of replicons in a nuclear genome of eukaryotes, in the genome of a bacterium or archaea or the number of segments in a segmented virus. Always applied to the haploid chromosome count of a eukaryote" ;
    rdfs:range linkml:Integer ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "for eukaryotes and bacteria: chromosomes (haploid count); for viruses: segments" .

MIXS:part_org_carb a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "particulate organic carbon" ;
    dcterms:title "particulate organic carbon" ;
    schema1:keywords "carbon",
        "organic",
        "particle",
        "particulate" ;
    ns1:hasExactSynonym "part_org_carb" ;
    rdfs:comment "Concentration of particulate organic carbon" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:petroleum_hydrocarb a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "petroleum hydrocarbon" ;
    dcterms:title "petroleum hydrocarbon" ;
    schema1:keywords "hydrocarbon",
        "petroleum" ;
    ns1:hasExactSynonym "petroleum_hydrocarb" ;
    rdfs:comment "Concentration of petroleum hydrocarbon" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter" .

MIXS:ph_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pH method" ;
    dcterms:title "pH method" ;
    schema1:keywords "method",
        "ph" ;
    ns1:hasExactSynonym "ph_meth" ;
    rdfs:comment "Reference or method used in determining pH" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:plant_growth_med a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "plant growth medium" ;
    dcterms:title "plant growth medium" ;
    schema1:keywords "growth",
        "plant" ;
    ns1:hasExactSynonym "plant_growth_med" ;
    rdfs:comment "Specification of the media for growing the plants or tissue cultured samples, e.g. soil, aeroponic, hydroponic, in vitro solid culture medium, in vitro liquid culture medium. Recommended value is a specific value from EO:plant growth medium (follow this link for terms http://purl.obolibrary.org/obo/EO_0007147) or other controlled vocabulary" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "EO or enumeration" .

MIXS:porosity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "porosity" ;
    dcterms:title "porosity" ;
    schema1:keywords "porosity" ;
    rdfs:comment "Porosity of deposited sediment is volume of voids divided by the total volume of sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value or range" ;
    MIXS:Preferred_unit "percentage" .

MIXS:previous_land_use a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "history/previous land use" ;
    dcterms:title "history/previous land use" ;
    schema1:keywords "history",
        "land",
        "use" ;
    ns1:hasExactSynonym "previous_land_use" ;
    rdfs:comment "Previous land use and dates" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "land use name;date" .

MIXS:propagation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "propagation" ;
    dcterms:title "propagation" ;
    rdfs:comment "The type of reproduction from the parent stock. Values for this field is specific to different taxa. For phage or virus: lytic/lysogenic/temperate/obligately lytic. For plasmids: incompatibility group. For eukaryotes: sexual/asexual" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "for virus: lytic, lysogenic, temperate, obligately lytic; for plasmid: incompatibility group; for eukaryote: asexual, sexual; other more specific values (e.g., incompatibility group) are allowed" .

MIXS:redox_potential a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "redox potential" ;
    dcterms:title "redox potential" ;
    ns1:hasExactSynonym "redox_potential" ;
    rdfs:comment "Redox potential, measured relative to a hydrogen cell, indicating oxidation or reduction potential" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "millivolt" .

MIXS:root_med_carbon a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rooting medium carbon" ;
    dcterms:title "rooting medium carbon" ;
    schema1:keywords "carbon" ;
    ns1:hasExactSynonym "root_med_carbon" ;
    rdfs:comment "Source of organic carbon in the culture rooting medium; e.g. sucrose" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "carbon source name;measurement value" ;
    MIXS:Preferred_unit "milligram per liter" .

MIXS:root_med_macronutr a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rooting medium macronutrients" ;
    dcterms:title "rooting medium macronutrients" ;
    schema1:keywords "macronutrients" ;
    ns1:hasExactSynonym "root_med_macronutr" ;
    rdfs:comment "Measurement of the culture rooting medium macronutrients (N,P, K, Ca, Mg, S); e.g. KH2PO4 (170 mg/L)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "macronutrient name;measurement value" ;
    MIXS:Preferred_unit "milligram per liter" .

MIXS:root_med_ph a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rooting medium pH" ;
    dcterms:title "rooting medium pH" ;
    schema1:keywords "ph" ;
    ns1:hasExactSynonym "root_med_ph" ;
    rdfs:comment "pH measurement of the culture rooting medium; e.g. 5.5" ;
    rdfs:range linkml:Float ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_rep_biol a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "biological sample replicate" ;
    dcterms:title "biological sample replicate" ;
    schema1:keywords "sample" ;
    ns1:hasExactSynonym "samp_rep_biol" ;
    rdfs:comment "Measurements of biologically distinct samples that show biological variation" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_rep_tech a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "technical sample replicate" ;
    dcterms:title "technical sample replicate" ;
    schema1:keywords "sample" ;
    ns1:hasExactSynonym "samp_rep_tech" ;
    rdfs:comment "Repeated measurements of the same sample that show independent measures of the noise associated with the equipment and the protocols" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_stor_device a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample storage device" ;
    dcterms:title "sample storage device" ;
    schema1:keywords "device",
        "sample",
        "storage" ;
    ns1:hasExactSynonym "samp_stor_device" ;
    rdfs:comment "The container used to store the  sample. This field accepts terms listed under container (http://purl.obolibrary.org/obo/NCIT_C43186). If the proper descriptor is not listed please use text to describe the storage device" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "NCIT:C4318" .

MIXS:samp_stor_media a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample storage media" ;
    dcterms:title "sample storage media" ;
    schema1:keywords "sample",
        "storage" ;
    ns1:hasExactSynonym "samp_stor_media" ;
    rdfs:comment "The liquid that is added to the sample collection device prior to sampling. If the sample is pre-hydrated, indicate the liquid media the sample is pre-hydrated with for storage purposes. This field accepts terms listed under microbiological culture medium (http://purl.obolibrary.org/obo/MICRO_0000067). If the proper descriptor is not listed please use text to describe the sample storage media" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_transport_cont a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample transport container" ;
    dcterms:title "sample transport container" ;
    schema1:keywords "sample",
        "transport" ;
    ns1:hasExactSynonym "samp_transport_cont" ;
    rdfs:comment "Container in which the sample was stored during transport. Indicate the location name" ;
    rdfs:range MIXS:SampTransportContEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_transport_dur a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample transport duration" ;
    dcterms:title "sample transport duration" ;
    schema1:keywords "duration",
        "period",
        "sample",
        "transport" ;
    ns1:hasExactSynonym "samp_transport_dur" ;
    rdfs:comment "The duration of time from when the sample was collected until processed. Indicate the duration for which the sample was stored written in ISO 8601 format" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "days" .

MIXS:samp_transport_temp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample transport temperature" ;
    dcterms:title "sample transport temperature" ;
    schema1:keywords "sample",
        "temperature",
        "transport" ;
    ns1:hasExactSynonym "samp_transport_temp" ;
    rdfs:comment "Temperature at which sample was transported, e.g. -20 or 4 degree Celsius" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "text or measurement value" ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:season a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "season" ;
    dcterms:title "season" ;
    schema1:keywords "season" ;
    rdfs:comment "The season when sampling occurred. Any of the four periods into which the year is divided by the equinoxes and solstices. This field accepts terms listed under season (http://purl.obolibrary.org/obo/NCIT_C94729)" ;
    rdfs:range MIXS:SeasonEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:season_precpt a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mean seasonal precipitation" ;
    dcterms:title "mean seasonal precipitation" ;
    schema1:keywords "mean",
        "season" ;
    ns1:hasExactSynonym "season_precpt" ;
    rdfs:comment "The average of all seasonal precipitation values known, or an estimated equivalent value derived by such methods as regional indexes or Isohyetal maps" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "millimeter" .

MIXS:season_temp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mean seasonal temperature" ;
    dcterms:title "mean seasonal temperature" ;
    schema1:keywords "mean",
        "season",
        "temperature" ;
    ns1:hasExactSynonym "season_temp" ;
    rdfs:comment "Mean seasonal temperature" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:size_frac_low a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "size-fraction lower threshold" ;
    dcterms:title "size-fraction lower threshold" ;
    schema1:keywords "lower" ;
    ns1:hasExactSynonym "size_frac_low" ;
    rdfs:comment "Refers to the mesh/pore size used to pre-filter/pre-sort the sample. Materials smaller than the size threshold are excluded from the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micrometer" .

MIXS:size_frac_up a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "size-fraction upper threshold" ;
    dcterms:title "size-fraction upper threshold" ;
    schema1:keywords "upper" ;
    ns1:hasExactSynonym "size_frac_up" ;
    rdfs:comment "Mesh or pore size of the device used to retain the sample. Materials larger than the size threshold are excluded from the sample." ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micrometer" .

MIXS:soil_texture_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil texture method" ;
    dcterms:title "soil texture method" ;
    schema1:keywords "method",
        "soil",
        "texture" ;
