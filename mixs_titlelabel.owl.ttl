    dcterms:title "food animal antimicrobial intended use" ;
    schema1:keywords "animal",
        "antimicrobial",
        "food",
        "use" ;
    ns1:hasExactSynonym "animal_am_use" ;
    rdfs:range xsd:string ;
    skos:definition "The prescribed intended use of or the condition treated by the antimicrobial given to the food animal by any route of administration" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:animal_body_cond a owl:ObjectProperty ;
    rdfs:label "food animal body condition" ;
    dcterms:title "food animal body condition" ;
    schema1:keywords "animal",
        "body",
        "condition",
        "food" ;
    ns1:hasExactSynonym "animal_body_cond" ;
