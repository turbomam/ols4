    schema1:keywords "growth" ;
    ns1:hasExactSynonym "growth_medium" ;
    rdfs:comment "A liquid or gel containing nutrients, salts, and other factors formulated to support the growth of microorganisms, cells, or plants (National Cancer Institute Thesaurus).  The name of the medium used to grow the microorganism" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

