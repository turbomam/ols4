MIXS:room_net_area a owl:DatatypeProperty ;
    rdfs:label "room net area" ;
    dcterms:title "room net area" ;
    schema1:keywords "area",
        "room" ;
    ns1:hasExactSynonym "room_net_area" ;
    rdfs:range xsd:string ;
    skos:definition "The net floor area of sampling room. Net area excludes wall thicknesses" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "square feet, square meter" .

MIXS:room_occup a owl:DatatypeProperty ;
    rdfs:label "room occupancy" ;
    dcterms:title "room occupancy" ;
    schema1:keywords "room" ;
    ns1:hasExactSynonym "room_occup" ;
    rdfs:range xsd:string ;
    skos:definition "Count of room occupancy at time of sampling" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:room_samp_pos a owl:ObjectProperty ;
