MIXS:agriculture_data a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "Agriculture data" ;
    dcterms:title "Agriculture data" ;
    ns1:hasExactSynonym "agriculture_data" ;
    rdfs:comment "Data that comply with Extension Agriculture" ;
    rdfs:domain MIXS:MixsCompliantData ;
    rdfs:range MIXS:Agriculture ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:air_data a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "Air data" ;
    dcterms:title "Air data" ;
    schema1:keywords "air" ;
    ns1:hasExactSynonym "air_data" ;
    rdfs:comment "Data that comply with Extension Air" ;
    rdfs:domain MIXS:MixsCompliantData ;
    rdfs:range MIXS:Air ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:air_flow_impede a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "local air flow impediments" ;
    dcterms:title "local air flow impediments" ;
    schema1:keywords "air" ;
    ns1:hasExactSynonym "air_flow_impede" ;
    rdfs:comment "Presence of objects in the area that would influence or impede air flow through the air filter" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration;obstruction type; distance from sampling device" .

MIXS:air_temp_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "air temperature regimen" ;
    dcterms:title "air temperature regimen" ;
    schema1:keywords "air",
        "regimen",
        "temperature" ;
    ns1:hasExactSynonym "air_temp_regm" ;
    rdfs:comment "Information about treatment involving an exposure to varying temperatures; should include the temperature, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include different temperature regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "temperature value;treatment interval and duration" ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:animal_intrusion a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "animal intrusion near sample source" ;
    dcterms:title "animal intrusion near sample source" ;
    schema1:keywords "animal",
        "sample",
        "source" ;
    ns1:hasExactSynonym "animal_intrusion" ;
    rdfs:comment "Identification of animals intruding on the sample or sample site including invertebrates (such as pests or pollinators) and vertebrates (such as wildlife or domesticated animals). This field accepts terms under organism (http://purl.obolibrary.org/obo/NCIT_C14250). This field also accepts identification numbers from NCBI under https://www.ncbi.nlm.nih.gov/taxonomy. Multiple terms can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:antibiotic_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "antibiotic regimen" ;
    dcterms:title "antibiotic regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "antibiotic_regm" ;
    rdfs:comment "Information about treatment involving antibiotic administration; should include the name of antibiotic, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple antibiotic regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "antibiotic name;antibiotic amount;treatment interval and duration" ;
    MIXS:Preferred_unit "milligram" .

MIXS:atmospheric_data a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "atmospheric data" ;
    dcterms:title "atmospheric data" ;
    ns1:hasExactSynonym "atmospheric_data" ;
    rdfs:comment "Measurement of atmospheric data; can include multiple data" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "atmospheric data name;measurement value" .

MIXS:biocide_used a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "biocide" ;
    dcterms:title "biocide" ;
    ns1:hasExactSynonym "biocide_used" ;
    rdfs:comment "Substance intended for preventing, neutralizing, destroying, repelling, or mitigating the effects of any pest or microorganism; that inhibits the growth, reproduction, and activity of organisms, including fungal cells; decreases the number of fungi or pests present; deters microbial growth and degradation of other ingredients in the formulation. Indicate the biocide used on the location where the sample was taken. Multiple terms can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "commercial name of biocide, active ingredient in biocide or class of biocide" .

MIXS:blood_blood_disord a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "blood/blood disorder" ;
    dcterms:title "blood/blood disorder" ;
    schema1:keywords "disorder" ;
    ns1:hasExactSynonym "blood_blood_disord" ;
    rdfs:comment "History of blood disorders; can include multiple disorders.  The terms should be chosen from the DO (Human Disease Ontology) at http://www.disease-ontology.org, hematopoietic system disease (https://disease-ontology.org/?id=DOID:74)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:build_occup_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
