MIXS:env_broad_scale a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "broad-scale environmental context" ;
    dcterms:title "broad-scale environmental context" ;
    schema1:keywords "context",
        "environmental" ;
    ns1:hasExactSynonym "env_broad_scale" ;
    rdfs:comment "Report the major environmental system the sample or specimen came from. The system(s) identified should have a coarse spatial grain, to provide the general environmental context of where the sampling was done (e.g. in the desert or a rainforest). We recommend using subclasses of EnvO s biome class:  http://purl.obolibrary.org/obo/ENVO_00000428. EnvO documentation about how to use the field: https://github.com/EnvironmentOntology/envo/wiki/Using-ENVO-with-MIxS" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:env_local_scale a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "local environmental context" ;
    dcterms:title "local environmental context" ;
    schema1:keywords "context",
        "environmental" ;
    ns1:hasExactSynonym "env_local_scale" ;
    rdfs:comment "Report the entity or entities which are in the sample or specimen s local vicinity and which you believe have significant causal influences on your sample or specimen. We recommend using EnvO terms which are of smaller spatial grain than your entry for env_broad_scale. Terms, such as anatomical sites, from other OBO Library ontologies which interoperate with EnvO (e.g. UBERON) are accepted in this field. EnvO documentation about how to use the field: https://github.com/EnvironmentOntology/envo/wiki/Using-ENVO-with-MIxS" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "Environmental entities having causal influences upon the entity at time of sampling" .

MIXS:env_medium a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "environmental medium" ;
    dcterms:title "environmental medium" ;
    schema1:keywords "environmental" ;
    ns1:hasExactSynonym "env_medium" ;
    rdfs:comment "Report the environmental material(s) immediately surrounding the sample or specimen at the time of sampling. We recommend using subclasses of 'environmental material' (http://purl.obolibrary.org/obo/ENVO_00010483). EnvO documentation about how to use the field: https://github.com/EnvironmentOntology/envo/wiki/Using-ENVO-with-MIxS . Terms from other OBO ontologies are permissible as long as they reference mass/volume nouns (e.g. air, water, blood) and not discrete, countable entities (e.g. a tree, a leaf, a table top)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_disease_stat a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host disease status" ;
    dcterms:title "host disease status" ;
    schema1:keywords "disease",
        "host",
        "host.",
        "status" ;
    ns1:hasExactSynonym "host_disease_stat" ;
    rdfs:comment "List of diseases with which the host has been diagnosed; can include multiple diagnoses. The value of the field depends on host; for humans the terms should be chosen from the DO (Human Disease Ontology) at https://www.disease-ontology.org, non-human host diseases are free text" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "disease name or Disease Ontology term" .

MIXS:neg_cont_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "negative control type" ;
    dcterms:title "negative control type" ;
    schema1:keywords "type" ;
    ns1:hasExactSynonym "neg_cont_type" ;
    rdfs:comment "The substance or equipment used as a negative control in an investigation" ;
    rdfs:range MIXS:NegContTypeEnum ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration or text" .

MIXS:pos_cont_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "positive control type" ;
    dcterms:title "positive control type" ;
    schema1:keywords "type" ;
    ns1:hasExactSynonym "pos_cont_type" ;
    rdfs:comment "The substance, mixture, product, or apparatus used to verify that a process which is part of an investigation delivers a true positive" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_taxon_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxonomy ID of DNA sample" ;
    dcterms:title "taxonomy ID of DNA sample" ;
    schema1:keywords "dna",
        "identifier",
        "sample",
        "taxon" ;
    ns1:hasExactSynonym "samp_taxon_id" ;
    rdfs:comment "NCBI taxon id of the sample.  Maybe be a single taxon or mixed taxa sample. Use 'synthetic metagenome  for mock community/positive controls, or 'blank sample' for negative controls" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

