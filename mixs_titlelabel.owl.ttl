MIXS:animal_am_freq a owl:DatatypeProperty ;
    rdfs:label "food animal antimicrobial frequency" ;
    dcterms:title "food animal antimicrobial frequency" ;
    schema1:keywords "animal",
        "antimicrobial",
        "food",
        "frequency" ;
    ns1:hasExactSynonym "animal_am_freq" ;
