    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:avg_temp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "average temperature" ;
    dcterms:title "average temperature" ;
    schema1:keywords "average",
        "temperature" ;
    ns1:hasExactSynonym "avg_temp" ;
