    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "soluble organic material name;measurement value" ;
    MIXS:Preferred_unit "gram, microgram, mole per liter, gram per liter, parts per million" .

MIXS:spec_intended_cons a owl:DatatypeProperty ;
    rdfs:label "specific intended consumer" ;
    dcterms:title "specific intended consumer" ;
    schema1:keywords "consumer" ;
    ns1:hasExactSynonym "spec_intended_cons" ;
    rdfs:range xsd:string ;
