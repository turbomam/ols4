MIXS:soil_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soil type" ;
    dcterms:title "soil type" ;
    schema1:keywords "soil",
        "type" ;
    ns1:hasExactSynonym "soil_type" ;
    rdfs:comment "Description of the soil type or classification. This field accepts terms under soil (http://purl.obolibrary.org/obo/ENVO_00001998).  Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "ENVO:00001998" .

MIXS:soil_type_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
