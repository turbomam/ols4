MIXS:abs_air_humidity a owl:DatatypeProperty ;
    rdfs:label "absolute air humidity" ;
    dcterms:title "absolute air humidity" ;
    schema1:keywords "absolute",
        "air",
        "humidity" ;
    ns1:hasExactSynonym "abs_air_humidity" ;
