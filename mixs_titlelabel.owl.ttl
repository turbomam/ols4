    MIXS:use_cases "the microbiome sequence of a flea sampled from a farm animal" .

MIXS:VirusEnrichApprEnum a owl:Class ;
    rdfs:label "VirusEnrichApprEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/VirusEnrichApprEnum#CsCl%20density%20gradient> <https://w3id.org/mixs/VirusEnrichApprEnum#DNAse> <https://w3id.org/mixs/VirusEnrichApprEnum#FeCl%20Precipitation> <https://w3id.org/mixs/VirusEnrichApprEnum#PEG%20Precipitation> <https://w3id.org/mixs/VirusEnrichApprEnum#RNAse> <https://w3id.org/mixs/VirusEnrichApprEnum#centrifugation> <https://w3id.org/mixs/VirusEnrichApprEnum#filtration> <https://w3id.org/mixs/VirusEnrichApprEnum#none> <https://w3id.org/mixs/VirusEnrichApprEnum#other> <https://w3id.org/mixs/VirusEnrichApprEnum#targeted%20sequence%20capture> <https://w3id.org/mixs/VirusEnrichApprEnum#ultracentrifugation> <https://w3id.org/mixs/VirusEnrichApprEnum#ultrafiltration> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/VirusEnrichApprEnum#CsCl%20density%20gradient>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#DNAse>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#FeCl%20Precipitation>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#PEG%20Precipitation>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#RNAse>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#centrifugation>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#filtration>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#none>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#other>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#targeted%20sequence%20capture>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#ultracentrifugation>,
        <https://w3id.org/mixs/VirusEnrichApprEnum#ultrafiltration> .

