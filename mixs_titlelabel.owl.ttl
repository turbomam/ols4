    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03530050" .

MIXS:plant_sex a owl:ObjectProperty ;
    rdfs:label "plant sex" ;
    dcterms:title "plant sex" ;
    schema1:keywords "plant" ;
    ns1:hasExactSynonym "plant_sex" ;
