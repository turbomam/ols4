    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value range" ;
    MIXS:Preferred_unit "mD" .

MIXS:photon_flux a owl:DatatypeProperty ;
    rdfs:label "photon flux" ;
    dcterms:title "photon flux" ;
    ns1:hasExactSynonym "photon_flux" ;
    rdfs:range xsd:string ;
    skos:definition "Measurement of photon flux" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "number of photons per second per unit area" .

MIXS:photosynt_activ a owl:DatatypeProperty ;
    rdfs:label "photosynthetic activity" ;
    dcterms:title "photosynthetic activity" ;
    ns1:hasExactSynonym "photosynt_activ" ;
    rdfs:range xsd:string ;
