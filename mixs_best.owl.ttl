    dcterms:title "water source shared" ;
    schema1:keywords "source",
        "water" ;
    ns1:hasExactSynonym "water_source_shared" ;
    rdfs:comment "Other users sharing access to the same water source. Multiple terms can be separated by one or more pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration" .

MIXS:water_temp_regm a owl:ObjectProperty,
