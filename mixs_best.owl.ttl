    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "millimeter" .

MIXS:annual_temp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mean annual temperature" ;
    dcterms:title "mean annual temperature" ;
    schema1:keywords "mean",
        "temperature" ;
    ns1:hasExactSynonym "annual_temp" ;
