MIXS:soil_porosity a owl:DatatypeProperty ;
    rdfs:label "soil sediment porosity" ;
    dcterms:title "soil sediment porosity" ;
    schema1:keywords "porosity",
        "sediment",
        "soil" ;
    ns1:hasExactSynonym "soil_porosity" ;
