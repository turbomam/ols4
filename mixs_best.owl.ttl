    dcterms:title "binning parameters" ;
    schema1:keywords "parameter" ;
    ns1:hasExactSynonym "bin_param" ;
    rdfs:comment "The parameters that have been applied during the extraction of genomes from metagenomic datasets" ;
    rdfs:range MIXS:BinParamEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:bin_software a owl:ObjectProperty,
