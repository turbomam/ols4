MIXS:plant_part_maturity a owl:DatatypeProperty ;
    rdfs:label "degree of plant part maturity" ;
    dcterms:title "degree of plant part maturity" ;
    schema1:keywords "degree",
        "plant" ;
    ns1:hasExactSynonym "plant_part_maturity" ;
