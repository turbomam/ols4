    ns1:hasExactSynonym "room_samp_pos" ;
    rdfs:comment "The horizontal sampling position in the room relative to architectural elements" ;
    rdfs:range MIXS:RoomSampPosEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:room_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "room type" ;
    dcterms:title "room type" ;
    schema1:keywords "room",
        "type" ;
    ns1:hasExactSynonym "room_type" ;
