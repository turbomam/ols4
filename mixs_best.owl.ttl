    rdfs:label "binning software" ;
    dcterms:title "binning software" ;
    schema1:keywords "software" ;
    ns1:hasExactSynonym "bin_software" ;
    rdfs:comment "Tool(s) used for the extraction of genomes from metagenomic datasets, where possible include a product ID (PID) of the tool(s) used" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "names and versions of software(s) used" .

MIXS:biol_stat a owl:ObjectProperty,
