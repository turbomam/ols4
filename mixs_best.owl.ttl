    schema1:keywords "disorder" ;
    ns1:hasExactSynonym "dermatology_disord" ;
    rdfs:comment "History of dermatology disorders; can include multiple disorders. The terms should be chosen from the DO (Human Disease Ontology) at http://www.disease-ontology.org, skin disease (https://disease-ontology.org/?id=DOID:37)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:drug_usage a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "drug usage" ;
    dcterms:title "drug usage" ;
    schema1:keywords "drug",
        "use" ;
    ns1:hasExactSynonym "drug_usage" ;
