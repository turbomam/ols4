<https://w3id.org/mixs/SoilHorizonEnum#A%20horizon> a owl:Class,
        MIXS:SoilHorizonEnum ;
    rdfs:label "A horizon" ;
    rdfs:comment "The surface horizon, also called topsoil. It has a defined soil structure, and is mostly made up of humus (decayed organic matter)." ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:SoilHorizonEnum .

<https://w3id.org/mixs/SoilHorizonEnum#B%20horizon> a owl:Class,
        MIXS:SoilHorizonEnum ;
    rdfs:label "B horizon" ;
    rdfs:comment "Also known as the subsoil. It is greatly composed of material illuviated (washed in from) layers above it. It is typically denser than the A horizon and has a clayey texture." ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:SoilHorizonEnum .

<https://w3id.org/mixs/SoilHorizonEnum#C%20horizon> a owl:Class,
        MIXS:SoilHorizonEnum ;
    rdfs:label "C horizon" ;
    rdfs:comment "Also known as the substratum is unconsolidated material deepest in the pit and closest to the bedrock." ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:SoilHorizonEnum .

<https://w3id.org/mixs/SoilHorizonEnum#E%20horizon> a owl:Class,
        MIXS:SoilHorizonEnum ;
    rdfs:label "E horizon" ;
    rdfs:comment "Used to refer to subsurface horizons that have undergone a significant loss of minerals, also known as Eluviation (or leaching)." ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:SoilHorizonEnum .

<https://w3id.org/mixs/SoilHorizonEnum#Permafrost> a owl:Class,
        MIXS:SoilHorizonEnum ;
    rdfs:label "Permafrost" ;
    rdfs:comment "Soil that continuously remains below 0 °C (32 °F) for two years or more." ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:SoilHorizonEnum .

<https://w3id.org/mixs/SoilHorizonEnum#R%20layer> a owl:Class,
        MIXS:SoilHorizonEnum ;
    rdfs:label "R layer" ;
    rdfs:comment "Hard bedrock, which is usually the lowest layer. It is characterized by tightly bound and unbreakable materials." ;
    rdfs:subClassOf linkml:PermissibleValue,
        MIXS:SoilHorizonEnum ;
    skos:altLabel "R horizon" .

