MIXS:animal_body_cond a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food animal body condition" ;
    dcterms:title "food animal body condition" ;
    schema1:keywords "animal",
        "body",
        "condition",
        "food" ;
    ns1:hasExactSynonym "animal_body_cond" ;
    rdfs:comment "Body condition scoring is a production management tool used to evaluate overall health and nutritional needs of a food animal. Because there are different scoring systems, this field is restricted to three categories" ;
    rdfs:range MIXS:AnimalBodyCondEnum ;
