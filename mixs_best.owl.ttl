    ns1:hasExactSynonym "gradient_pos_rel_am" ;
    rdfs:comment "The total nucleic acids loaded onto the column in this fraction as a decimal. If uploading 16S rRNA gene (or other amplicon) sequencing data, this value should be calculated from qPCR data. If uploading untargetted sequencing data, this value should be calculated from total DNA concentration." ;
    rdfs:range linkml:Float ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:gradient_position a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gradient position" ;
    dcterms:title "gradient position" ;
    ns1:hasExactSynonym "gradient_position" ;
