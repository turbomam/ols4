    skos:altLabel "MIxS-Food (human foods)" ;
    skos:exactMatch MIXS:0016022 ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "This extension is intended to work alongside the other food extensions (animals and animal feed, farm environment, and food production facilities) for capturing contextual data across the food supply-chain environment." ;
    MIXS:use_cases "Microbiome of foods intended for human consumption." .

MIXS:FreqCleanEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "freq clean" ;
    ns1:hasExactSynonym "FreqCleanEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/FreqCleanEnum#Annually> <https://w3id.org/mixs/FreqCleanEnum#Daily> <https://w3id.org/mixs/FreqCleanEnum#Monthly> <https://w3id.org/mixs/FreqCleanEnum#Quarterly> <https://w3id.org/mixs/FreqCleanEnum#Weekly> <https://w3id.org/mixs/FreqCleanEnum#other> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/FreqCleanEnum#Annually>,
        <https://w3id.org/mixs/FreqCleanEnum#Daily>,
        <https://w3id.org/mixs/FreqCleanEnum#Monthly>,
        <https://w3id.org/mixs/FreqCleanEnum#Quarterly>,
        <https://w3id.org/mixs/FreqCleanEnum#Weekly>,
        <https://w3id.org/mixs/FreqCleanEnum#other> .

MIXS:HcProducedEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "hc produced" ;
    ns1:hasExactSynonym "HcProducedEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/HcProducedEnum#Bitumen> <https://w3id.org/mixs/HcProducedEnum#Coalbed%20Methane> <https://w3id.org/mixs/HcProducedEnum#Gas> <https://w3id.org/mixs/HcProducedEnum#Gas-Condensate> <https://w3id.org/mixs/HcProducedEnum#Oil> <https://w3id.org/mixs/HcProducedEnum#other> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/HcProducedEnum#Bitumen>,
        <https://w3id.org/mixs/HcProducedEnum#Coalbed%20Methane>,
        <https://w3id.org/mixs/HcProducedEnum#Gas>,
        <https://w3id.org/mixs/HcProducedEnum#Gas-Condensate>,
        <https://w3id.org/mixs/HcProducedEnum#Oil>,
        <https://w3id.org/mixs/HcProducedEnum#other> .

