MIXS:water_source_adjac a owl:DatatypeProperty ;
    rdfs:label "environmental feature adjacent water source" ;
    dcterms:title "environmental feature adjacent water source" ;
    schema1:keywords "adjacent",
        "environmental",
        "feature",
        "source",
        "water" ;
    ns1:hasExactSynonym "water_source_adjac" ;
