    dcterms:title "food animal antimicrobial duration" ;
    schema1:keywords "animal",
        "antimicrobial",
        "duration",
        "food",
        "period" ;
    ns1:hasExactSynonym "animal_am_dur" ;
    rdfs:comment "The duration of time (days) that the antimicrobial was administered to the food animal" ;
