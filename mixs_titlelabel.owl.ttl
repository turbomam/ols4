    dcterms:title "occupant density at sampling" ;
    schema1:keywords "density" ;
    ns1:hasExactSynonym "occup_density_samp" ;
    rdfs:range xsd:float ;
    skos:definition "Average number of occupants at time of sampling per square footage" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:occup_document a owl:ObjectProperty ;
    rdfs:label "occupancy documentation" ;
    dcterms:title "occupancy documentation" ;
    schema1:keywords "documentation" ;
    ns1:hasExactSynonym "occup_document" ;
    rdfs:range MIXS:OccupDocumentEnum ;
