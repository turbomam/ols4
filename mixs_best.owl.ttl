MIXS:cult_isol_date a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "culture isolation date" ;
    dcterms:title "culture isolation date" ;
    schema1:keywords "culture",
        "date",
        "isolation" ;
    ns1:hasExactSynonym "cult_isol_date" ;
    rdfs:comment "The datetime marking the end of a process in which a sample yields a positive result for the target microbial analyte(s) in the form of an isolated colony or colonies" ;
    rdfs:range linkml:Datetime ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:density a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "density" ;
    dcterms:title "density" ;
    schema1:keywords "density" ;
    rdfs:comment "Density of the sample, which is its mass per unit volume (aka volumetric mass density)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram per cubic meter, gram per cubic centimeter" .

MIXS:diss_org_carb a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dissolved organic carbon" ;
    dcterms:title "dissolved organic carbon" ;
    schema1:keywords "carbon",
        "dissolved",
        "organic" ;
    ns1:hasExactSynonym "diss_org_carb" ;
    rdfs:comment "Concentration of dissolved organic carbon in the sample, liquid portion of the sample, or aqueous phase of the fluid" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter" .

MIXS:enrichment_protocol a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "enrichment protocol" ;
    dcterms:title "enrichment protocol" ;
    schema1:keywords "enrichment",
        "protocol" ;
    ns1:hasExactSynonym "enrichment_protocol" ;
    rdfs:comment "The microbiological workflow or protocol followed to test for the presence or enumeration of the target microbial analyte(s). Please provide a PubMed or DOI reference for published protocols" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:extrachrom_elements a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "extrachromosomal elements" ;
    dcterms:title "extrachromosomal elements" ;
    ns1:hasExactSynonym "extrachrom_elements" ;
    rdfs:comment "Do plasmids exist of significant phenotypic consequence (e.g. ones that determine virulence or antibiotic resistance). Megaplasmids? Other plasmids (borrelia has 15+ plasmids)" ;
    rdfs:range linkml:Integer ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_product_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food product type" ;
    dcterms:title "food product type" ;
    schema1:keywords "food",
        "product",
        "type" ;
    ns1:hasExactSynonym "food_product_type" ;
    rdfs:comment "A food product type is a class of food products that is differentiated by its food composition (e.g., single- or multi-ingredient), processing and/or consumption characteristics. This does not include brand name products but it may include generic food dish categories. This field accepts terms under food product type (http://purl.obolibrary.org/obo/FOODON:03400361). For terms related to food product for an animal, consult food product for animal (http://purl.obolibrary.org/obo/FOODON_03309997). If the proper descriptor is not listed please use text to describe the food type. Multiple terms can be separated by one or more pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:00001002 or FOODON:03309997" .

MIXS:food_source a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food source" ;
    dcterms:title "food source" ;
    schema1:keywords "food",
        "source" ;
    ns1:hasExactSynonym "food_source" ;
    rdfs:comment "Type of plant or animal from which the food product or its major ingredient is derived or a chemical food source [FDA CFSAN 1995]" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON term" .

MIXS:host_body_mass_index a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host body-mass index" ;
    dcterms:title "host body-mass index" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_body_mass_index" ;
    rdfs:comment "Body mass index, calculated as weight/(height)squared" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "kilogram per square meter" .

MIXS:host_dry_mass a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host dry mass" ;
    dcterms:title "host dry mass" ;
    schema1:keywords "dry",
        "host",
        "host.",
        "mass" ;
    ns1:hasExactSynonym "host_dry_mass" ;
    rdfs:comment "Measurement of dry mass" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "kilogram, gram" .

MIXS:host_length a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host length" ;
    dcterms:title "host length" ;
    schema1:keywords "host",
        "host.",
        "length" ;
    ns1:hasExactSynonym "host_length" ;
    rdfs:comment "The length of subject" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
