MIXS:food_contain_wrap a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food container or wrapping" ;
    dcterms:title "food container or wrapping" ;
    schema1:keywords "food" ;
    ns1:hasExactSynonym "food_contain_wrap" ;
    rdfs:comment "Type of container or wrapping defined by the main container material, the container form, and the material of the liner lids or ends. Also type of container or wrapping by form; prefer description by material first, then by form. This field accepts terms listed under food container or wrapping (http://purl.obolibrary.org/obo/FOODON_03490100)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03490100" .

MIXS:food_quality_date a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food quality date" ;
    dcterms:title "food quality date" ;
    schema1:keywords "date",
        "food",
        "quality" ;
    ns1:hasExactSynonym "food_quality_date" ;
    rdfs:comment "The date recommended for the use of the product while at peak quality, this date is not a reflection of safety unless used on infant formula this date is not a reflection of safety and is typically labeled on a food product as \"best if used by,\" best by,\" \"use by,\" or \"freeze by.\"" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration, date" .

MIXS:host_common_name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host common name" ;
    dcterms:title "host common name" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_common_name" ;
    rdfs:comment "Common name of the host" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
