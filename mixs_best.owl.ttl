MIXS:area_samp_size a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "area sampled size" ;
    dcterms:title "area sampled size" ;
    schema1:keywords "area",
        "sample",
        "size" ;
    ns1:hasExactSynonym "area_samp_size" ;
    rdfs:comment "The total amount or size (volume (ml), mass (g) or area (m2) ) of sample collected" ;
    skos:inScheme <https://w3id.org/mixs> ;
