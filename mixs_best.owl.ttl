    dcterms:title "hydrocarbon type produced" ;
    schema1:keywords "hydrocarbon",
        "type" ;
    ns1:hasExactSynonym "hc_produced" ;
    rdfs:comment "Main hydrocarbon type produced from resource (i.e. Oil, gas, condensate, etc). If \"other\" is specified, please propose entry in \"additional info\" field" ;
