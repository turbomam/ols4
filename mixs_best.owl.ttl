MIXS:ances_data a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ancestral data" ;
    dcterms:title "ancestral data" ;
    ns1:hasExactSynonym "ances_data" ;
    rdfs:comment "Information about either pedigree or other ancestral information description (e.g. parental variety in case of mutant or selection), e.g. A/3*B (meaning [(A x B) x B] x B)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:bromide a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bromide" ;
    dcterms:title "bromide" ;
    rdfs:comment "Concentration of bromide" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "parts per million" .

MIXS:chimera_check a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chimera check software" ;
    dcterms:title "chimera check software" ;
    schema1:keywords "software" ;
    ns1:hasExactSynonym "chimera_check" ;
    rdfs:comment "Tool(s) used for chimera checking, including version number and parameters, to discover and remove chimeric sequences. A chimeric sequence is comprised of two or more phylogenetically distinct parent sequences" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:chlorophyll a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chlorophyll" ;
    dcterms:title "chlorophyll" ;
    rdfs:comment "Concentration of chlorophyll" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per cubic meter, microgram per liter" .

MIXS:cult_result a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "culture result" ;
    dcterms:title "culture result" ;
    schema1:keywords "culture" ;
    ns1:hasExactSynonym "cult_result" ;
    rdfs:comment "Any result of a bacterial culture experiment reported as a binary assessment such as positive/negative, active/inactive" ;
