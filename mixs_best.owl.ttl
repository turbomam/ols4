        linkml:SlotDefinition ;
    rdfs:label "host number individual" ;
    dcterms:title "host number individual" ;
    schema1:keywords "host",
        "host.",
        "number" ;
    ns1:hasExactSynonym "host_number" ;
    rdfs:comment "Number of symbiotic host individuals pooled at the time of collection" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "count" .

MIXS:host_of_host_coinf a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "observed coinfecting organisms in host of host" ;
    dcterms:title "observed coinfecting organisms in host of host" ;
    schema1:keywords "host",
        "host.",
        "observed",
        "organism" ;
    ns1:hasExactSynonym "host_of_host_coinf" ;
    rdfs:comment "The taxonomic name of any coinfecting organism observed in a symbiotic relationship with the host of the sampled host organism. e.g. where a sample collected from a host trematode species (A) which was collected from a host_of_host fish (B) that was also infected with a nematode (C), the value here would be (C) the nematode {species name} or {common name}. Multiple co-infecting species may be added in a comma-separated list. For listing symbiotic organisms associated with the host (A) use the term Observed host symbiont" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "species name of coinfecting organism(s)" .

MIXS:host_of_host_env_med a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host of the symbiotic host environmental medium" ;
    dcterms:title "host of the symbiotic host environmental medium" ;
    schema1:keywords "environmental",
        "host",
        "host.",
        "symbiosis" ;
    ns1:hasExactSynonym "host_of_host_env_med" ;
    rdfs:comment "Report the environmental material(s) immediately surrounding the symbiotic host organism at the time of sampling. This usually will be a tissue or substance type from the host, but may be another material if the symbiont is external to the host. We recommend using classes from the UBERON ontology, but subclasses of 'environmental material' (http://purl.obolibrary.org/obo/ENVO_00010483) may also be used. EnvO documentation about how to use the field: https://github.com/EnvironmentOntology/envo/wiki/Using-ENVO-with-MIxS . Terms from other OBO ontologies are permissible as long as they reference mass/volume nouns (e.g. air, water, blood) and not discrete, countable entities (e.g. intestines, heart).MIxS . Terms from other OBO ontologies are permissible as long as they reference mass/volume nouns (e.g. air, water, blood) and not discrete, countable entities (e.g. intestines, heart)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "An ontology term for a material such as a tissue type or excreted substance" .

MIXS:host_of_host_geno a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host of the symbiotic host genotype" ;
    dcterms:title "host of the symbiotic host genotype" ;
    schema1:keywords "host",
        "host.",
        "symbiosis" ;
    ns1:hasExactSynonym "host_of_host_geno" ;
    rdfs:comment "Observed genotype of the host of the symbiotic host organism" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_of_host_gravid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host of the symbiotic host gravidity" ;
    dcterms:title "host of the symbiotic host gravidity" ;
    schema1:keywords "host",
        "host.",
        "symbiosis" ;
    ns1:hasExactSynonym "host_of_host_gravid" ;
    rdfs:comment "Whether or not the host of the symbiotic host organism is gravid, and if yes date due or date post-conception, specifying which is used" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "gravidity status;timestamp" .

MIXS:host_of_host_infname a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host of the symbiotic host infra-specific name" ;
    dcterms:title "host of the symbiotic host infra-specific name" ;
    schema1:keywords "host",
        "host.",
        "symbiosis" ;
    ns1:hasExactSynonym "host_of_host_infname" ;
    rdfs:comment "Taxonomic name information of the host of the symbiotic host organism below subspecies level" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_of_host_infrank a owl:ObjectProperty,
