    MIXS:Expected_value "soluble organic material name;measurement value" ;
    MIXS:Preferred_unit "gram, microgram, mole per liter, gram per liter, parts per million" .

MIXS:spec_intended_cons a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "specific intended consumer" ;
    dcterms:title "specific intended consumer" ;
    schema1:keywords "consumer" ;
    ns1:hasExactSynonym "spec_intended_cons" ;
    rdfs:comment "Food consumer type, human or animal, for which the food product is produced and marketed. This field accepts terms listed under food consumer group (http://purl.obolibrary.org/obo/FOODON_03510136)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:special_diet a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "special diet" ;
    dcterms:title "special diet" ;
    schema1:keywords "diet" ;
    ns1:hasExactSynonym "special_diet" ;
    rdfs:comment "Specification of special diet; can include multiple special diets" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "enumeration" .

MIXS:ster_meth_samp_room a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sampling room sterilization method" ;
    dcterms:title "sampling room sterilization method" ;
    schema1:keywords "method",
        "room" ;
    ns1:hasExactSynonym "ster_meth_samp_room" ;
    rdfs:comment "The method used to sterilize the sampling room. This field accepts terms listed under electromagnetic radiation (http://purl.obolibrary.org/obo/ENVO_01001026). If the proper descriptor is not listed, please use text to describe the sampling room sterilization method. Multiple terms can be separated by pipes" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "ENVO:01001026" .

MIXS:substructure_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "substructure type" ;
    dcterms:title "substructure type" ;
    schema1:keywords "type" ;
    ns1:hasExactSynonym "substructure_type" ;
    rdfs:comment "The substructure or under building is that largely hidden section of the building which is built off the foundations to the ground floor level" ;
    rdfs:range MIXS:SubstructureTypeEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:surf_air_cont a owl:ObjectProperty,
        linkml:SlotDefinition ;
