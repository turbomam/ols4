    MIXS:Expected_value "NCBI taxon identifier of the host of the symbiotic taxon organism" .

MIXS:host_of_host_totmass a owl:DatatypeProperty ;
    rdfs:label "host of the symbiotic host total mass" ;
    dcterms:title "host of the symbiotic host total mass" ;
    schema1:keywords "host",
        "host.",
        "mass",
        "symbiosis",
        "total" ;
    ns1:hasExactSynonym "host_of_host_totmass" ;
    rdfs:range xsd:string ;
