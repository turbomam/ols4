    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/PredGenomeStrucEnum#non-segmented>,
        <https://w3id.org/mixs/PredGenomeStrucEnum#segmented>,
        <https://w3id.org/mixs/PredGenomeStrucEnum#undetermined> .

