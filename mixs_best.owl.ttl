MIXS:Agriculture a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "agriculture" ;
    dcterms:title "agriculture" ;
    ns1:hasExactSynonym "Agriculture" ;
    rdfs:comment "A collection of terms appropriate when sequencing samples obtained in an agricultural environment. Suitable to capture metadata appropriate to enhance crop productivity and agroecosystem health with the aim to facilitate research of agricultural microbiomes and their relationships to plant productivity and sustainable crop production from diverse crop management contexts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:flooding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:soil_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:sequencing_location ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty MIXS:host_length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:cur_vegetation_meth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:host_tot_mass ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:lib_vector ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty MIXS:samp_mat_process ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:slope_gradient ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty MIXS:sieving ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty MIXS:host_genotype ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty MIXS:tot_org_c_meth ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty MIXS:samp_store_dur ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:local_class ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:climate_environment ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty MIXS:porosity ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty MIXS:link_class_info ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:soil_texture_meth ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:sop ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:link_climate_info ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:tot_org_c_meth ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:local_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:season_precpt ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:season_environment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:fertilizer_admin ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:plant_growth_med ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty MIXS:fertilizer_admin ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty MIXS:pesticide_regm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty MIXS:host_length ],
