    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/SampDisStageEnum#dissemination> <https://w3id.org/mixs/SampDisStageEnum#growth%20and%20reproduction> <https://w3id.org/mixs/SampDisStageEnum#infection> <https://w3id.org/mixs/SampDisStageEnum#inoculation> <https://w3id.org/mixs/SampDisStageEnum#other> <https://w3id.org/mixs/SampDisStageEnum#penetration> ) ;
