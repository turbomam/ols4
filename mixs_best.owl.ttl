    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "drug name;frequency" .

MIXS:emulsions a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "emulsions" ;
    dcterms:title "emulsions" ;
    rdfs:comment "Amount or concentration of substances such as paints, adhesives, mayonnaise, hair colorants, emulsified oils, etc.; can include multiple emulsion types" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "emulsion name;measurement value" ;
    MIXS:Preferred_unit "gram per liter" .

MIXS:extr_weather_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "extreme weather event" ;
    dcterms:title "extreme weather event" ;
    schema1:keywords "event",
        "extreme",
        "weather" ;
    ns1:hasExactSynonym "extr_weather_event" ;
    rdfs:comment "Unusual weather events that may have affected microbial populations. Multiple terms can be separated by pipes, listed in reverse chronological order" ;
