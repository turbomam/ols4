    schema1:keywords "device" ;
    ns1:hasExactSynonym "shad_dev_water_mold" ;
    rdfs:range MIXS:MoldVisibilityEnum ;
    skos:definition "Signs of the presence of mold or mildew on the shading device" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:shading_device_cond a owl:ObjectProperty ;
    rdfs:label "shading device condition" ;
    dcterms:title "shading device condition" ;
    schema1:keywords "condition",
        "device" ;
    ns1:hasExactSynonym "shading_device_cond" ;
    rdfs:range MIXS:DamagedRupturedEnum ;
