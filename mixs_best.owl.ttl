    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "gaseous substance name;measurement value" ;
    MIXS:Preferred_unit "micromole per liter" .

MIXS:gastrointest_disord a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gastrointestinal tract disorder" ;
    dcterms:title "gastrointestinal tract disorder" ;
    schema1:keywords "disorder" ;
    ns1:hasExactSynonym "gastrointest_disord" ;
    rdfs:comment "History of gastrointestinal tract disorders; can include multiple disorders. History of blood disorders; can include multiple disorders.  The terms should be chosen from the DO (Human Disease Ontology) at http://www.disease-ontology.org, gastrointestinal system disease (https://disease-ontology.org/?id=DOID:77)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:gravity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gravity" ;
    dcterms:title "gravity" ;
    rdfs:comment "Information about treatment involving use of gravity factor to study various types of responses in presence, absence or modified levels of gravity; treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple treatments" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "gravity factor value;treatment interval and duration" ;
    MIXS:Preferred_unit "meter per square second, g" .

MIXS:growth_hormone_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "growth hormone regimen" ;
    dcterms:title "growth hormone regimen" ;
    schema1:keywords "growth",
        "regimen" ;
    ns1:hasExactSynonym "growth_hormone_regm" ;
    rdfs:comment "Information about treatment involving use of growth hormones; should include the name of growth hormone, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple growth hormone regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "growth hormone name;growth hormone amount;treatment interval and duration" ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter" .

MIXS:gynecologic_disord a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gynecological disorder" ;
    dcterms:title "gynecological disorder" ;
