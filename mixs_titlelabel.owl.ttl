MIXS:light_intensity a owl:DatatypeProperty ;
    rdfs:label "light intensity" ;
    dcterms:title "light intensity" ;
    schema1:keywords "intensity",
        "light" ;
    ns1:hasExactSynonym "light_intensity" ;
    rdfs:range xsd:string ;
    skos:definition "Measurement of light intensity" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "lux" .

MIXS:light_regm a owl:DatatypeProperty ;
    rdfs:label "light regimen" ;
    dcterms:title "light regimen" ;
    schema1:keywords "light",
        "regimen" ;
    ns1:hasExactSynonym "light_regm" ;
