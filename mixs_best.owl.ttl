MIXS:otu_class_appr a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "OTU classification approach" ;
    dcterms:title "OTU classification approach" ;
    schema1:keywords "classification",
        "otu" ;
    ns1:hasExactSynonym "otu_class_appr" ;
    rdfs:comment "Cutoffs and approach used when clustering species-level OTUs. Note that results from standard 95% ANI / 85% AF clustering should be provided alongside OTUs defined from another set of thresholds, even if the latter are the ones primarily used during the analysis" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "cutoffs and method used" .

MIXS:otu_db a owl:ObjectProperty,
        linkml:SlotDefinition ;
