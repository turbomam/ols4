MIXS:ammonium a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ammonium" ;
    dcterms:title "ammonium" ;
    rdfs:comment "Concentration of ammonium in the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter, parts per million" .

MIXS:calcium a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "calcium" ;
    dcterms:title "calcium" ;
    rdfs:comment "Concentration of calcium in the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, micromole per liter, parts per million" .

MIXS:chloride a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chloride" ;
    dcterms:title "chloride" ;
    rdfs:comment "Concentration of chloride in the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, parts per million" .

MIXS:diss_carb_dioxide a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dissolved carbon dioxide" ;
    dcterms:title "dissolved carbon dioxide" ;
    schema1:keywords "carbon",
        "dissolved" ;
    ns1:hasExactSynonym "diss_carb_dioxide" ;
    rdfs:comment "Concentration of dissolved carbon dioxide in the sample or liquid portion of the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter" .

MIXS:diss_inorg_carb a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dissolved inorganic carbon" ;
    dcterms:title "dissolved inorganic carbon" ;
    schema1:keywords "carbon",
        "dissolved",
        "inorganic" ;
    ns1:hasExactSynonym "diss_inorg_carb" ;
    rdfs:comment "Dissolved inorganic carbon concentration in the sample, typically measured after filtering the sample using a 0.45 micrometer filter" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "microgram per liter, milligram per liter, parts per million" .

MIXS:estimated_genome_size a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "estimated genome size" ;
    dcterms:title "estimated genome size" ;
    schema1:keywords "size" ;
    ns1:hasExactSynonym "estimated_genome_size" ;
    rdfs:comment "The estimated size of the genome prior to sequencing. Of particular importance in the sequencing of (eukaryotic) genome which could remain in draft form for a long or unspecified period" ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "Slot updated 2026-02-10 `estimated_size` and title 'estimated size'" ;
    MIXS:Expected_value "number of base pairs" .

MIXS:genetic_mod a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "genetic modification" ;
    dcterms:title "genetic modification" ;
    ns1:hasExactSynonym "genetic_mod" ;
    rdfs:comment "Genetic modifications of the genome of an organism, which may occur naturally by spontaneous mutation, or be introduced by some experimental means, e.g. specification of a transgene or the gene knocked-out or details of transient transfection" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_body_temp a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host body temperature" ;
    dcterms:title "host body temperature" ;
    schema1:keywords "body",
        "host",
        "host.",
        "temperature" ;
    ns1:hasExactSynonym "host_body_temp" ;
    rdfs:comment "Core body temperature of the host when sample was collected" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:host_sex a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host sex" ;
    dcterms:title "host sex" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_sex" ;
    rdfs:comment "Gender or physical sex of the host" ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "example of non-binary from Excel sheets does not match any of the enumerated values" ;
    MIXS:Expected_value "enumeration" .

MIXS:host_symbiont a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "observed host symbionts" ;
    dcterms:title "observed host symbionts" ;
    schema1:keywords "host",
        "host.",
        "observed",
        "symbiosis" ;
    ns1:hasExactSynonym "host_symbiont" ;
    rdfs:comment "The taxonomic name of the organism(s) found living in mutualistic, commensalistic, or parasitic symbiosis with the specific host. The sampled symbiont can have its own symbionts. For example, parasites may have hyperparasites (=parasites of the parasite)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "species name or common name" .

