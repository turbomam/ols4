MIXS:prod_start_date a owl:DatatypeProperty ;
    rdfs:label "production start date" ;
    dcterms:title "production start date" ;
    schema1:keywords "date",
        "production",
        "start" ;
    ns1:hasExactSynonym "prod_start_date" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date of field's first production" ;
