MIXS:host_occupation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host occupation" ;
    dcterms:title "host occupation" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_occupation" ;
    rdfs:comment "Most frequent job performed by subject" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "Couldn't convert host_occupation with value veterinary to integer",
        "almost all host_occupation values in the NCBI biosample_set are strings, not integers" .

MIXS:host_pulse a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host pulse" ;
    dcterms:title "host pulse" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_pulse" ;
    rdfs:comment "Resting pulse, measured as beats per minute" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "beats per minute" .

MIXS:host_taxid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host taxid" ;
    dcterms:title "host taxid" ;
    schema1:keywords "host",
        "host.",
        "taxon" ;
    ns1:hasExactSynonym "host_taxid" ;
