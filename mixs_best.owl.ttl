MIXS:water_source_adjac a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "environmental feature adjacent water source" ;
    dcterms:title "environmental feature adjacent water source" ;
    schema1:keywords "adjacent",
        "environmental",
        "feature",
        "source",
        "water" ;
    ns1:hasExactSynonym "water_source_adjac" ;
    rdfs:comment "Description of the environmental features that are adjacent to the farm water source. This field accepts terms under ecosystem (http://purl.obolibrary.org/obo/ENVO_01001110) and human construction (http://purl.obolibrary.org/obo/ENVO_00000070). Multiple terms can be separated by pipes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "ENVO_01001110 or ENVO_00000070" .

MIXS:abs_air_humidity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "absolute air humidity" ;
    dcterms:title "absolute air humidity" ;
    schema1:keywords "absolute",
        "air",
        "humidity" ;
    ns1:hasExactSynonym "abs_air_humidity" ;
    rdfs:comment "Actual mass of water vapor present in the air water vapor mixture." ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "Can be calculated via mass of water vapor divided by the volume of the air and water vapor mixture." ;
    MIXS:Preferred_unit "gram per gram, kilogram per kilogram, kilogram, pound, gram per cubic meter, kilogram per cubic meter, percent" .

MIXS:add_recov_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "secondary and tertiary recovery methods and start date" ;
    dcterms:title "secondary and tertiary recovery methods and start date" ;
    schema1:keywords "date",
        "method",
        "recover",
        "secondary",
        "start" ;
    ns1:hasExactSynonym "add_recov_method" ;
    rdfs:comment "Additional (i.e. Secondary, tertiary, etc.) recovery methods deployed for increase of hydrocarbon recovery from resource and start date for each one of them. If \"other\" is specified, please propose entry in \"additional info\" field" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:address a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "address" ;
    dcterms:title "address" ;
    rdfs:comment "The street name and building number where the sampling occurred" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:adj_room a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "adjacent rooms" ;
