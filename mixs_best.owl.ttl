MIXS:animal_am_use a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food animal antimicrobial intended use" ;
    dcterms:title "food animal antimicrobial intended use" ;
    schema1:keywords "animal",
        "antimicrobial",
        "food",
        "use" ;
    ns1:hasExactSynonym "animal_am_use" ;
    rdfs:comment "The prescribed intended use of or the condition treated by the antimicrobial given to the food animal by any route of administration" ;
    rdfs:range linkml:String ;
