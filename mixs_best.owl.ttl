    skos:inScheme <https://w3id.org/mixs> .

MIXS:plant_reprod_crop a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "plant reproductive part" ;
    dcterms:title "plant reproductive part" ;
    schema1:keywords "plant" ;
    ns1:hasExactSynonym "plant_reprod_crop" ;
    rdfs:comment "Plant reproductive part used in the field during planting to start the crop" ;
    rdfs:range MIXS:PlantReprodCropEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:pollutants a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pollutants" ;
    dcterms:title "pollutants" ;
    rdfs:comment "Pollutant types and, amount or concentrations measured at the time of sampling; can report multiple pollutants by entering numeric values preceded by name of pollutant" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "pollutant name;measurement value" ;
    MIXS:Preferred_unit "gram, mole per liter, milligram per liter, microgram per cubic meter" .

MIXS:pulmonary_disord a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lung/pulmonary disorder" ;
    dcterms:title "lung/pulmonary disorder" ;
    schema1:keywords "disorder" ;
    ns1:hasExactSynonym "pulmonary_disord" ;
    rdfs:comment "History of pulmonary disorders; can include multiple disorders. The terms should be chosen from the DO (Human Disease Ontology) at http://www.disease-ontology.org, lung disease (https://disease-ontology.org/?id=DOID:850)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:radiation_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "radiation regimen" ;
    dcterms:title "radiation regimen" ;
    schema1:keywords "regimen" ;
    ns1:hasExactSynonym "radiation_regm" ;
    rdfs:comment "Information about treatment involving exposure of plant or a plant part to a particular radiation regimen; should include the radiation type, amount or intensity administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple radiation regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "radiation type name;radiation amount;treatment interval and duration" ;
    MIXS:Preferred_unit "rad, gray" .

MIXS:rainfall_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rainfall regimen" ;
    dcterms:title "rainfall regimen" ;
    schema1:keywords "rain",
        "regimen" ;
    ns1:hasExactSynonym "rainfall_regm" ;
    rdfs:comment "Information about treatment involving an exposure to a given amount of rainfall, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value;treatment interval and duration" ;
    MIXS:Preferred_unit "millimeter" .

MIXS:samp_sort_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample size sorting method" ;
    dcterms:title "sample size sorting method" ;
    schema1:keywords "method",
        "sample",
        "size" ;
    ns1:hasExactSynonym "samp_sort_meth" ;
    rdfs:comment "Method by which samples are sorted; open face filter collecting total suspended particles, prefilter to remove particles larger than X micrometers in diameter, where common values of X would be 10 and 2.5 full size sorting in a cascade impactor" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_surf_moisture a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample surface moisture" ;
    dcterms:title "sample surface moisture" ;
    schema1:keywords "moisture",
        "sample",
        "surface" ;
    ns1:hasExactSynonym "samp_surf_moisture" ;
    rdfs:comment "Degree of water held on a sampled surface.  If present, user can state the degree of water held on surface (intermittent moisture, submerged). If no surface moisture is present indicate not present" ;
    rdfs:range MIXS:SampSurfMoistureEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:sediment_data a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "Sediment data" ;
    dcterms:title "Sediment data" ;
    schema1:keywords "sediment" ;
    ns1:hasExactSynonym "sediment_data" ;
    rdfs:comment "Data that comply with Extension Sediment" ;
    rdfs:domain MIXS:MixsCompliantData ;
    rdfs:range MIXS:Sediment ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:soil_data a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "Soil data" ;
    dcterms:title "Soil data" ;
    schema1:keywords "soil" ;
    ns1:hasExactSynonym "soil_data" ;
    rdfs:comment "Data that comply with Extension Soil" ;
    rdfs:domain MIXS:MixsCompliantData ;
    rdfs:range MIXS:Soil ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:soluble_inorg_mat a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "soluble inorganic material" ;
    dcterms:title "soluble inorganic material" ;
    schema1:keywords "inorganic",
        "material",
        "soluble" ;
    ns1:hasExactSynonym "soluble_inorg_mat" ;
