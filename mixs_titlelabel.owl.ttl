MIXS:host_cellular_loc a owl:ObjectProperty ;
    rdfs:label "host cellular location" ;
    dcterms:title "host cellular location" ;
    schema1:keywords "host",
        "host.",
        "location" ;
    ns1:hasExactSynonym "host_cellular_loc" ;
    rdfs:range MIXS:HostCellularLocEnum ;
    skos:definition "The localization of the symbiotic host organism within the host from which it was sampled: e.g. intracellular if the symbiotic host organism is localized within the cells or extracellular if the symbiotic host organism is localized outside of cells" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_dependence a owl:ObjectProperty ;
    rdfs:label "host dependence" ;
    dcterms:title "host dependence" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_dependence" ;
    rdfs:range MIXS:HostDependenceEnum ;
    skos:definition "Type of host dependence for the symbiotic host organism to its host" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_hiv_stat a owl:DatatypeProperty ;
    rdfs:label "host HIV status" ;
    dcterms:title "host HIV status" ;
    schema1:keywords "host",
        "host.",
        "status" ;
    ns1:hasExactSynonym "host_hiv_stat" ;
