<https://w3id.org/mixs> a owl:Ontology ;
    rdfs:label "MIxS" ;
    dcterms:source <https://github.com/GenomicsStandardsConsortium/mixs> ;
    pav:version "v6.3.0" ;
    rdfs:comment "The Minimum Information about any (x) Sequence (MIxS) standard, developed by the Genomic Standards Consortium (GSC; https://www.gensc.org/). MIxS provides checklists and environmental extensions of metadata terms for describing the sampling context, environment, and sequencing of biological specimens. Source repository: https://github.com/GenomicsStandardsConsortium/mixs" ;
    owl:versionInfo "v6.3.0" ;
    skos:note "slot titles that are associated with more than one slot name/SCN: host sex" .

