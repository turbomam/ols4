    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "partner sex;frequency" .

MIXS:shad_dev_water_mold a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "shading device signs of water/mold" ;
    dcterms:title "shading device signs of water/mold" ;
    schema1:keywords "device" ;
    ns1:hasExactSynonym "shad_dev_water_mold" ;
