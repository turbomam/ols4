MIXS:part_org_nitro a owl:DatatypeProperty ;
    rdfs:label "particulate organic nitrogen" ;
    dcterms:title "particulate organic nitrogen" ;
    schema1:keywords "nitrogen",
        "organic",
        "particle",
        "particulate" ;
    ns1:hasExactSynonym "part_org_nitro" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of particulate organic nitrogen" ;
    skos:inScheme <https://w3id.org/mixs> ;
