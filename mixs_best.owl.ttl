MIXS:food_additive a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food additive" ;
    dcterms:title "food additive" ;
    schema1:keywords "food" ;
    ns1:hasExactSynonym "food_additive" ;
    rdfs:comment "A substance or substances added to food to maintain or improve safety and freshness, to improve or maintain nutritional value, or improve taste, texture and appearance.  This field accepts terms listed under food additive (http://purl.obolibrary.org/obo/FOODON_03412972). Multiple terms can be separated by one or more pipes, but please consider limiting this list to the top 5 ingredients listed in order as on the food label.  See also, https://www.fda.gov/food/food-ingredients-packaging/overview-food-ingredients-additives-colors" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03412972" .

MIXS:food_cooking_proc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food cooking process" ;
    dcterms:title "food cooking process" ;
    schema1:keywords "food",
        "process" ;
    ns1:hasExactSynonym "food_cooking_proc" ;
    rdfs:comment "The transformation of raw food by the application of heat. This field accepts terms listed under food cooking (http://purl.obolibrary.org/obo/FOODON_03450002)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03450002" .

MIXS:food_dis_point a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food distribution point geographic location" ;
    dcterms:title "food distribution point geographic location" ;
    schema1:keywords "food",
        "geographic",
        "location" ;
    ns1:hasExactSynonym "food_dis_point" ;
    rdfs:comment "A reference to a place on the Earth, by its name or by its geographical location that refers to a distribution point along the food chain. This field accepts terms listed under geographic location (http://purl.obolibrary.org/obo/GAZ_00000448). Reference: Adam Diamond, James Barham. Moving Food Along the Value Chain: Innovations in Regional Food Distribution. U.S. Dept. of Agriculture, Agricultural Marketing Service. Washington, DC. March 2012. http://dx.doi.org/10.9752/MS045.03-2012" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_ingredient a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food ingredient" ;
    dcterms:title "food ingredient" ;
    schema1:keywords "food",
        "ingredient" ;
    ns1:hasExactSynonym "food_ingredient" ;
    rdfs:comment "In this field, please list individual ingredients for multi-component food [FOODON:00002501] and simple foods that is not captured in food_type.  Please use terms that are present in FoodOn.  Multiple terms can be separated by one or more pipes |, but please consider limiting this list to the top 5 ingredients listed in order as on the food label.  See also, https://www.fda.gov/food/food-ingredients-packaging/overview-food-ingredients-additives-colors" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON" .

MIXS:food_name_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food product name legal status" ;
    dcterms:title "food product name legal status" ;
    schema1:keywords "food",
        "product",
        "status" ;
    ns1:hasExactSynonym "food_name_status" ;
    rdfs:comment "A datum indicating that use of a food product name is regulated in some legal jurisdiction. This field accepts terms listed under food product name legal status (http://purl.obolibrary.org/obo/FOODON_03530087)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:food_pack_integrity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food packing medium integrity" ;
    dcterms:title "food packing medium integrity" ;
    schema1:keywords "food" ;
    ns1:hasExactSynonym "food_pack_integrity" ;
    rdfs:comment "A term label and term id to describe the state of the packing material and text to explain the exact condition.  This field accepts terms listed under food packing medium integrity (http://purl.obolibrary.org/obo/FOODON_03530218)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03530218" .

MIXS:food_prior_contact a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "material of contact prior to food packaging" ;
    dcterms:title "material of contact prior to food packaging" ;
    schema1:keywords "food",
        "material",
        "prior" ;
    ns1:hasExactSynonym "food_prior_contact" ;
    rdfs:comment "The material the food contacted (e.g., was processed in) prior to packaging. This field accepts terms listed under material of contact prior to food packaging (http://purl.obolibrary.org/obo/FOODON_03530077). If the proper descriptor is not listed please use text to describe the material of contact prior to food packaging" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FOODON:03530077" .

MIXS:food_prod_synonym a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food product synonym" ;
    dcterms:title "food product synonym" ;
    schema1:keywords "food",
        "product" ;
    ns1:hasExactSynonym "food_prod_synonym" ;
