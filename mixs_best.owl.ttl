        linkml:EnumDefinition ;
    rdfs:label "soil horizon" ;
    ns1:hasExactSynonym "SoilHorizonEnum" ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Permafrost>,
        <https://en.wikipedia.org/wiki/Soil_horizon>,
        <https://soil.evs.buffalo.edu/index.php/Soil_Horizons>,
        <https://www.ffa.org/ag-101/ag-101-soil-horizons/>,
        <https://www.nrcs.usda.gov/resources/education-and-teaching-materials/a-soil-profile> ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/SoilHorizonEnum#A%20horizon> <https://w3id.org/mixs/SoilHorizonEnum#B%20horizon> <https://w3id.org/mixs/SoilHorizonEnum#C%20horizon> <https://w3id.org/mixs/SoilHorizonEnum#E%20horizon> <http://purl.obolibrary.org/obo/ENVO_03600018> <https://w3id.org/mixs/SoilHorizonEnum#Permafrost> <https://w3id.org/mixs/SoilHorizonEnum#R%20layer> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <http://purl.obolibrary.org/obo/ENVO_03600018>,
        <https://w3id.org/mixs/SoilHorizonEnum#A%20horizon>,
        <https://w3id.org/mixs/SoilHorizonEnum#B%20horizon>,
        <https://w3id.org/mixs/SoilHorizonEnum#C%20horizon>,
        <https://w3id.org/mixs/SoilHorizonEnum#E%20horizon>,
        <https://w3id.org/mixs/SoilHorizonEnum#Permafrost>,
        <https://w3id.org/mixs/SoilHorizonEnum#R%20layer> .

