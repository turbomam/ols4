    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, parts per million" .

MIXS:tvdss_of_hcr_press a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "depth (TVDSS) of hydrocarbon resource pressure" ;
    dcterms:title "depth (TVDSS) of hydrocarbon resource pressure" ;
    schema1:keywords "depth",
        "hydrocarbon",
