    skos:inScheme <https://w3id.org/mixs> .

MIXS:spikein_AMR a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "antimicrobial phenotype of spike-in bacteria" ;
    dcterms:title "antimicrobial phenotype of spike-in bacteria" ;
    schema1:keywords "antimicrobial",
        "spike" ;
    ns1:hasExactSynonym "spikein_AMR" ;
    rdfs:comment "Qualitative description of a microbial response to antimicrobial agents. Bacteria may be susceptible or resistant to a broad range of antibiotic drugs or drug classes, with several intermediate states or phases. This field accepts terms under antimicrobial phenotype (http://purl.obolibrary.org/obo/ARO_3004299)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value ARO:3004299" .

MIXS:standing_water_regm a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "standing water regimen" ;
    dcterms:title "standing water regimen" ;
    schema1:keywords "regimen",
        "water" ;
    ns1:hasExactSynonym "standing_water_regm" ;
    rdfs:comment "Treatment involving an exposure to standing water during a plant's life span, types can be flood water or standing water, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple regimens" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

