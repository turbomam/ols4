    dcterms:title "food animal antimicrobial route of administration" ;
    schema1:keywords "administration",
        "animal",
        "antimicrobial",
        "food",
        "route" ;
    ns1:hasExactSynonym "animal_am_route" ;
    rdfs:range xsd:string ;
