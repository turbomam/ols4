        <https://w3id.org/mixs/FarmWaterSourceEnum#pond>,
        <https://w3id.org/mixs/FarmWaterSourceEnum#reservior>,
        <https://w3id.org/mixs/FarmWaterSourceEnum#river>,
        <https://w3id.org/mixs/FarmWaterSourceEnum#saline>,
        <https://w3id.org/mixs/FarmWaterSourceEnum#storage%20tank>,
        <https://w3id.org/mixs/FarmWaterSourceEnum#stream>,
        <https://w3id.org/mixs/FarmWaterSourceEnum#well> .

MIXS:NegContTypeEnum a owl:Class ;
    rdfs:label "NegContTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/NegContTypeEnum#DNA-free%20PCR%20mix> <https://w3id.org/mixs/NegContTypeEnum#distilled%20water> <https://w3id.org/mixs/NegContTypeEnum#empty%20collection%20device> <https://w3id.org/mixs/NegContTypeEnum#empty%20collection%20tube> <https://w3id.org/mixs/NegContTypeEnum#phosphate%20buffer> <https://w3id.org/mixs/NegContTypeEnum#sterile%20swab> <https://w3id.org/mixs/NegContTypeEnum#sterile%20syringe> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/NegContTypeEnum#DNA-free%20PCR%20mix>,
        <https://w3id.org/mixs/NegContTypeEnum#distilled%20water>,
        <https://w3id.org/mixs/NegContTypeEnum#empty%20collection%20device>,
        <https://w3id.org/mixs/NegContTypeEnum#empty%20collection%20tube>,
        <https://w3id.org/mixs/NegContTypeEnum#phosphate%20buffer>,
        <https://w3id.org/mixs/NegContTypeEnum#sterile%20swab>,
        <https://w3id.org/mixs/NegContTypeEnum#sterile%20syringe> .

MIXS:OxyStatSampEnum a owl:Class ;
    rdfs:label "OxyStatSampEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/OxyStatSampEnum#aerobic> <https://w3id.org/mixs/OxyStatSampEnum#anaerobic> <https://w3id.org/mixs/OxyStatSampEnum#other> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/OxyStatSampEnum#aerobic>,
        <https://w3id.org/mixs/OxyStatSampEnum#anaerobic>,
        <https://w3id.org/mixs/OxyStatSampEnum#other> .

MIXS:alkalinity a owl:DatatypeProperty ;
    rdfs:label "alkalinity" ;
    dcterms:title "alkalinity" ;
    schema1:keywords "alkalinity" ;
    rdfs:range xsd:string ;
    skos:definition "Alkalinity, the ability of a solution to neutralize acids to the equivalence point of carbonate or bicarbonate" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milliequivalent per liter, milligram per liter" .

MIXS:biotic_relationship a owl:ObjectProperty ;
    rdfs:label "observed biotic relationship" ;
    dcterms:title "observed biotic relationship" ;
    schema1:keywords "observed",
        "relationship" ;
    ns1:hasExactSynonym "biotic_relationship" ;
    rdfs:range MIXS:BioticRelationshipEnum ;
    skos:definition "Description of relationship(s) between the subject organism and other organism(s) it is associated with. E.g., parasite on species X; mutualist with species Y. The target organism is the subject of the relationship, and the other organism(s) is the object" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_body_product a owl:DatatypeProperty ;
    rdfs:label "host body product" ;
    dcterms:title "host body product" ;
    schema1:keywords "body",
        "host",
        "host.",
        "product" ;
    ns1:hasExactSynonym "host_body_product" ;
    skos:definition "Substance produced by the body, e.g. Stool, mucus, where the sample was obtained from. Use terms from the foundational model of anatomy ontology (fma) or Uber-anatomy ontology (UBERON)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FMA or UBERON" .

MIXS:host_body_site a owl:DatatypeProperty ;
    rdfs:label "host body site" ;
    dcterms:title "host body site" ;
    schema1:keywords "body",
        "host",
        "site" ;
    ns1:hasExactSynonym "host_body_site" ;
    skos:definition "Name of body site where the sample was obtained from, such as a specific organ or tissue (tongue, lung etc...). Use terms from the foundational model of anatomy ontology (fma) or the Uber-anatomy ontology (UBERON)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FMA or UBERON" .

MIXS:host_subject_id a owl:DatatypeProperty ;
    rdfs:label "host subject id" ;
    dcterms:title "host subject id" ;
    schema1:keywords "host",
        "host.",
        "identifier" ;
    ns1:hasExactSynonym "host_subject_id" ;
    rdfs:range xsd:string ;
    skos:definition "A unique identifier by which each subject can be referred to, de-identified" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:mid a owl:DatatypeProperty ;
    rdfs:label "multiplex identifiers" ;
    dcterms:title "multiplex identifiers" ;
    schema1:keywords "identifier" ;
    ns1:hasExactSynonym "mid" ;
    rdfs:range xsd:string ;
    skos:definition "Molecular barcodes, called Multiplex Identifiers (MIDs), that are used to specifically tag unique samples in a sequencing run. Sequence should be reported in uppercase letters" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:nitrate a owl:DatatypeProperty ;
    rdfs:label "nitrate" ;
    dcterms:title "nitrate" ;
    schema1:keywords "nitrate" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of nitrate in the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter, parts per million" .

MIXS:sodium a owl:DatatypeProperty ;
    rdfs:label "sodium" ;
    dcterms:title "sodium" ;
    rdfs:range xsd:string ;
    skos:definition "Sodium concentration in the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, parts per million" .

MIXS:Extension a owl:Class ;
    rdfs:label "Extension" ;
    rdfs:subClassOf linkml:ClassDefinition ;
    skos:altLabel "EnvironmentalPackage" ;
    skos:definition "A collection of recommended metadata terms (slots) developed by community experts, describing the specific context under which a sample was collected." ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:GeolAgeEnum a owl:Class ;
    rdfs:label "GeolAgeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/GeolAgeEnum#Archean> <https://w3id.org/mixs/GeolAgeEnum#Cambrian> <https://w3id.org/mixs/GeolAgeEnum#Carboniferous> <https://w3id.org/mixs/GeolAgeEnum#Cenozoic> <https://w3id.org/mixs/GeolAgeEnum#Cretaceous> <https://w3id.org/mixs/GeolAgeEnum#Devonian> <https://w3id.org/mixs/GeolAgeEnum#Jurassic> <https://w3id.org/mixs/GeolAgeEnum#Mesozoic> <https://w3id.org/mixs/GeolAgeEnum#Neogene> <https://w3id.org/mixs/GeolAgeEnum#Ordovician> <https://w3id.org/mixs/GeolAgeEnum#Paleogene> <https://w3id.org/mixs/GeolAgeEnum#Paleozoic> <https://w3id.org/mixs/GeolAgeEnum#Permian> <https://w3id.org/mixs/GeolAgeEnum#Precambrian> <https://w3id.org/mixs/GeolAgeEnum#Proterozoic> <https://w3id.org/mixs/GeolAgeEnum#Silurian> <https://w3id.org/mixs/GeolAgeEnum#Triassic> <https://w3id.org/mixs/GeolAgeEnum#other> ) ;
    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/GeolAgeEnum#Archean>,
        <https://w3id.org/mixs/GeolAgeEnum#Cambrian>,
        <https://w3id.org/mixs/GeolAgeEnum#Carboniferous>,
        <https://w3id.org/mixs/GeolAgeEnum#Cenozoic>,
        <https://w3id.org/mixs/GeolAgeEnum#Cretaceous>,
        <https://w3id.org/mixs/GeolAgeEnum#Devonian>,
        <https://w3id.org/mixs/GeolAgeEnum#Jurassic>,
        <https://w3id.org/mixs/GeolAgeEnum#Mesozoic>,
        <https://w3id.org/mixs/GeolAgeEnum#Neogene>,
        <https://w3id.org/mixs/GeolAgeEnum#Ordovician>,
        <https://w3id.org/mixs/GeolAgeEnum#Paleogene>,
        <https://w3id.org/mixs/GeolAgeEnum#Paleozoic>,
        <https://w3id.org/mixs/GeolAgeEnum#Permian>,
        <https://w3id.org/mixs/GeolAgeEnum#Precambrian>,
        <https://w3id.org/mixs/GeolAgeEnum#Proterozoic>,
        <https://w3id.org/mixs/GeolAgeEnum#Silurian>,
        <https://w3id.org/mixs/GeolAgeEnum#Triassic>,
        <https://w3id.org/mixs/GeolAgeEnum#other> .

MIXS:compl_score a owl:DatatypeProperty ;
    rdfs:label "completeness score" ;
    dcterms:title "completeness score" ;
    schema1:keywords "score" ;
    ns1:hasExactSynonym "compl_score" ;
    skos:definition "Completeness score is typically based on either the fraction of markers found as compared to a database or the percent of a genome found as compared to a closely related reference genome. High Quality Draft: >90%, Medium Quality Draft: >50%, and Low Quality Draft: < 50% should have the indicated completeness scores" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "quality;percent completeness" .

MIXS:compl_software a owl:DatatypeProperty ;
    rdfs:label "completeness software" ;
    dcterms:title "completeness software" ;
    schema1:keywords "software" ;
    ns1:hasExactSynonym "compl_software" ;
    skos:definition "Tools used for completion estimate, i.e. checkm, anvi'o, busco" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "names and versions of software(s) used" .

MIXS:isol_growth_condt a owl:DatatypeProperty ;
    rdfs:label "isolation and growth condition" ;
    dcterms:title "isolation and growth condition" ;
    schema1:keywords "condition",
        "growth",
        "isolation" ;
    ns1:hasExactSynonym "isol_growth_condt" ;
    rdfs:range xsd:string ;
    skos:definition "Publication reference in the form of pubmed ID (pmid), digital object identifier (doi) or url for isolation and growth condition specifications of the organism/material" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:rel_to_oxygen a owl:ObjectProperty ;
    rdfs:label "relationship to oxygen" ;
    dcterms:title "relationship to oxygen" ;
    schema1:keywords "oxygen",
        "relationship" ;
    ns1:hasExactSynonym "rel_to_oxygen" ;
    rdfs:range MIXS:RelToOxygenEnum ;
    skos:definition "Is this organism an aerobe, anaerobe? Please note that aerobic and anaerobic are valid descriptors for microbial environments" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:subspecf_gen_lin a owl:DatatypeProperty ;
    rdfs:label "subspecific genetic lineage" ;
    dcterms:title "subspecific genetic lineage" ;
    schema1:keywords "lineage" ;
    ns1:hasExactSynonym "subspecf_gen_lin" ;
    skos:definition "Information about the genetic distinctness of the sequenced organism below the subspecies level, e.g., serovar, serotype, biotype, ecotype, or any relevant genetic typing schemes like Group I plasmid. Subspecies should not be recorded in this term, but in the NCBI taxonomy. Supply both the lineage name and the lineage rank separated by a colon, e.g., biovar:abc123" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "Genetic lineage below lowest rank of NCBI taxonomy, which is subspecies, e.g. serovar, biotype, ecotype, variety, cultivar" .

MIXS:tax_ident a owl:ObjectProperty ;
    rdfs:label "taxonomic identity marker" ;
    dcterms:title "taxonomic identity marker" ;
    schema1:keywords "identifier",
        "marker",
        "taxon" ;
    ns1:hasExactSynonym "tax_ident" ;
    rdfs:range MIXS:TaxIdentEnum ;
    skos:definition "The phylogenetic marker(s) used to assign an organism name to the SAG or MAG" ;
    skos:inScheme <https://w3id.org/mixs> .

