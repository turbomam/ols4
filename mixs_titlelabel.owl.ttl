MIXS:ammonium a owl:DatatypeProperty ;
    rdfs:label "ammonium" ;
    dcterms:title "ammonium" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of ammonium in the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter, parts per million" .

MIXS:calcium a owl:DatatypeProperty ;
    rdfs:label "calcium" ;
    dcterms:title "calcium" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of calcium in the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, micromole per liter, parts per million" .

MIXS:chloride a owl:DatatypeProperty ;
    rdfs:label "chloride" ;
    dcterms:title "chloride" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of chloride in the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, parts per million" .

MIXS:diss_carb_dioxide a owl:DatatypeProperty ;
    rdfs:label "dissolved carbon dioxide" ;
    dcterms:title "dissolved carbon dioxide" ;
    schema1:keywords "carbon",
        "dissolved" ;
    ns1:hasExactSynonym "diss_carb_dioxide" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of dissolved carbon dioxide in the sample or liquid portion of the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter" .

MIXS:diss_inorg_carb a owl:DatatypeProperty ;
    rdfs:label "dissolved inorganic carbon" ;
    dcterms:title "dissolved inorganic carbon" ;
    schema1:keywords "carbon",
        "dissolved",
        "inorganic" ;
    ns1:hasExactSynonym "diss_inorg_carb" ;
    rdfs:range xsd:string ;
    skos:definition "Dissolved inorganic carbon concentration in the sample, typically measured after filtering the sample using a 0.45 micrometer filter" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "microgram per liter, milligram per liter, parts per million" .

MIXS:estimated_genome_size a owl:DatatypeProperty ;
    rdfs:label "estimated genome size" ;
    dcterms:title "estimated genome size" ;
    schema1:keywords "size" ;
    ns1:hasExactSynonym "estimated_genome_size" ;
    skos:definition "The estimated size of the genome prior to sequencing. Of particular importance in the sequencing of (eukaryotic) genome which could remain in draft form for a long or unspecified period" ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "Slot updated 2026-02-10 `estimated_size` and title 'estimated size'" ;
    MIXS:Expected_value "number of base pairs" .

MIXS:genetic_mod a owl:DatatypeProperty ;
    rdfs:label "genetic modification" ;
    dcterms:title "genetic modification" ;
    ns1:hasExactSynonym "genetic_mod" ;
    skos:definition "Genetic modifications of the genome of an organism, which may occur naturally by spontaneous mutation, or be introduced by some experimental means, e.g. specification of a transgene or the gene knocked-out or details of transient transfection" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_body_temp a owl:DatatypeProperty ;
    rdfs:label "host body temperature" ;
    dcterms:title "host body temperature" ;
    schema1:keywords "body",
        "host",
        "host.",
        "temperature" ;
    ns1:hasExactSynonym "host_body_temp" ;
    rdfs:range xsd:string ;
    skos:definition "Core body temperature of the host when sample was collected" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:host_sex a owl:DatatypeProperty ;
    rdfs:label "host sex" ;
    dcterms:title "host sex" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_sex" ;
    skos:definition "Gender or physical sex of the host" ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note "example of non-binary from Excel sheets does not match any of the enumerated values" ;
    MIXS:Expected_value "enumeration" .

MIXS:host_symbiont a owl:DatatypeProperty ;
    rdfs:label "observed host symbionts" ;
    dcterms:title "observed host symbionts" ;
    schema1:keywords "host",
        "host.",
        "observed",
        "symbiosis" ;
    ns1:hasExactSynonym "host_symbiont" ;
    rdfs:range xsd:string ;
    skos:definition "The taxonomic name of the organism(s) found living in mutualistic, commensalistic, or parasitic symbiosis with the specific host. The sampled symbiont can have its own symbionts. For example, parasites may have hyperparasites (=parasites of the parasite)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "species name or common name" .

MIXS:nitrite a owl:DatatypeProperty ;
    rdfs:label "nitrite" ;
    dcterms:title "nitrite" ;
    schema1:keywords "nitrite" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of nitrite in the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter, parts per million" .

MIXS:potassium a owl:DatatypeProperty ;
    rdfs:label "potassium" ;
    dcterms:title "potassium" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of potassium in the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, parts per million" .

MIXS:pressure a owl:DatatypeProperty ;
    rdfs:label "pressure" ;
    dcterms:title "pressure" ;
    schema1:keywords "pressure" ;
    rdfs:range xsd:string ;
    skos:definition "Pressure to which the sample is subject to, in atmospheres" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "atmosphere" .

MIXS:size_frac a owl:DatatypeProperty ;
    rdfs:label "size fraction selected" ;
    dcterms:title "size fraction selected" ;
    schema1:keywords "fraction",
        "size" ;
    ns1:hasExactSynonym "size_frac" ;
    skos:definition "Filtering pore size used in sample preparation" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "filter size value range" .

MIXS:specific_host a owl:DatatypeProperty ;
    rdfs:label "host scientific name" ;
    dcterms:title "host scientific name" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "specific_host" ;
    skos:definition "Report the host's taxonomic name and/or NCBI taxonomy ID" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "host scientific name, taxonomy ID" .

MIXS:sulfate a owl:DatatypeProperty ;
    rdfs:label "sulfate" ;
    dcterms:title "sulfate" ;
    schema1:keywords "sulfate" ;
    rdfs:range xsd:string ;
    skos:definition "Concentration of sulfate in the sample" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter, parts per million" .

