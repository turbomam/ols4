    skos:inScheme <https://w3id.org/mixs> .

MIXS:soil_data a owl:ObjectProperty ;
    rdfs:label "Soil data" ;
    dcterms:title "Soil data" ;
    schema1:keywords "soil" ;
    ns1:hasExactSynonym "soil_data" ;
    rdfs:domain MIXS:MixsCompliantData ;
