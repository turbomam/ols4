MIXS:feat_pred a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "feature prediction" ;
    dcterms:title "feature prediction" ;
    schema1:keywords "feature",
        "predict" ;
    ns1:hasExactSynonym "feat_pred" ;
    rdfs:comment "Method used to predict UViGs features such as ORFs, integration site, etc" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_age a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host age" ;
    dcterms:title "host age" ;
    schema1:keywords "age",
        "host",
        "host." ;
    ns1:hasExactSynonym "host_age" ;
    rdfs:comment "Age of host at the time of sampling; relevant scale depends on species and study, e.g. Could be seconds for amoebae or centuries for trees" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "year, day, hour" .

MIXS:host_genotype a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host genotype" ;
    dcterms:title "host genotype" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_genotype" ;
    rdfs:comment "Observed genotype" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_height a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host height" ;
    dcterms:title "host height" ;
    schema1:keywords "height",
        "host",
        "host." ;
    ns1:hasExactSynonym "host_height" ;
    rdfs:comment "The height of subject" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "centimeter, millimeter, meter" .

MIXS:host_phenotype a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host phenotype" ;
    dcterms:title "host phenotype" ;
    schema1:keywords "host",
        "host." ;
    ns1:hasExactSynonym "host_phenotype" ;
    rdfs:comment "Phenotype of human or other host. Use terms from the phenotypic quality ontology (pato) or the Human Phenotype Ontology (HP)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "PATO or HP" .

MIXS:host_tot_mass a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host total mass" ;
    dcterms:title "host total mass" ;
    schema1:keywords "host",
        "host.",
        "mass",
        "total" ;
    ns1:hasExactSynonym "host_tot_mass" ;
    rdfs:comment "Total mass of the host at collection, the unit depends on host" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "kilogram, gram" .

MIXS:number_contig a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "number of contigs" ;
    dcterms:title "number of contigs" ;
    schema1:keywords "number" ;
    ns1:hasExactSynonym "number_contig" ;
    rdfs:comment "Total number of contigs in the cleaned/submitted assembly that makes up a given genome, SAG, MAG, or UViG" ;
    rdfs:range linkml:Integer ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:ref_biomaterial a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reference for biomaterial" ;
    dcterms:title "reference for biomaterial" ;
    ns1:hasExactSynonym "ref_biomaterial" ;
    rdfs:comment "Primary publication if isolated before genome publication; otherwise, primary genome report" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:ref_db a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reference database(s)" ;
    dcterms:title "reference database(s)" ;
    schema1:keywords "database" ;
    ns1:hasExactSynonym "ref_db" ;
    rdfs:comment "List of database(s) used for ORF annotation, along with version number and reference to website or publication" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "names, versions, and references of databases" .

MIXS:sim_search_meth a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "similarity search method" ;
    dcterms:title "similarity search method" ;
    schema1:keywords "method" ;
    ns1:hasExactSynonym "sim_search_meth" ;
    rdfs:comment "Tool used to compare ORFs with database, along with version and cutoffs used" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:source_mat_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source material identifiers" ;
    dcterms:title "source material identifiers" ;
    schema1:keywords "identifier",
        "material",
        "source" ;
    ns1:hasExactSynonym "source_mat_id" ;
    rdfs:comment "A unique identifier assigned to a material sample (as defined by http://rs.tdwg.org/dwc/terms/materialSampleID, and as opposed to a particular digital record of a material sample) used for extracting nucleic acids, and subsequent sequencing. The identifier can refer either to the original material collected or to any derived sub-samples. The INSDC qualifiers /specimen_voucher, /bio_material, or /culture_collection may or may not share the same value as the source_mat_id field. For instance, the /specimen_voucher qualifier and source_mat_id may both contain 'UAM:Herps:14' , referring to both the specimen voucher and sampled tissue with the same identifier. However, the /culture_collection qualifier may refer to a value from an initial culture (e.g. ATCC:11775) while source_mat_id would refer to an identifier from some derived culture from which the nucleic acids were extracted (e.g. xatc123 or ark:/2154/R2)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "for cultures of microorganisms: identifiers for two culture collections; for other material a unique arbitrary identifer" .

MIXS:tax_class a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxonomic classification" ;
    dcterms:title "taxonomic classification" ;
    schema1:keywords "classification",
        "taxon" ;
    ns1:hasExactSynonym "tax_class" ;
    rdfs:comment "Method used for taxonomic classification, along with reference database used, classification rank, and thresholds used to classify new genomes" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:chem_administration a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chemical administration" ;
    dcterms:title "chemical administration" ;
    schema1:keywords "administration" ;
    ns1:hasExactSynonym "chem_administration" ;
    rdfs:comment "List of chemical compounds administered to the host or site where sampling occurred, and when (e.g. Antibiotics, n fertilizer, air filter); can include multiple compounds. For chemical entities of biological interest ontology (chebi) (v 163), http://purl.bioontology.org/ontology/chebi" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "CHEBI;timestamp" .

MIXS:experimental_factor a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "experimental factor" ;
    dcterms:title "experimental factor" ;
    schema1:keywords "experimental",
        "factor" ;
    ns1:hasExactSynonym "experimental_factor" ;
    rdfs:comment "Variable aspects of an experiment design that can be used to describe an experiment, or set of experiments, in an increasingly detailed manner. This field accepts ontology terms from Experimental Factor Ontology (EFO) and/or Ontology for Biomedical Investigations (OBI)" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( linkml:String [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^\\S+.*\\S+ \\[[a-zA-Z]{2,}:\\d+\\]$" ] ) ] ) ] ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "text or EFO and/or OBI" .

MIXS:SurfMaterialEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "surf material" ;
    ns1:hasExactSynonym "SurfMaterialEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/mixs/SurfMaterialEnum#adobe> <https://w3id.org/mixs/SurfMaterialEnum#carpet> <https://w3id.org/mixs/SurfMaterialEnum#cinder%20blocks> <https://w3id.org/mixs/SurfMaterialEnum#concrete> <https://w3id.org/mixs/SurfMaterialEnum#glass> <https://w3id.org/mixs/SurfMaterialEnum#hay%20bales> <https://w3id.org/mixs/SurfMaterialEnum#metal> <https://w3id.org/mixs/SurfMaterialEnum#paint> <https://w3id.org/mixs/SurfMaterialEnum#plastic> <https://w3id.org/mixs/SurfMaterialEnum#stainless%20steel> <https://w3id.org/mixs/SurfMaterialEnum#stone> <https://w3id.org/mixs/SurfMaterialEnum#stucco> <https://w3id.org/mixs/SurfMaterialEnum#tile> <https://w3id.org/mixs/SurfMaterialEnum#vinyl> <https://w3id.org/mixs/SurfMaterialEnum#wood> ) ;
