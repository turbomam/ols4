    dcterms:title "hydrocarbon resource type" ;
    schema1:keywords "hydrocarbon",
        "resource",
        "type" ;
    ns1:hasExactSynonym "hcr" ;
    rdfs:comment "Main Hydrocarbon Resource type. The term \"Hydrocarbon Resource\" HCR defined as a natural environmental feature containing large amounts of hydrocarbons at high concentrations potentially suitable for commercial exploitation. This term should not be confused with the Hydrocarbon Occurrence term which also includes hydrocarbon-rich environments with currently limited commercial interest such as seeps, outcrops, gas hydrates etc. If \"other\" is specified, please propose entry in \"additional info\" field" ;
    rdfs:range MIXS:HcrEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:hcr_fw_salinity a owl:ObjectProperty,
