    rdfs:label "host of the symbiotic host infra-specific rank" ;
    dcterms:title "host of the symbiotic host infra-specific rank" ;
    schema1:keywords "host",
        "host.",
        "rank",
        "symbiosis" ;
    ns1:hasExactSynonym "host_of_host_infrank" ;
    rdfs:range xsd:string ;
    skos:definition "Taxonomic rank information about the host of the symbiotic host organism below subspecies level, such as variety, form, rank etc" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_of_host_name a owl:DatatypeProperty ;
    rdfs:label "host of the symbiotic host common name" ;
    dcterms:title "host of the symbiotic host common name" ;
    schema1:keywords "host",
        "host.",
        "symbiosis" ;
    ns1:hasExactSynonym "host_of_host_name" ;
    rdfs:range xsd:string ;
    skos:definition "Common name of the host of the symbiotic host organism" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_of_host_pheno a owl:DatatypeProperty ;
    rdfs:label "host of the symbiotic host phenotype" ;
    dcterms:title "host of the symbiotic host phenotype" ;
    schema1:keywords "host",
        "host.",
        "symbiosis" ;
    ns1:hasExactSynonym "host_of_host_pheno" ;
