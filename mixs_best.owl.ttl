    schema1:keywords "hydrocarbon",
        "pressure",
        "resource" ;
    ns1:hasExactSynonym "hcr_pressure" ;
    rdfs:comment "Original pressure of the hydrocarbon resource" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
