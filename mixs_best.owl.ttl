    dcterms:title "soil type method" ;
    schema1:keywords "method",
        "soil",
        "type" ;
    ns1:hasExactSynonym "soil_type_meth" ;
    rdfs:comment "Reference or method used in determining soil series name or other lower-level classification" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:spikein_count a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "spike-in organism count" ;
    dcterms:title "spike-in organism count" ;
    schema1:keywords "count",
        "organism",
        "spike" ;
    ns1:hasExactSynonym "spikein_count" ;
    rdfs:comment "Total cell count of any organism (or group of organisms) per gram, volume or area of sample, should include name of organism followed by count. The method that was used for the enumeration (e.g. qPCR, atp, mpn, etc.) should also be provided (example: total prokaryotes; 3.5e7 cells per ml; qPCR)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "organism name;measurement value;enumeration" ;
    MIXS:Preferred_unit "colony forming units per milliliter; colony forming units per gram of dry weight" .

MIXS:study_inc_dur a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "study incubation duration" ;
