    dcterms:title "aerospace structure" ;
    ns1:hasExactSynonym "aero_struc" ;
    rdfs:comment "Aerospace structures typically consist of thin plates with stiffeners for the external surfaces, bulkheads and frames to support the shape and fasteners such as welds, rivets, screws and bolts to hold the components together" ;
    rdfs:range MIXS:AeroStrucEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:al_sat a owl:ObjectProperty,
