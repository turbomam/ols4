MIXS:ventilation_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ventilation type" ;
    dcterms:title "ventilation type" ;
    schema1:keywords "type" ;
    ns1:hasExactSynonym "ventilation_type" ;
