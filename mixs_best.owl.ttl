    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degree Celsius" .

MIXS:api a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "API gravity" ;
    dcterms:title "API gravity" ;
    ns1:hasExactSynonym "api" ;
    rdfs:comment "API gravity is a measure of how heavy or light a petroleum liquid is compared to water (source: https://en.wikipedia.org/wiki/API_gravity) (e.g. 31.1   API)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "degrees API" .

MIXS:aromatics_pc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aromatics wt%" ;
    dcterms:title "aromatics wt%" ;
    ns1:hasExactSynonym "aromatics_pc" ;
    rdfs:comment "Saturate, Aromatic, Resin and Asphaltene (SARA) is an analysis method that divides crude oil components according to their polarizability and polarity. There are three main methods to obtain SARA results. The most popular one is known as the Iatroscan TLC-FID and is referred to as IP-143 (source: https://en.wikipedia.org/wiki/Saturate,_aromatic,_resin_and_asphaltene)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "percent" .

MIXS:asphaltenes_pc a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "asphaltenes wt%" ;
    dcterms:title "asphaltenes wt%" ;
    ns1:hasExactSynonym "asphaltenes_pc" ;
    rdfs:comment "Saturate, Aromatic, Resin and Asphaltene (SARA) is an analysis method that divides crude oil components according to their polarizability and polarity. There are three main methods to obtain SARA results. The most popular one is known as the Iatroscan TLC-FID and is referred to as IP-143 (source: https://en.wikipedia.org/wiki/Saturate,_aromatic,_resin_and_asphaltene)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "percent" .

MIXS:avg_occup a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "average daily occupancy" ;
    dcterms:title "average daily occupancy" ;
    schema1:keywords "average" ;
    ns1:hasExactSynonym "avg_occup" ;
    rdfs:comment "Daily average occupancy of room. Indicate the number of person(s) daily occupying the sampling room" ;
    rdfs:range linkml:Float ;
    skos:inScheme <https://w3id.org/mixs> .

