    skos:inScheme <https://w3id.org/mixs> .

MIXS:microb_start_source a owl:DatatypeProperty ;
    rdfs:label "microbial starter source" ;
    dcterms:title "microbial starter source" ;
    schema1:keywords "microbial",
        "source" ;
    ns1:hasExactSynonym "microb_start_source" ;
    rdfs:range xsd:string ;
    skos:definition "The source from which the microbial starter culture was sourced.  If commercially supplied, list supplier" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:microb_start_taxID a owl:DatatypeProperty ;
    rdfs:label "microbial starter NCBI taxonomy ID" ;
