    schema1:keywords "administration" ;
    ns1:hasExactSynonym "fertilizer_admin" ;
    rdfs:comment "Type of fertilizer or amendment added to the soil or water for the purpose of improving substrate health and quality for plant growth. This field accepts terms listed under agronomic fertilizer (http://purl.obolibrary.org/obo/AGRO_00002062). Multiple terms may apply and can be separated by pipes, listing in reverse chronological order" ;
    rdfs:range linkml:String ;
