        linkml:SlotDefinition ;
    rdfs:label "room window count" ;
    dcterms:title "room window count" ;
    schema1:keywords "count",
        "room",
        "window" ;
    ns1:hasExactSynonym "room_window_count" ;
    rdfs:comment "Number of windows in the room" ;
    rdfs:range linkml:Integer ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:root_med_regl a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rooting medium regulators" ;
    dcterms:title "rooting medium regulators" ;
    ns1:hasExactSynonym "root_med_regl" ;
    rdfs:comment "Growth regulators in the culture rooting medium such as cytokinins, auxins, gybberellins, abscisic acid; e.g. 0.5  mg/L NAA" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "regulator name;measurement value" ;
    MIXS:Preferred_unit "milligram per liter" .

MIXS:root_med_solid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rooting medium solidifier" ;
    dcterms:title "rooting medium solidifier" ;
    ns1:hasExactSynonym "root_med_solid" ;
    rdfs:comment "Specification of the solidifying agent in the culture rooting medium; e.g. agar" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:root_med_suppl a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rooting medium organic supplements" ;
    dcterms:title "rooting medium organic supplements" ;
    schema1:keywords "organic" ;
    ns1:hasExactSynonym "root_med_suppl" ;
    rdfs:comment "Organic supplements of the culture rooting medium, such as vitamins, amino acids, organic acids, antibiotics activated charcoal; e.g. nicotinic acid (0.5  mg/L)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "supplement name;measurement value" ;
    MIXS:Preferred_unit "milligram per liter" .

MIXS:route_transmission a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "route of transmission" ;
    dcterms:title "route of transmission" ;
    schema1:keywords "route" ;
    ns1:hasExactSynonym "route_transmission" ;
    rdfs:comment "Description of path taken by the symbiotic host organism being sampled in order to establish a symbiotic relationship with the host (with which it was observed at the time of sampling) via a mode of transmission (specified in mode_transmission)" ;
    rdfs:range MIXS:RouteTransmissionEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_collect_point a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample collection point" ;
    dcterms:title "sample collection point" ;
    schema1:keywords "sample" ;
    ns1:hasExactSynonym "samp_collect_point" ;
    rdfs:comment "Sampling point on the asset were sample was collected (e.g. Wellhead, storage tank, separator, etc). If \"other\" is specified, please propose entry in \"additional info\" field" ;
    rdfs:range MIXS:SampCollectPointEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_loc_condition a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample location condition" ;
    dcterms:title "sample location condition" ;
    schema1:keywords "condition",
        "location",
        "sample" ;
    ns1:hasExactSynonym "samp_loc_condition" ;
    rdfs:comment "The condition of the sample location at the time of sampling" ;
    rdfs:range MIXS:SampLocConditionEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:samp_loc_corr_rate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "corrosion rate at sample location" ;
    dcterms:title "corrosion rate at sample location" ;
    schema1:keywords "location",
        "rate",
        "sample" ;
    ns1:hasExactSynonym "samp_loc_corr_rate" ;
    rdfs:comment "Metal corrosion rate is the speed of metal deterioration due to environmental conditions. As environmental conditions change corrosion rates change accordingly. Therefore, long term corrosion rates are generally more informative than short term rates and for that reason they are preferred during reporting. In the case of suspected MIC, corrosion rate measurements at the time of sampling might provide insights into the involvement of certain microbial community members in MIC as well as potential microbial interplays" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "millimeter per year" .

MIXS:samp_md a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample measured depth" ;
    dcterms:title "sample measured depth" ;
    schema1:keywords "depth",
        "measurement",
        "sample" ;
    ns1:hasExactSynonym "samp_md" ;
    rdfs:comment "In non deviated well, measured depth is equal to the true vertical depth, TVD (TVD=TVDSS plus the reference or datum it refers to). In deviated wells, the MD is the length of trajectory of the borehole measured from the same reference or datum. Common datums used are ground level (GL), drilling rig floor (DF), rotary table (RT), kelly bushing (KB) and mean sea level (MSL). If \"other\" is specified, please propose entry in \"additional info\" field" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value;enumeration" ;
    MIXS:Preferred_unit "meter" .

MIXS:samp_preserv a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "preservative added to sample" ;
    dcterms:title "preservative added to sample" ;
    schema1:keywords "sample" ;
    ns1:hasExactSynonym "samp_preserv" ;
    rdfs:comment "Preservative added to the sample (e.g. Rnalater, alcohol, formaldehyde, etc.). Where appropriate include volume added (e.g. Rnalater; 2 ml)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milliliter" .

MIXS:samp_store_sol a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample storage solution" ;
    dcterms:title "sample storage solution" ;
    schema1:keywords "sample",
        "storage" ;
    ns1:hasExactSynonym "samp_store_sol" ;
    rdfs:comment "Solution within which sample was stored, if any" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "solution name" .

MIXS:samp_time_out a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sampling time outside" ;
    dcterms:title "sampling time outside" ;
    schema1:keywords "time" ;
    ns1:hasExactSynonym "samp_time_out" ;
    rdfs:comment "The recent and long term history of outside sampling" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "time" ;
    MIXS:Preferred_unit "hour" .

MIXS:samp_tvdss a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample true vertical depth subsea" ;
    dcterms:title "sample true vertical depth subsea" ;
    schema1:keywords "depth",
        "sample" ;
    ns1:hasExactSynonym "samp_tvdss" ;
    rdfs:comment "Depth of the sample i.e. The vertical distance between the sea level and the sampled position in the subsurface. Depth can be reported as an interval for subsurface samples e.g. 1325.75-1362.25 m" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "measurement value or measurement value range" ;
    MIXS:Preferred_unit "meter" .

