MIXS:MigsBaAgriculture a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "MigsBa combined with Agriculture" ;
    dcterms:title "MigsBa combined with Agriculture" ;
    ns1:hasExactSynonym "MigsBaAgriculture" ;
    rdfs:comment "MIxS Data that comply with the MigsBa checklist and the Agriculture Extension" ;
    rdfs:subClassOf MIXS:Agriculture,
        MIXS:MigsBa ;
    skos:exactMatch MIXS:0010003_0016018 ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:MigsBaAir a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "MigsBa combined with Air" ;
    dcterms:title "MigsBa combined with Air" ;
    ns1:hasExactSynonym "MigsBaAir" ;
    rdfs:comment "MIxS Data that comply with the MigsBa checklist and the Air Extension" ;
    rdfs:subClassOf MIXS:Air,
        MIXS:MigsBa ;
    skos:exactMatch MIXS:0010003_0016000 ;
    skos:inScheme <https://w3id.org/mixs> .

