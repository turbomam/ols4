    skos:inScheme <https://w3id.org/mixs> ;
    linkml:permissible_values <https://w3id.org/mixs/PlantReprodCropEnum#plant%20cutting>,
        <https://w3id.org/mixs/PlantReprodCropEnum#pregerminated%20seed>,
        <https://w3id.org/mixs/PlantReprodCropEnum#ratoon>,
        <https://w3id.org/mixs/PlantReprodCropEnum#seed>,
        <https://w3id.org/mixs/PlantReprodCropEnum#seedling>,
        <https://w3id.org/mixs/PlantReprodCropEnum#whole%20mature%20plant> .

