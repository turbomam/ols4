MIXS:indoor_space a owl:ObjectProperty ;
    rdfs:label "indoor space" ;
    dcterms:title "indoor space" ;
    schema1:keywords "indoor" ;
    ns1:hasExactSynonym "indoor_space" ;
    rdfs:range MIXS:IndoorSpaceEnum ;
