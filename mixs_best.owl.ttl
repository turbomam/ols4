MIXS:alkalinity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alkalinity" ;
    dcterms:title "alkalinity" ;
    schema1:keywords "alkalinity" ;
    rdfs:comment "Alkalinity, the ability of a solution to neutralize acids to the equivalence point of carbonate or bicarbonate" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milliequivalent per liter, milligram per liter" .

MIXS:biotic_relationship a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "observed biotic relationship" ;
    dcterms:title "observed biotic relationship" ;
    schema1:keywords "observed",
        "relationship" ;
    ns1:hasExactSynonym "biotic_relationship" ;
    rdfs:comment "Description of relationship(s) between the subject organism and other organism(s) it is associated with. E.g., parasite on species X; mutualist with species Y. The target organism is the subject of the relationship, and the other organism(s) is the object" ;
    rdfs:range MIXS:BioticRelationshipEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:host_body_product a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host body product" ;
    dcterms:title "host body product" ;
    schema1:keywords "body",
        "host",
        "host.",
        "product" ;
    ns1:hasExactSynonym "host_body_product" ;
    rdfs:comment "Substance produced by the body, e.g. Stool, mucus, where the sample was obtained from. Use terms from the foundational model of anatomy ontology (fma) or Uber-anatomy ontology (UBERON)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FMA or UBERON" .

MIXS:host_body_site a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host body site" ;
    dcterms:title "host body site" ;
    schema1:keywords "body",
        "host",
        "site" ;
    ns1:hasExactSynonym "host_body_site" ;
    rdfs:comment "Name of body site where the sample was obtained from, such as a specific organ or tissue (tongue, lung etc...). Use terms from the foundational model of anatomy ontology (fma) or the Uber-anatomy ontology (UBERON)" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "FMA or UBERON" .

MIXS:host_subject_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "host subject id" ;
    dcterms:title "host subject id" ;
    schema1:keywords "host",
        "host.",
        "identifier" ;
    ns1:hasExactSynonym "host_subject_id" ;
    rdfs:comment "A unique identifier by which each subject can be referred to, de-identified" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:mid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "multiplex identifiers" ;
    dcterms:title "multiplex identifiers" ;
    schema1:keywords "identifier" ;
    ns1:hasExactSynonym "mid" ;
    rdfs:comment "Molecular barcodes, called Multiplex Identifiers (MIDs), that are used to specifically tag unique samples in a sequencing run. Sequence should be reported in uppercase letters" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:nitrate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nitrate" ;
    dcterms:title "nitrate" ;
    schema1:keywords "nitrate" ;
    rdfs:comment "Concentration of nitrate in the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "micromole per liter, milligram per liter, parts per million" .

MIXS:sodium a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sodium" ;
    dcterms:title "sodium" ;
    rdfs:comment "Sodium concentration in the sample" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "milligram per liter, parts per million" .

