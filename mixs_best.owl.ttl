MIXS:nose_mouth_teeth_throat_disord a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nose/mouth/teeth/throat disorder" ;
    dcterms:title "nose/mouth/teeth/throat disorder" ;
    schema1:keywords "disorder" ;
    ns1:hasExactSynonym "nose_mouth_teeth_throat_disord" ;
    rdfs:comment """History of nose/mouth/teeth/throat disorders; can include multiple disorders. The terms should be chosen from the DO (Human Disease Ontology) at http://www.disease-ontology.org, nose disease (https://disease-ontology.org/?id=DOID:2825), mouth disease (https://disease-ontology.org/?id=DOID:403), tooth disease (https://disease-ontology.org/?id=DOID:1091), or upper respiratory tract disease (https://disease-ontology.org/?id=DOID:974)
""" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:nose_throat_disord a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nose throat disorder" ;
    dcterms:title "nose throat disorder" ;
    schema1:keywords "disorder" ;
    ns1:hasExactSynonym "nose_throat_disord" ;
    rdfs:comment """Report any history of nose, mouth, teeth and/or throat disorders in the subject. May include multiple disorders.
""" ;
    rdfs:range linkml:String ;
    skos:altLabel "nose_mouth_teeth_throat_disord" ;
    skos:inScheme <https://w3id.org/mixs> ;
    skos:note """The terms should be chosen from the DO (Human Disease Ontology) at http://www.disease-ontology.org, lung disease (https://disease-ontology.org/?id=DOID:850), upper respiratory tract disease (https://disease-ontology.org/?id=DOID:974)
""" .

MIXS:org_particles a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "organic particles" ;
    dcterms:title "organic particles" ;
    schema1:keywords "organic",
        "particle" ;
    ns1:hasExactSynonym "org_particles" ;
    rdfs:comment "Concentration of particles such as faeces, hairs, food, vomit, paper fibers, plant material, humus, etc" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "particle name;measurement value" ;
    MIXS:Preferred_unit "gram per liter" .

MIXS:particle_class a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "particle classification" ;
    dcterms:title "particle classification" ;
    schema1:keywords "classification",
        "particle" ;
    ns1:hasExactSynonym "particle_class" ;
    rdfs:comment "Particles are classified, based on their size, into six general categories:clay, silt, sand, gravel, cobbles, and boulders; should include amount of particle preceded by the name of the particle type; can include multiple values" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "particle name;measurement value" ;
    MIXS:Preferred_unit "micrometer" .

MIXS:pet_farm_animal a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "presence of pets or farm animals" ;
    dcterms:title "presence of pets or farm animals" ;
    schema1:keywords "animal",
        "farm",
        "presence" ;
    ns1:hasExactSynonym "pet_farm_animal" ;
    rdfs:comment "Specification of presence of pets or farm animals in the environment of subject, if yes the animals should be specified; can include multiple animals present" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "presence status;type of animal or pet" .

