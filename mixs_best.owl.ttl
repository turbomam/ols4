    dcterms:title "salt regimen" ;
    schema1:keywords "regimen",
        "salt" ;
    ns1:hasExactSynonym "salt_regm" ;
    rdfs:comment "Information about treatment involving use of salts as supplement to liquid and soil growth media; should include the name of salt, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple salt regimens" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Preferred_unit "gram, microgram, mole per liter, gram per liter" .

MIXS:season_environment a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "seasonal environment" ;
    dcterms:title "seasonal environment" ;
    schema1:keywords "environment",
        "season" ;
    ns1:hasExactSynonym "season_environment" ;
