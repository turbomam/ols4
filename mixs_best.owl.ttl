    rdfs:domain MIXS:MixsCompliantData ;
    rdfs:range MIXS:SymbiontAssociated ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:travel_out_six_month a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "travel outside the country in last six months" ;
    dcterms:title "travel outside the country in last six months" ;
    schema1:keywords "months" ;
    ns1:hasExactSynonym "travel_out_six_month" ;
    rdfs:comment "Specification of the countries travelled in the last six months; can include multiple travels" ;
    rdfs:range linkml:String ;
