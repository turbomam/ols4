    ns1:hasExactSynonym "gynecologic_disord" ;
    rdfs:comment "History of gynecological disorders; can include multiple disorders. The terms should be chosen from the DO (Human Disease Ontology) at http://www.disease-ontology.org, female reproductive system disease (https://disease-ontology.org/?id=DOID:229)" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

