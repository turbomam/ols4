    rdfs:range MIXS:BuildOccupTypeEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:built_environment_data a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "BuiltEnvironment data" ;
    dcterms:title "BuiltEnvironment data" ;
    ns1:hasExactSynonym "built_environment_data" ;
    rdfs:comment "Data that comply with Extension BuiltEnvironment" ;
    rdfs:domain MIXS:MixsCompliantData ;
    rdfs:range MIXS:BuiltEnvironment ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:chem_mutagen a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chemical mutagen" ;
    dcterms:title "chemical mutagen" ;
    ns1:hasExactSynonym "chem_mutagen" ;
    rdfs:comment "Treatment involving use of mutagens; should include the name of mutagen, amount administered, treatment regimen including how many times the treatment was repeated, how long each treatment lasted, and the start and end time of the entire treatment; can include multiple mutagen regimens" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "mutagen name;mutagen amount;treatment interval and duration" ;
    MIXS:Preferred_unit "milligram per liter" .

MIXS:date_extr_weath a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "extreme weather date" ;
    dcterms:title "extreme weather date" ;
    schema1:keywords "date",
        "extreme",
        "weather" ;
    ns1:hasExactSynonym "date_extr_weath" ;
    rdfs:comment "Date of unusual weather events that may have affected microbial populations. Multiple terms can be separated by pipes, listed in reverse chronological order" ;
    rdfs:range linkml:Datetime ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:dermatology_disord a owl:ObjectProperty,
