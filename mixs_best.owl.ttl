MIXS:room_vol a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "room volume" ;
    dcterms:title "room volume" ;
    schema1:keywords "room",
        "volume" ;
    ns1:hasExactSynonym "room_vol" ;
    rdfs:comment "Volume of sampling room" ;
