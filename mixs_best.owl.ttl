    dcterms:title "extreme_unusual_properties/Al saturation method" ;
    schema1:keywords "extreme",
        "method",
        "properties",
        "saturation",
        "unusual" ;
    ns1:hasExactSynonym "al_sat_meth" ;
    rdfs:comment "Reference or method used in determining Al saturation" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:amniotic_fluid_color a owl:ObjectProperty,
