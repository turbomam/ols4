MIXS:animal_am_route a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "food animal antimicrobial route of administration" ;
    dcterms:title "food animal antimicrobial route of administration" ;
    schema1:keywords "administration",
        "animal",
        "antimicrobial",
        "food",
        "route" ;
    ns1:hasExactSynonym "animal_am_route" ;
    rdfs:comment "The route by which the antimicrobial is administered into the body of the food animal" ;
    rdfs:range linkml:String ;
