MIXS:adapters a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "adapters" ;
    dcterms:title "adapters" ;
    rdfs:comment "Adapters provide priming sequences for both amplification and sequencing of the sample-library fragments. Both adapters should be reported; in uppercase letters" ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:assembly_software a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assembly software" ;
    dcterms:title "assembly software" ;
    schema1:keywords "software" ;
    ns1:hasExactSynonym "assembly_software" ;
    rdfs:comment "Tool(s) used for assembly, including version number and parameters" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:lib_layout a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "library layout" ;
    dcterms:title "library layout" ;
    schema1:keywords "library" ;
    ns1:hasExactSynonym "lib_layout" ;
    rdfs:comment "Specify whether to expect single, paired, or other configuration of reads" ;
    rdfs:range MIXS:LibLayoutEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:lib_reads_seqd a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "library reads sequenced" ;
    dcterms:title "library reads sequenced" ;
    schema1:keywords "library" ;
    ns1:hasExactSynonym "lib_reads_seqd" ;
    rdfs:comment "Total number of clones sequenced from the library" ;
    rdfs:range linkml:Integer ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:lib_screen a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "library screening strategy" ;
    dcterms:title "library screening strategy" ;
    schema1:keywords "library" ;
    ns1:hasExactSynonym "lib_screen" ;
    rdfs:comment "Specific enrichment or screening methods applied before and/or after creating libraries" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "screening strategy name" .

MIXS:lib_size a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "library size" ;
    dcterms:title "library size" ;
    schema1:keywords "library",
        "size" ;
    ns1:hasExactSynonym "lib_size" ;
    rdfs:comment "Total number of clones in the library prepared for the project" ;
    rdfs:range linkml:Integer ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:lib_vector a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "library vector" ;
    dcterms:title "library vector" ;
    schema1:keywords "library" ;
    ns1:hasExactSynonym "lib_vector" ;
    rdfs:comment "Cloning vector type(s) used in construction of libraries" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "vector" .

MIXS:perturbation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "perturbation" ;
    dcterms:title "perturbation" ;
    schema1:keywords "perturbation" ;
    rdfs:comment "Type of perturbation, e.g. chemical administration, physical disturbance, etc., coupled with perturbation regimen including how many times the perturbation was repeated, how long each perturbation lasted, and the start and end time of the entire perturbation period; can include multiple perturbation types" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "perturbation type name;perturbation interval and duration" .

