MIXS:host_of_host_taxid a owl:DatatypeProperty ;
    rdfs:label "host of the symbiotic host taxon id" ;
    dcterms:title "host of the symbiotic host taxon id" ;
    schema1:keywords "host",
        "host.",
        "identifier",
        "symbiosis",
        "taxon" ;
    ns1:hasExactSynonym "host_of_host_taxid" ;
