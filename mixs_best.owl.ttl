        <https://w3id.org/mixs/WallFinishMatEnum#wood> .

MIXS:compl_score a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "completeness score" ;
    dcterms:title "completeness score" ;
    schema1:keywords "score" ;
    ns1:hasExactSynonym "compl_score" ;
    rdfs:comment "Completeness score is typically based on either the fraction of markers found as compared to a database or the percent of a genome found as compared to a closely related reference genome. High Quality Draft: >90%, Medium Quality Draft: >50%, and Low Quality Draft: < 50% should have the indicated completeness scores" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "quality;percent completeness" .

MIXS:compl_software a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "completeness software" ;
    dcterms:title "completeness software" ;
    schema1:keywords "software" ;
    ns1:hasExactSynonym "compl_software" ;
    rdfs:comment "Tools used for completion estimate, i.e. checkm, anvi'o, busco" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "names and versions of software(s) used" .

MIXS:isol_growth_condt a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isolation and growth condition" ;
    dcterms:title "isolation and growth condition" ;
    schema1:keywords "condition",
        "growth",
        "isolation" ;
    ns1:hasExactSynonym "isol_growth_condt" ;
    rdfs:comment "Publication reference in the form of pubmed ID (pmid), digital object identifier (doi) or url for isolation and growth condition specifications of the organism/material" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:rel_to_oxygen a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "relationship to oxygen" ;
    dcterms:title "relationship to oxygen" ;
    schema1:keywords "oxygen",
        "relationship" ;
    ns1:hasExactSynonym "rel_to_oxygen" ;
    rdfs:comment "Is this organism an aerobe, anaerobe? Please note that aerobic and anaerobic are valid descriptors for microbial environments" ;
    rdfs:range MIXS:RelToOxygenEnum ;
    skos:inScheme <https://w3id.org/mixs> .

MIXS:subspecf_gen_lin a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "subspecific genetic lineage" ;
    dcterms:title "subspecific genetic lineage" ;
    schema1:keywords "lineage" ;
    ns1:hasExactSynonym "subspecf_gen_lin" ;
    rdfs:comment "Information about the genetic distinctness of the sequenced organism below the subspecies level, e.g., serovar, serotype, biotype, ecotype, or any relevant genetic typing schemes like Group I plasmid. Subspecies should not be recorded in this term, but in the NCBI taxonomy. Supply both the lineage name and the lineage rank separated by a colon, e.g., biovar:abc123" ;
    skos:inScheme <https://w3id.org/mixs> ;
    MIXS:Expected_value "Genetic lineage below lowest rank of NCBI taxonomy, which is subspecies, e.g. serovar, biotype, ecotype, variety, cultivar" .

MIXS:tax_ident a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxonomic identity marker" ;
    dcterms:title "taxonomic identity marker" ;
    schema1:keywords "identifier",
        "marker",
        "taxon" ;
    ns1:hasExactSynonym "tax_ident" ;
    rdfs:comment "The phylogenetic marker(s) used to assign an organism name to the SAG or MAG" ;
    rdfs:range MIXS:TaxIdentEnum ;
    skos:inScheme <https://w3id.org/mixs> .

