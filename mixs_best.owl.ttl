MIXS:annual_precpt a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "mean annual precipitation" ;
    dcterms:title "mean annual precipitation" ;
    schema1:keywords "mean" ;
    ns1:hasExactSynonym "annual_precpt" ;
